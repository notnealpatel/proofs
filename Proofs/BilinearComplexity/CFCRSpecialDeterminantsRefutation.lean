/-
# Counterexamples to Jitman's circulant determinant conjectures

Somphong Jitman, *Determinants of some Special Matrices over Commutative
Finite Chain Rings*, arXiv:2007.14123v1 (2020), §5, Conjectures 1 and 2.
For a commutative finite chain ring `R`, write `c_n(R, a)` for the number
of `n × n` circulant matrices with determinant `a`.  Let `(γ)` be the
maximal ideal, `e` the nilpotency index and `𝔽_q` the residue field.
Conjecture 1 asserts `c_n(R, γ^s) = c_n(R, b γ^s)` for every unit `b`,
every `0 ≤ s ≤ e` and every positive `n`.  Conjecture 2 asserts that every
unit is a circulant determinant for every positive `n`.  The paper proves
these statements when `gcd(n, q) = 1` (Lemma `lemOnto` and Theorem `ar=r`);
the conjectures omit that restriction.

Both conjectures fail for `R = DualNumber (ZMod 2) = 𝔽_2[ε]/(ε²)`,
`γ = ε`, `e = 2` and `n = 2`.  This is a finite nontrivial chain ring
with ideals `0 ⊂ (ε) ⊂ R`.  The determinant of `cir(a, b)` is `a² - b²`.
Every square in `R` has zero `ε`-component, so every such determinant does
too.  The unit `1 + ε` is therefore missing, refuting Conjecture 2.
The exact counts are `c_2(R, 1) = 8` and `c_2(R, 1 + ε) = 0`.
Their inequality refutes Conjecture 1 with `s = 0` and `b = 1 + ε`.
-/
import Mathlib

set_option autoImplicit false

namespace Jitman2007_14123

open DualNumber

/-! ## Definitions mirroring the paper -/

/-- A *commutative finite chain ring* (Jitman, Section 2.1): a finite
commutative ring with identity `1 ≠ 0` whose ideals are linearly ordered by
inclusion.  Commutativity is carried by the ambient `CommRing` instance. -/
structure IsCFCR (R : Type*) [CommRing R] : Prop where
  /-- `R` is finite. -/
  finite : Finite R
  /-- `1 ≠ 0` in `R`. -/
  nontrivial : Nontrivial R
  /-- The ideals of `R` are linearly ordered by inclusion. -/
  chain : ∀ I J : Ideal R, I ≤ J ∨ J ≤ I

/-- The paper's circulant matrix `cir(a_1, …, a_n)` (Section 2.2): entry
`(i, j)` (1-indexed) is `a_{j - i + 1}` with indices mod `n`, i.e. the first
row is `a_1 … a_n` and each later row is the right cyclic shift of the
previous one.  With 0-indexed `v : Fin n → R`, entry `(i, j)` is
`v (j - i)`.  (This is the transpose of Mathlib's `Matrix.circulant`.) -/
def cir {R : Type*} {n : ℕ} (v : Fin n → R) : Matrix (Fin n) (Fin n) R :=
  Matrix.of fun i j => v (j - i)

/-- `C_n(R)`: the set of `n × n` circulant matrices over `R`. -/
def circulantSet (R : Type*) [CommRing R] (n : ℕ) : Set (Matrix (Fin n) (Fin n) R) :=
  Set.range (cir (R := R) (n := n))

/-- `C_n(R, a)`: the `n × n` circulant matrices over `R` with determinant `a`. -/
def circulantDetSet (R : Type*) [CommRing R] (n : ℕ) (a : R) :
    Set (Matrix (Fin n) (Fin n) R) :=
  {A | A ∈ circulantSet R n ∧ A.det = a}

/-- `c_n(R, a) = |C_n(R, a)|`, the number of `n × n` circulant matrices over
`R` with determinant `a` (`Nat.card`; all uses below have `R` finite). -/
noncomputable def circCount (R : Type*) [CommRing R] (n : ℕ) (a : R) : ℕ :=
  Nat.card (circulantDetSet R n a)

/-- Jitman's Conjecture 1 (arXiv:2007.14123, Section 5): for every CFCR `R`
whose maximal ideal is generated by `γ`, of nilpotency index `e` (the least
`e` with `γ ^ e = 0`), for every `n ≥ 1`, every unit `b` and every
`0 ≤ s ≤ e`, `c_n(R, γ ^ s) = c_n(R, b γ ^ s)`.  Since a CFCR is local,
"the maximal ideal is generated by `γ`" is stated as `(γ)` being maximal. -/
def Conjecture1 : Prop :=
  ∀ (R : Type) [CommRing R], IsCFCR R →
    ∀ γ : R, (Ideal.span {γ}).IsMaximal →
    ∀ e : ℕ, γ ^ e = 0 → (∀ k < e, γ ^ k ≠ 0) →
    ∀ n : ℕ, 0 < n → ∀ (b : Rˣ) (s : ℕ), s ≤ e →
      circCount R n (γ ^ s) = circCount R n ((b : R) * γ ^ s)

/-- Jitman's Conjecture 2 (arXiv:2007.14123, Section 5): for every CFCR `R`
and every `n ≥ 1`, every unit of `R` is the determinant of some `n × n`
circulant matrix over `R`, i.e. `U(R) ⊆ {det A | A ∈ C_n(R)}`. -/
def Conjecture2 : Prop :=
  ∀ (R : Type) [CommRing R], IsCFCR R →
    ∀ n : ℕ, 0 < n → ∀ a : Rˣ, ∃ A ∈ circulantSet R n, A.det = (a : R)

/-- The paper's "precisely" form of Conjecture 2: `c_n(R, a) > 0` for every
unit `a` of every CFCR `R` and every `n ≥ 1`. -/
def Conjecture2Count : Prop :=
  ∀ (R : Type) [CommRing R], IsCFCR R →
    ∀ n : ℕ, 0 < n → ∀ a : Rˣ, 0 < circCount R n (a : R)

/-! ## Examples -/

/-- `cir(1, 2, 3)` has second row `(3, 1, 2)`: the right cyclic shift. -/
example : (cir ![(1 : ℤ), 2, 3]) 1 = ![3, 1, 2] := by
  ext j; fin_cases j <;> rfl

/-- `cir(1, 2, 3)` has first row `(1, 2, 3)`. -/
example : (cir ![(1 : ℤ), 2, 3]) 0 = ![1, 2, 3] := by
  ext j; fin_cases j <;> rfl

/-- The paper's circulant is the transpose of Mathlib's `Matrix.circulant`. -/
theorem cir_eq_transpose_circulant {R : Type*} {n : ℕ} (v : Fin n → R) :
    cir v = (Matrix.circulant v).transpose := by
  ext i j
  simp [cir, Matrix.circulant_apply]

/-- The determinant of the `2 × 2` circulant `cir(a, b)` is `a² - b²`. -/
theorem det_cir_two {R : Type*} [CommRing R] (v : Fin 2 → R) :
    (cir v).det = v 0 * v 0 - v 1 * v 1 := by
  rw [Matrix.det_fin_two]
  have hneg : (-1 : Fin 2) = 1 := rfl
  simp [cir, hneg]

/-- The paper's own example (Section 5): no `2 × 2` circulant over `ℤ_4` has
the zero-divisor `2` as determinant. -/
example : ¬ ∃ A ∈ circulantSet (ZMod 4) 2, A.det = 2 := by
  rintro ⟨_, ⟨v, rfl⟩, hdet⟩
  rw [det_cir_two] at hdet
  have hall : ∀ a b : ZMod 4, a * a - b * b ≠ 2 := by decide
  exact hall (v 0) (v 1) hdet

/-- Every finite field is a CFCR (its only ideals are `⊥` and `⊤`); in
particular the definition `IsCFCR` is inhabited by `𝔽_2`. -/
example : IsCFCR (ZMod 2) where
  finite := inferInstance
  nontrivial := inferInstance
  chain I J := by
    rcases Ideal.eq_bot_or_top I with rfl | rfl
    · exact Or.inl bot_le
    · exact Or.inr le_top

/-! ## The counterexample ring `𝔽_2[ε]/(ε²)` -/

/-- `𝔽_2[ε]` is finite: as a type it is `ZMod 2 × ZMod 2`. -/
theorem finite_dualNumber_zmod_two : Finite (DualNumber (ZMod 2)) :=
  inferInstanceAs (Finite (ZMod 2 × ZMod 2))

/-- `𝔽_2[ε] = DualNumber (ZMod 2)` is a commutative finite chain ring: it is
finite (as a type it is `ZMod 2 × ZMod 2`), nontrivial, and its ideals are
exactly `⊥ ⊂ (ε) ⊂ ⊤`. -/
theorem isCFCR_dualNumber_zmod_two : IsCFCR (DualNumber (ZMod 2)) where
  finite := finite_dualNumber_zmod_two
  nontrivial := inferInstance
  chain I J := by
    have hεtop : (Ideal.span {(ε : DualNumber (ZMod 2))}) ≤ ⊤ := le_top
    rcases ideal_trichotomy I with rfl | rfl | rfl <;>
      rcases ideal_trichotomy J with rfl | rfl | rfl <;>
      first
      | exact Or.inl le_rfl
      | exact Or.inl bot_le
      | exact Or.inr bot_le
      | exact Or.inl hεtop
      | exact Or.inr hεtop

/-- In `𝔽_2[ε]` every square has zero `ε`-component:
`(x + y ε)² = x² + 2 x y ε = x²`. -/
theorem snd_mul_self_dualNumber_zmod_two (x : DualNumber (ZMod 2)) :
    (x * x).snd = 0 := by
  rw [TrivSqZeroExt.snd_mul]
  simp only [smul_eq_mul, MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
  rw [mul_comm x.snd x.fst, ← two_mul]
  have htwo : (2 : ZMod 2) = 0 := rfl
  rw [htwo, zero_mul]

/-- `1 + ε` is a unit of `𝔽_2[ε]`, being its own inverse:
`(1 + ε)² = 1 + 2ε + ε² = 1`. -/
theorem one_add_eps_mul_self :
    ((1 + ε : DualNumber (ZMod 2))) * (1 + ε) = 1 := by
  have htwo : (2 : DualNumber (ZMod 2)) = 0 := by
    ext <;> rfl
  calc (1 + ε : DualNumber (ZMod 2)) * (1 + ε) = 1 + 2 * ε + ε * ε := by ring
    _ = 1 := by rw [htwo, eps_mul_eps, zero_mul, add_zero, add_zero]

/-- The unit `1 + ε` of `𝔽_2[ε]`. -/
def unitOneAddEps : (DualNumber (ZMod 2))ˣ :=
  ⟨1 + ε, 1 + ε, one_add_eps_mul_self, one_add_eps_mul_self⟩

/-- No `2 × 2` circulant over `𝔽_2[ε]` has determinant
`1 + ε`.  Indeed `det cir(a, b) = a² - b²` has zero `ε`-component, while
`1 + ε` has `ε`-component `1`. -/
theorem not_exists_cir_det_one_add_eps :
    ¬ ∃ A ∈ circulantSet (DualNumber (ZMod 2)) 2, A.det = 1 + ε := by
  rintro ⟨_, ⟨v, rfl⟩, hdet⟩
  rw [det_cir_two] at hdet
  have hsnd := congrArg TrivSqZeroExt.snd hdet
  rw [TrivSqZeroExt.snd_sub, snd_mul_self_dualNumber_zmod_two,
    snd_mul_self_dualNumber_zmod_two, sub_zero, TrivSqZeroExt.snd_add,
    TrivSqZeroExt.snd_one, snd_eps, zero_add] at hsnd
  exact zero_ne_one hsnd

/-- `c_2(𝔽_2[ε], 1 + ε) = 0`. -/
theorem circCount_one_add_eps : circCount (DualNumber (ZMod 2)) 2 (1 + ε) = 0 := by
  rw [circCount, Nat.card_eq_zero]
  left
  refine ⟨fun ⟨A, hA⟩ => not_exists_cir_det_one_add_eps ⟨A, hA.1, hA.2⟩⟩

/-- `cir(1, 0)` is the identity matrix, so `1 ∈ {det A | A ∈ C_2(𝔽_2[ε])}`. -/
theorem cir_one_zero_mem : cir ![(1 : DualNumber (ZMod 2)), 0] ∈
    circulantDetSet (DualNumber (ZMod 2)) 2 1 := by
  refine ⟨⟨_, rfl⟩, ?_⟩
  rw [det_cir_two]
  simp

/-- `c_2(𝔽_2[ε], 1) > 0`. -/
theorem circCount_one_pos : 0 < circCount (DualNumber (ZMod 2)) 2 1 := by
  have hR : Finite (DualNumber (ZMod 2)) := finite_dualNumber_zmod_two
  have hrow : Finite (Fin 2 → DualNumber (ZMod 2)) := @Pi.finite _ _ _ fun _ => hR
  have hmat : Finite (Matrix (Fin 2) (Fin 2) (DualNumber (ZMod 2))) :=
    @Pi.finite _ _ _ fun _ => hrow
  have hsub : Finite (circulantDetSet (DualNumber (ZMod 2)) 2 1) :=
    @Subtype.finite _ hmat _
  have hne : Nonempty (circulantDetSet (DualNumber (ZMod 2)) 2 1) :=
    ⟨⟨_, cir_one_zero_mem⟩⟩
  exact @Nat.card_pos _ hne hsub

/-! ## Exact counts `c_2(𝔽_2[ε], 1) = 8` and `c_2(𝔽_2[ε], 1 + ε) = 0` -/

/-- The circulant map `v ↦ cir v` is injective: `v k` is entry `(0, k)`. -/
theorem cir_injective {R : Type*} {n : ℕ} : Function.Injective (cir (R := R) (n := n)) := by
  intro v w hvw
  funext k
  haveI : NeZero n := ⟨(Fin.pos k).ne'⟩
  have hentry := congrFun (congrFun hvw 0) k
  simpa [cir, sub_zero] using hentry

/-- `C_n(R, a)` is the image under `cir` of the coefficient vectors whose
circulant has determinant `a`. -/
theorem circulantDetSet_eq_image (R : Type*) [CommRing R] (n : ℕ) (a : R) :
    circulantDetSet R n a = cir '' {v | (cir v).det = a} := by
  ext A
  constructor
  · rintro ⟨⟨v, rfl⟩, hdet⟩
    exact ⟨v, hdet, rfl⟩
  · rintro ⟨v, hdet, rfl⟩
    exact ⟨⟨v, rfl⟩, hdet⟩

/-- `c_n(R, a)` counts the coefficient vectors `v` with `det (cir v) = a`. -/
theorem circCount_eq_card (R : Type*) [CommRing R] (n : ℕ) (a : R) :
    circCount R n a = Nat.card {v : Fin n → R // (cir v).det = a} := by
  rw [circCount, circulantDetSet_eq_image, Nat.card_image_of_injective cir_injective]
  rfl

/-- The `Fintype` structure of `𝔽_2[ε]`, transported from `ZMod 2 × ZMod 2`
(used only as a local instance for the finite count below). -/
@[instance_reducible] def fintypeDualNumberZModTwo : Fintype (DualNumber (ZMod 2)) :=
  inferInstanceAs (Fintype (ZMod 2 × ZMod 2))

/-- Decidable equality on `𝔽_2[ε]`, transported from `ZMod 2 × ZMod 2`
(used only as a local instance for the finite count below). -/
@[instance_reducible] def decidableEqDualNumberZModTwo : DecidableEq (DualNumber (ZMod 2)) :=
  inferInstanceAs (DecidableEq (ZMod 2 × ZMod 2))

section ExactCount

attribute [local instance] fintypeDualNumberZModTwo decidableEqDualNumberZModTwo

/-- Finite check: exactly `8` pairs `(a, b)` in `𝔽_2[ε]²` satisfy `a² - b² = 1`. -/
theorem card_filter_sq_sub_sq_eq_one :
    (Finset.univ.filter fun v : Fin 2 → DualNumber (ZMod 2) =>
      v 0 * v 0 - v 1 * v 1 = 1).card = 8 := by
  decide

/-- `c_2(𝔽_2[ε], 1) = 8`: exactly eight `2 × 2` circulants over `𝔽_2[ε]` have
determinant `1`. -/
theorem circCount_one_eq_eight : circCount (DualNumber (ZMod 2)) 2 1 = 8 := by
  rw [circCount_eq_card,
    Nat.card_congr (Equiv.subtypeEquivRight fun v => by rw [det_cir_two]),
    Nat.card_eq_fintype_card, Fintype.card_subtype]
  exact card_filter_sq_sub_sq_eq_one

end ExactCount

/-! ## The refutations -/

/-- **Jitman's Conjecture 2 is false** (arXiv:2007.14123, Section 5): in the
CFCR `𝔽_2[ε]` with `n = 2`, the unit `1 + ε` is not the determinant of any
`2 × 2` circulant matrix. -/
theorem not_conjecture2 : ¬ Conjecture2 := by
  intro h
  exact not_exists_cir_det_one_add_eps
    (h (DualNumber (ZMod 2)) isCFCR_dualNumber_zmod_two 2 two_pos unitOneAddEps)

/-- **Jitman's Conjecture 2 is false, counting form**: `c_2(𝔽_2[ε], 1 + ε) = 0`
although `1 + ε` is a unit and `𝔽_2[ε]` is a CFCR. -/
theorem not_conjecture2Count : ¬ Conjecture2Count := by
  intro h
  have hpos := h (DualNumber (ZMod 2)) isCFCR_dualNumber_zmod_two 2 two_pos unitOneAddEps
  have hzero : circCount (DualNumber (ZMod 2)) 2 (unitOneAddEps : DualNumber (ZMod 2)) = 0 :=
    circCount_one_add_eps
  omega

/-- **Jitman's Conjecture 1 is false** (arXiv:2007.14123, Section 5): take the
CFCR `R = 𝔽_2[ε]` with maximal ideal `(ε)`, nilpotency index `e = 2`,
`n = 2`, `s = 0` and the unit `b = 1 + ε`; then
`c_2(R, ε⁰) = c_2(R, 1) > 0 = c_2(R, (1 + ε) ε⁰)`. -/
theorem not_conjecture1 : ¬ Conjecture1 := by
  intro h
  have hε2 : (ε : DualNumber (ZMod 2)) ^ 2 = 0 := by rw [pow_two, eps_mul_eps]
  have hεpow : ∀ k < 2, (ε : DualNumber (ZMod 2)) ^ k ≠ 0 := by
    intro k hk
    interval_cases k
    · rw [pow_zero]; exact one_ne_zero
    · rw [pow_one]
      intro hε
      have hsnd := congrArg TrivSqZeroExt.snd hε
      rw [snd_eps, TrivSqZeroExt.snd_zero] at hsnd
      exact one_ne_zero hsnd
  have heq := h (DualNumber (ZMod 2)) isCFCR_dualNumber_zmod_two ε
    isMaximal_span_singleton_eps 2 hε2 hεpow 2 two_pos unitOneAddEps 0 (Nat.zero_le 2)
  rw [pow_zero, mul_one] at heq
  have hpos := circCount_one_pos
  have hzero : circCount (DualNumber (ZMod 2)) 2 (unitOneAddEps : DualNumber (ZMod 2)) = 0 :=
    circCount_one_add_eps
  omega

end Jitman2007_14123
