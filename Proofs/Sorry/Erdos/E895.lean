    · exact h' s (List.mem_cons_of_mem _ hs) hcs
    · exact h' s (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hs)) hcs
    · exact h' s (List.mem_cons_of_mem _ hs) hcs
    · exact h' s (List.mem_cons_of_mem _ hs) hcs
