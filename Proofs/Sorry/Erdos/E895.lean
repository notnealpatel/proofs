/-
  Erdős Problem #895 — independent Schur triples in triangle-free
  graphs on {1, …, n}.
  Status: proved (Barber, SAT-verified for all n ≥ 18; personal
  communication per DB).  Tier B archive target with a small-n layer.

  Verbatim statement (`goof erdos fetch 895`, pulled 2026-08-05):

    "Is it true that, for all sufficiently large $n$, if $G$ is a
    triangle-free graph on $\{1,\ldots,n\}$ then there must exist three
    independent points $a,b,a+b$?"

  DB remarks: problem of Erdős–Hajnal.  Hajnal expected an independent
  Hindman set (all subset sums of a₁,…,a_k independent) — that general
  question remains OPEN.  The stated problem was resolved by Barber
  (personal communication), verifying by SAT that it holds for all
  n ≥ 18.

  Formalization: vertices are `Fin n` labelled by the integers
  1, …, n via `v ↦ v.val + 1`; "three independent points a, b, a+b"
  means pairwise non-adjacent AND pairwise distinct vertices (a = b
  would degenerate the triple; a+b is automatically distinct from a, b
  since labels are positive).

  The n ≥ 18 direction needs verified SAT-certificate replay (DRAT/LRAT
  checking), which the repo lacks — archived.  The small-n layer
  (explicit triangle-free counterexample graphs for n < 18) is
  formalizable now via native_decide.

  Mathlib inventory (leandoc 2026-08-05): `SimpleGraph.CliqueFree 3`
  for triangle-freeness, `SimpleGraph.IsIndepSet`; nothing further.
-/
import Mathlib

set_option autoImplicit false

namespace ErdosCandidates.E895

open SimpleGraph

/-- `HasIndepSchurTriple G`: there are vertices with labels `a`, `b`,
    `a + b` (labels in `{1, …, n}` via `val + 1`), pairwise distinct and
    pairwise non-adjacent in `G`. -/
def HasIndepSchurTriple {n : ℕ} (G : SimpleGraph (Fin n)) : Prop :=
  ∃ a b c : Fin n, (a.val + 1) + (b.val + 1) = c.val + 1 ∧
    a ≠ b ∧ ¬ G.Adj a b ∧ ¬ G.Adj a c ∧ ¬ G.Adj b c

/-- Satisfiability: the empty graph on `{1,…,3}` has the triple
    1 + 2 = 3.  -- PROVABLE (decide). -/
example : HasIndepSchurTriple (⊥ : SimpleGraph (Fin 3)) :=
  ⟨0, 1, 2, rfl, by decide, by simp, by simp, by simp⟩

/-! ### Kernel-checked case analysis for `n = 18`

The proof of `barber_indep_schur` replaces Barber's SAT run by a
DPLL refutation tree (unit propagation plus branching on edges),
generated offline and replayed here by a small checker whose
soundness is proved below.  The checker is evaluated by the kernel
(`decide +kernel`); no `native_decide`, `bv_decide` or extra axioms.

Partial edge assignments on the vertices `0, …, 17` are pairs `(P, Q)`
of bitmasks: bit `edgeIdx x y` of `P` (resp. `Q`) records that the
edge `{x, y}` is present (resp. absent).  A certificate instruction
`w` encodes an opcode `w % 8` and vertices `x = w / 8 % 18`,
`y = w / 144 % 18`, `z = w / 2592`:
* `0`: branch on the edge `{x, y}` (present first, then absent);
* `1`: triangle step — `{x, y}`, `{x, z}` present forces `{y, z}` absent;
* `2`: Schur step — `{x, y}`, `{x, z}` absent forces `{y, z}` present
  (when `x, y, z` carry labels forming a Schur triple);
* `3`: close the current branch: `{x, y}` is both present and absent;
* `4`: no-op (padding). -/

/-- Bit position of the unordered pair `{a, b}` of vertices `< 18`. -/
private def edgeIdx (a b : ℕ) : ℕ := if a < b then a * 18 + b else b * 18 + a

/-- Ground truth: `edgeIdx` is symmetric and `{0, 1}` sits at bit `1`. -/
example : edgeIdx 2 5 = 41 ∧ edgeIdx 5 2 = 41 ∧ edgeIdx 0 1 = 1 := by decide

/-- One checker instruction acting on the stack of open branches; `none`
    signals a failed check. -/
private def certStep (w : ℕ) (st : List (ℕ × ℕ)) : Option (List (ℕ × ℕ)) :=
  let op := w % 8
  let x := w / 8 % 18
  let y := w / 144 % 18
  let z := w / 2592
  if op = 4 then some st else
  match st with
  | [] => none
  | (P, Q) :: rest =>
    if op = 0 then some ((P ||| 2 ^ edgeIdx x y, Q) :: (P, Q ||| 2 ^ edgeIdx x y) :: rest)
    else if op = 1 then
      if (decide (z < 18) && x != y && x != z && y != z &&
          P.testBit (edgeIdx x y) && P.testBit (edgeIdx x z)) = true then
        some ((P, Q ||| 2 ^ edgeIdx y z) :: rest) else none
    else if op = 2 then
      if (decide (z < 18) && x != y && x != z && y != z &&
          (x + y + 1 == z || x + z + 1 == y || y + z + 1 == x) &&
          Q.testBit (edgeIdx x y) && Q.testBit (edgeIdx x z)) = true then
        some ((P ||| 2 ^ edgeIdx y z, Q) :: rest) else none
    else if op = 3 then
      if (P.testBit (edgeIdx x y) && Q.testBit (edgeIdx x y)) = true then some rest else none
    else none

/-- Ground truth: branching on `{0, 1}` from the empty assignment opens the
    two branches `({0,1}, ∅)` and `(∅, {0,1})`. -/
example : certStep 8 [(0, 0)] = some [(2, 0), (0, 2)] := by decide

/-- Run the `k` instructions packed in base `2^16` into the chunk `c`. -/
private def certRunChunk : ℕ → ℕ → List (ℕ × ℕ) → Option (List (ℕ × ℕ))
  | 0, _, st => some st
  | k + 1, c, st =>
    match certStep (c % 65536) st with
    | some st' => certRunChunk k (c / 65536) st'
    | none => none

/-- Run a list of 32-instruction chunks; succeed iff every check passes and
    all branches get closed. -/
private def certRunAll : List ℕ → List (ℕ × ℕ) → Bool
  | [], st => st.isEmpty
  | c :: cs, st =>
    match certRunChunk 32 c st with
    | some st' => certRunAll cs st'
    | none => false

