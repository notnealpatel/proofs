/-- Kernel replay of the refutation certificate. -/
private theorem certData_ok : certRunAll certData [(0, 0)] = true := by
  decide +kernel

/-- Consistency of a partial edge assignment `(P, Q)` with a relation `R`
    on vertices `< 18`. -/
private def CertCons (R : ℕ → ℕ → Prop) (s : ℕ × ℕ) : Prop :=
  ∀ x y, x < 18 → y < 18 →
    (s.1.testBit (edgeIdx x y) = true → R x y) ∧ (s.2.testBit (edgeIdx x y) = true → ¬ R x y)

/-- `edgeIdx` is injective on unordered pairs of vertices `< 18`. -/
private theorem edgeIdx_inj {a b x y : ℕ} (ha : a < 18) (hb : b < 18) (hx : x < 18)
    (hy : y < 18) (h : edgeIdx a b = edgeIdx x y) : (a = x ∧ b = y) ∨ (a = y ∧ b = x) := by
  unfold edgeIdx at h
  split_ifs at h <;> omega

/-- Bits of `P ||| 2 ^ i`. -/
private theorem testBit_or_two_pow_iff (P i j : ℕ) :
    (P ||| 2 ^ i).testBit j = true ↔ P.testBit j = true ∨ i = j := by
  simp [Nat.testBit_or, Nat.testBit_two_pow]

/-- Recording a present edge keeps consistency. -/
private theorem certCons_insP {R : ℕ → ℕ → Prop} (hsymm : ∀ x y, R x y → R y x)
    {P Q x y : ℕ} (hc : CertCons R (P, Q)) (hx : x < 18) (hy : y < 18) (hr : R x y) :
    CertCons R (P ||| 2 ^ edgeIdx x y, Q) := by
  intro a b ha hb
  refine ⟨fun h => ?_, (hc a b ha hb).2⟩
  rcases (testBit_or_two_pow_iff _ _ _).1 h with h | h
  · exact (hc a b ha hb).1 h
  · rcases edgeIdx_inj ha hb hx hy h.symm with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hr
    · exact hsymm _ _ hr

/-- Recording an absent edge keeps consistency. -/
private theorem certCons_insQ {R : ℕ → ℕ → Prop} (hsymm : ∀ x y, R x y → R y x)
    {P Q x y : ℕ} (hc : CertCons R (P, Q)) (hx : x < 18) (hy : y < 18) (hr : ¬ R x y) :
    CertCons R (P, Q ||| 2 ^ edgeIdx x y) := by
  intro a b ha hb
  refine ⟨(hc a b ha hb).1, fun h => ?_⟩
  rcases (testBit_or_two_pow_iff _ _ _).1 h with h | h
  · exact (hc a b ha hb).2 h
  · rcases edgeIdx_inj ha hb hx hy h.symm with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hr
    · exact fun h' => hr (hsymm _ _ h')

/-- A relation on `{0, …, 17}` that is symmetric, triangle-free, and meets
    every Schur triple (labels `x+1, y+1, z+1` with one the sum of the
    other two) in an edge. -/
private structure SchurBad (R : ℕ → ℕ → Prop) : Prop where
  symm : ∀ x y, R x y → R y x
  tri : ∀ x y z, x < 18 → y < 18 → z < 18 → x ≠ y → x ≠ z → y ≠ z →
    R x y → R x z → R y z → False
  schur : ∀ x y z, x < 18 → y < 18 → z < 18 → x ≠ y → x ≠ z → y ≠ z →
    (x + y + 1 = z ∨ x + z + 1 = y ∨ y + z + 1 = x) → R x y ∨ R x z ∨ R y z

/-- Soundness of one instruction: if every resulting branch is inconsistent
    with `R`, so is every branch before the step. -/
private theorem certStep_sound {R : ℕ → ℕ → Prop} (hR : SchurBad R) {w : ℕ}
    {st st' : List (ℕ × ℕ)} (h : certStep w st = some st')
    (h' : ∀ s ∈ st', ¬ CertCons R s) : ∀ s ∈ st, ¬ CertCons R s := by
  have hx : w / 8 % 18 < 18 := Nat.mod_lt _ (by norm_num)
  have hy : w / 144 % 18 < 18 := Nat.mod_lt _ (by norm_num)
  rcases st with _ | ⟨⟨P, Q⟩, rest⟩
  · intro s hs; cases hs
  unfold certStep at h
  simp only at h
  intro s hs hcs
  rcases List.mem_cons.1 hs with rfl | hs
  · split_ifs at h with h4 h0 h1 h1' h2 h2' h3 h3'
    · cases h; exact h' _ List.mem_cons_self hcs
