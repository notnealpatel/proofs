/-- Checks the Fibonacci recurrence modulo `M` along consecutive triples. -/
def fibCheck : List ℕ → Bool
  | x :: y :: z :: rest => (z == (x + y) % M) && fibCheck (y :: z :: rest)
  | _ => true

/-- `fibCheck` passes to the tail. -/
theorem fibCheck_tail (x : ℕ) (l : List ℕ) (h : fibCheck (x :: l) = true) :
    fibCheck l = true := by
  match l, h with
  | [], _ => rfl
  | [_], _ => rfl
  | y :: z :: rest, h =>
    simp only [fibCheck, Bool.and_eq_true] at h
    exact h.2

/-- `fibCheck` enforces the recurrence on the first triple. -/
theorem fibCheck_third (x y z : ℕ) (rest : List ℕ)
    (h : fibCheck (x :: y :: z :: rest) = true) : z = (x + y) % M := by
  simp only [fibCheck, Bool.and_eq_true, beq_iff_eq] at h
  exact h.1

/-- A list passing `fibCheck` whose first two entries are `F(n), F(n+1) mod M`
lists `F(n+i) mod M`. -/
theorem getD_of_fibCheck (l : List ℕ) (n : ℕ) (h : fibCheck l = true)
    (h0 : ∀ x rest, l = x :: rest → x = Nat.fib n % M)
    (h1 : ∀ x y rest, l = x :: y :: rest → y = Nat.fib (n + 1) % M) :
    ∀ i < l.length, l.getD i 0 = Nat.fib (n + i) % M := by
  induction l generalizing n with
  | nil => intro i hi; simp at hi
  | cons x tl ih =>
    intro i hi
    cases i with
    | zero => simpa using h0 x tl rfl
    | succ i =>
      have htl := fibCheck_tail x tl h
      have key := ih (n + 1) htl
        (fun y rest hy => h1 x y rest (by rw [hy]))
        (fun y z rest hyz => by
          subst hyz
          rw [fibCheck_third x y z rest h, h0 x _ rfl, h1 x y _ rfl, ← Nat.add_mod,
            show n + 1 + 1 = n + 2 by ring, Nat.fib_add_two])
        i (by simpa using hi)
      simpa [show n + (i + 1) = n + 1 + i by ring] using key

/-- The table has `2340` entries. -/
theorem fibList_length : fibList.length = 2340 := by decide +kernel

/-- The table satisfies the Fibonacci recurrence modulo `M` (kernel check). -/
theorem fibCheck_fibList : fibCheck fibList = true := by decide +kernel

/-- The table starts with `F(0), F(1) = 0, 1`. -/
theorem fibList_eq_cons : fibList = 0 :: 1 :: fibList.drop 2 := by decide +kernel

/-- The literal table is `F(i) mod 11^7`. -/
theorem fibList_spec (i : ℕ) (hi : i < 2340) : fibList.getD i 0 = Nat.fib i % M := by
  have h := getD_of_fibCheck fibList 0 fibCheck_fibList
    (fun x rest hx => by
      rw [fibList_eq_cons] at hx
      simp only [List.cons.injEq] at hx
      rw [← hx.1]; rfl)
    (fun x y rest hx => by
      rw [fibList_eq_cons] at hx
      simp only [List.cons.injEq] at hx
      rw [← hx.2.1]; rfl)
    i (by rw [fibList_length]; exact hi)
  simpa using h

/-! ## The kernel computation and its specification -/

/-- `innerTake fa l c = ∑_{i < c} T ((fa + l[i]) % M)` (raw `Nat` operations
for the kernel). -/
def innerTake (fa : ℕ) (l : List ℕ) (c : ℕ) : ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ) (fun _ => 0)
    (fun x _ ih c => Nat.rec (motive := fun _ => ℕ) 0
      (fun c' _ => Nat.add (T (Nat.mod (Nat.add fa x) M)) (ih c')) c) l c

/-- Every tenth entry: `strideN k l = [l[0], l[10], …, l[10(k-1)]]`. -/
def strideN (k : ℕ) (l : List ℕ) : List ℕ :=
  Nat.rec (motive := fun _ => List ℕ → List ℕ) (fun _ => [])
    (fun _ ih l => l.headD 0 :: ih (l.drop 10)) k l

/-- The residues `F(c + 10 i) mod M`, `i < 233`, of one class modulo `10`. -/
def classList (c : ℕ) : List ℕ := strideN 233 (fibList.drop c)

/-- Number of `b` with `2 ≤ c ≤ b < a` and `b ≡ c (mod 10)`. -/
def cnt (a c : ℕ) : ℕ := (a + 9 - c) / 10

/-- For each residue `r` of `a` modulo `10`, the class offsets `c ∈ [2, 12)`
of those `b` for which `11 ∣ F(a) + F(b)`. -/
def offsTable : List (List ℕ) := [[10], [8], [8], [], [6], [], [4], [], [11, 2, 9], [8]]

/-- The offsets for `a`. -/
def offs (a : ℕ) : List ℕ := offsTable.getD (a % 10) []

/-- The contribution of one `a`, with `fa = F(a) mod M`. -/
def G (a fa : ℕ) : ℕ := ((offs a).map (fun c => innerTake fa (classList c) (cnt a c))).sum

/-- Sum of `G` along a list of residues `F(a), F(a+1), …`. -/
def outerAux (l : List ℕ) : ℕ → ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ) (fun _ => 0)
    (fun x _ ih a => Nat.add (G a x) (ih (Nat.add a 1))) l

/-- Specification of the inner loop. -/
theorem innerTake_spec (fa : ℕ) (l : List ℕ) (c : ℕ) (hc : c ≤ l.length) :
    innerTake fa l c = ∑ i ∈ range c, T ((fa + l.getD i 0) % M) := by
  induction l generalizing c with
  | nil =>
    have hc0 : c = 0 := by simpa using hc
    subst hc0
    rfl
  | cons x xs ih =>
    cases c with
    | zero => rfl
    | succ c =>
      have hstep : innerTake fa (x :: xs) (c + 1) = T ((fa + x) % M) + innerTake fa xs c := rfl
      rw [hstep, ih c (by simpa using hc), sum_range_succ']
      simp only [List.getD_cons_succ, List.getD_cons_zero]
      ring

/-- `strideN k l` has `k` entries. -/
theorem strideN_length (k : ℕ) (l : List ℕ) : (strideN k l).length = k := by
  induction k generalizing l with
  | zero => rfl
  | succ k ih =>
    show (l.headD 0 :: strideN k (l.drop 10)).length = k + 1
    simp [ih]

/-- The `i`-th entry of `strideN k l` is the `10 i`-th entry of `l`. -/
theorem strideN_getD (k : ℕ) (l : List ℕ) (i : ℕ) (hi : i < k) :
    (strideN k l).getD i 0 = l.getD (10 * i) 0 := by
  induction k generalizing l i with
  | zero => omega
  | succ k ih =>
    show (l.headD 0 :: strideN k (l.drop 10)).getD i 0 = _
    cases i with
    | zero => cases l <;> simp
    | succ i =>
      rw [List.getD_cons_succ, ih (l.drop 10) i (by omega)]
      simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]
      congr 2
      ring

/-- Each class list has `233` entries. -/
theorem classList_length (c : ℕ) : (classList c).length = 233 := strideN_length _ _

/-- The `i`-th entry of class `c` is `F(c + 10 i) mod M`. -/
theorem classList_getD (c i : ℕ) (hi : i < 233) (hc : c + 10 * i < 2340) :
    (classList c).getD i 0 = Nat.fib (c + 10 * i) % M := by
  rw [classList, strideN_getD _ _ _ hi, List.getD_eq_getElem?_getD, List.getElem?_drop,
    ← List.getD_eq_getElem?_getD, fibList_spec _ hc]

/-- Specification of the outer loop. -/
theorem outerAux_spec (l : List ℕ) (a : ℕ) :
    outerAux l a = ∑ i ∈ range l.length, G (a + i) (l.getD i 0) := by
  induction l generalizing a with
  | nil => rfl
  | cons x xs ih =>
    have hstep : outerAux (x :: xs) a = G a x + outerAux xs (a + 1) := rfl
    rw [hstep, ih (a + 1), List.length_cons, sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, add_zero]
    rw [add_comm]
    congr 1
    refine sum_congr rfl fun i _ => ?_
    congr 1
    ring

/-! ## From the computation to a sum over all factors -/

/-- Summing a residue class of `[2, a)` as an arithmetic progression. -/
theorem sum_range_cnt (g : ℕ → ℕ) (c : ℕ) (hc2 : 2 ≤ c) (hc : c < 12) (a : ℕ) (ha : 2 ≤ a) :
    ∑ i ∈ range (cnt a c), g (c + 10 * i) =
      ∑ b ∈ Ico 2 a, if b % 10 = c % 10 then g b else 0 := by
  induction a, ha using Nat.le_induction with
  | base =>
    have h0 : cnt 2 c = 0 := by unfold cnt; omega
    simp [h0]
  | succ a ha ih =>
    rw [sum_Ico_succ_top ha, ← ih]
    by_cases hac : a % 10 = c % 10
    · have hcnt : cnt (a + 1) c = cnt a c + 1 := by unfold cnt; omega
      have hidx : c + 10 * cnt a c = a := by unfold cnt; omega
      rw [if_pos hac, hcnt, sum_range_succ, hidx]
    · have hcnt : cnt (a + 1) c = cnt a c := by unfold cnt; omega
      rw [if_neg hac, hcnt, add_zero]

/-- All offsets lie in `[2, 12)`. -/
theorem offsTable_bounds : ∀ l ∈ offsTable, ∀ c ∈ l, 2 ≤ c ∧ c < 12 := by decide

/-- All offsets of `a` lie in `[2, 12)`. -/
theorem offs_bounds (a c : ℕ) (hc : c ∈ offs a) : 2 ≤ c ∧ c < 12 := by
  unfold offs at hc
  rw [List.getD_eq_getElem?_getD] at hc
  cases h : offsTable[a % 10]? with
  | none => rw [h] at hc; simp at hc
  | some l =>
    rw [h] at hc
    exact offsTable_bounds l (List.mem_of_getElem? h) c hc

/-- Exchanging a list sum with a finset sum. -/
theorem list_sum_map_finset_sum (l : List ℕ) (s : Finset ℕ) (h : ℕ → ℕ → ℕ) :
    (l.map (fun c => ∑ b ∈ s, h c b)).sum = ∑ b ∈ s, (l.map (fun c => h c b)).sum := by
  induction l with
  | nil => simp
  | cons c l ih => simp only [List.map_cons, List.sum_cons, ih, sum_add_distrib]

/-- The contribution of `G` at `a`, as a sum over all `b ∈ [2, a)`. -/
theorem G_spec (a : ℕ) (ha : 3 ≤ a) (ha' : a < 2328) :
    G a (fibList.getD a 0) = ∑ b ∈ Ico 2 a,
      ((offs a).map (fun c => if b % 10 = c % 10 then
        T ((Nat.fib a + Nat.fib b) % M) else 0)).sum := by
  rw [G, ← list_sum_map_finset_sum]
  congr 1
  refine List.map_congr_left fun c hc => ?_
  obtain ⟨hc2, hc12⟩ := offs_bounds a c hc
  have hcnt : cnt a c ≤ 233 := by unfold cnt; omega
  rw [innerTake_spec _ _ _ (by rw [classList_length]; exact hcnt),
    ← sum_range_cnt (fun b => T ((Nat.fib a + Nat.fib b) % M)) c hc2 hc12 a (by omega)]
  refine sum_congr rfl fun i hi => ?_
  have hi' : i < cnt a c := mem_range.mp hi
  have hlt : c + 10 * i < a := by unfold cnt at hi'; omega
  rw [classList_getD c i (by omega) (by omega), fibList_spec a (by omega), ← Nat.add_mod]

/-- `F` is `10`-periodic modulo `11`. -/
theorem fib_mod_eleven (n : ℕ) : Nat.fib n % 11 = Nat.fib (n % 10) % 11 := by
  have hstep : ∀ m, Nat.fib (m + 10) % 11 = Nat.fib m % 11 := by
    intro m
    have h := Nat.fib_add m 9
    have h9 : Nat.fib 9 = 34 := by decide
    have h10 : Nat.fib 10 = 55 := by decide
    rw [show m + 9 + 1 = m + 10 by ring, h9, show (9 : ℕ) + 1 = 10 by rfl, h10] at h
    omega
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    by_cases hn : n < 10
    · rw [Nat.mod_eq_of_lt hn]
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 10 := ⟨n - 10, by omega⟩
      rw [hstep, ih m (by omega)]
      congr 2
      omega

/-- The residue table: the offsets of `a` single out exactly the classes
`b mod 10` with `11 ∣ F(a) + F(b)`. -/
theorem offsTable_count : ∀ r < 10, ∀ s < 10,
    ((offsTable.getD r []).map (fun c => if s = c % 10 then 1 else 0)).sum =
      if (Nat.fib r + Nat.fib s) % 11 = 0 then 1 else 0 := by decide

/-- Factoring a constant out of a list sum of indicator terms. -/
theorem list_sum_map_ite (l : List ℕ) (p : ℕ → Prop) [DecidablePred p] (t : ℕ) :
    (l.map (fun c => if p c then t else 0)).sum =
      (l.map (fun c => if p c then 1 else 0)).sum * t := by
  induction l with
  | nil => simp
  | cons c l ih =>
    simp only [List.map_cons, List.sum_cons, ih]
    split_ifs <;> ring

/-- The per-factor summand: the residue-level valuation of `F(a) + F(b)` if
`11` divides it, and `0` otherwise. -/
def Wt (a b : ℕ) : ℕ :=
  if (Nat.fib a + Nat.fib b) % 11 = 0 then T ((Nat.fib a + Nat.fib b) % M) else 0

/-- Summing over the offsets of `a` is the divisibility test of `Wt`. -/
theorem offs_sum_eq_Wt (a b : ℕ) :
    ((offs a).map (fun c => if b % 10 = c % 10 then
        T ((Nat.fib a + Nat.fib b) % M) else 0)).sum = Wt a b := by
  rw [list_sum_map_ite, offs, offsTable_count (a % 10) (Nat.mod_lt _ (by norm_num))
    (b % 10) (Nat.mod_lt _ (by norm_num)), Wt]
  have hmod : (Nat.fib a + Nat.fib b) % 11 = (Nat.fib (a % 10) + Nat.fib (b % 10)) % 11 := by
    rw [Nat.add_mod, fib_mod_eleven a, fib_mod_eleven b, ← Nat.add_mod]
  rw [hmod]
  split_ifs <;> simp

/-- Below the junk value, `Wt a b` is the `11`-adic valuation of the factor. -/
theorem Wt_eq_padicValNat (a b : ℕ) (h : Wt a b < 1000000) :
    Wt a b = padicValNat 11 (Nat.fib a + Nat.fib b) := by
  unfold Wt at h ⊢
  split_ifs at h ⊢ with hdvd
  · exact T_mod_eq_padicValNat _ h
  · rw [padicValNat.eq_zero_of_not_dvd]
    intro h11
    exact hdvd (Nat.mod_eq_zero_of_dvd h11)

/-- One chunk of the outer loop is the corresponding block of the double sum. -/
theorem outerAux_chunk (lo hi : ℕ) (hlo : 3 ≤ lo) (hle : lo ≤ hi) (hhi : hi ≤ 2328) :
    outerAux ((fibList.drop lo).take (hi - lo)) lo =
      ∑ a ∈ Ico lo hi, ∑ b ∈ Ico 2 a, Wt a b := by
  have hlen : ((fibList.drop lo).take (hi - lo)).length = hi - lo := by
    simp only [List.length_take, List.length_drop, fibList_length]
    omega
  rw [outerAux_spec, hlen, sum_Ico_eq_sum_range]
  refine sum_congr rfl fun i hi' => ?_
  have hi'' : i < hi - lo := mem_range.mp hi'
  have hget : ((fibList.drop lo).take (hi - lo)).getD i 0 = fibList.getD (lo + i) 0 := by
    simp only [List.getD_eq_getElem?_getD, List.getElem?_take, List.getElem?_drop,
      if_pos hi'']
  rw [hget, G_spec (lo + i) (by omega) (by omega)]
  exact sum_congr rfl fun b _ => offs_sum_eq_Wt _ _

/-! ## The kernel computation, in twelve chunks

Each chunk is a separate declaration so that the kernel cache is released
between chunks; the chunk boundaries balance the number of factors. -/

/-- Chunk 1: `a ∈ [3, 672)`. -/
theorem chunk_1 : outerAux ((fibList.drop 3).take (672 - 3)) 3 = 22118 := by
  decide +kernel

/-- Chunk 2: `a ∈ [672, 950)`. -/
theorem chunk_2 : outerAux ((fibList.drop 672).take (950 - 672)) 672 = 22261 := by
  decide +kernel

/-- Chunk 3: `a ∈ [950, 1164)`. -/
theorem chunk_3 : outerAux ((fibList.drop 950).take (1164 - 950)) 950 = 22266 := by
  decide +kernel

/-- Chunk 4: `a ∈ [1164, 1343)`. -/
theorem chunk_4 : outerAux ((fibList.drop 1164).take (1343 - 1164)) 1164 = 22272 := by
  decide +kernel

/-- Chunk 5: `a ∈ [1343, 1502)`. -/
theorem chunk_5 : outerAux ((fibList.drop 1343).take (1502 - 1343)) 1343 = 22319 := by
  decide +kernel

/-- Chunk 6: `a ∈ [1502, 1645)`. -/
theorem chunk_6 : outerAux ((fibList.drop 1502).take (1645 - 1502)) 1502 = 22081 := by
  decide +kernel

/-- Chunk 7: `a ∈ [1645, 1777)`. -/
theorem chunk_7 : outerAux ((fibList.drop 1645).take (1777 - 1645)) 1645 = 22118 := by
  decide +kernel

/-- Chunk 8: `a ∈ [1777, 1900)`. -/
theorem chunk_8 : outerAux ((fibList.drop 1777).take (1900 - 1777)) 1777 = 22604 := by
  decide +kernel

/-- Chunk 9: `a ∈ [1900, 2015)`. -/
theorem chunk_9 : outerAux ((fibList.drop 1900).take (2015 - 1900)) 1900 = 22163 := by
  decide +kernel

/-- Chunk 10: `a ∈ [2015, 2124)`. -/
theorem chunk_10 : outerAux ((fibList.drop 2015).take (2124 - 2015)) 2015 = 22272 := by
  decide +kernel

/-- Chunk 11: `a ∈ [2124, 2228)`. -/
theorem chunk_11 : outerAux ((fibList.drop 2124).take (2228 - 2124)) 2124 = 21978 := by
  decide +kernel

/-- Chunk 12: `a ∈ [2228, 2328)`. -/
theorem chunk_12 : outerAux ((fibList.drop 2228).take (2328 - 2228)) 2228 = 22502 := by
  decide +kernel

/-- Assembling twelve consecutive blocks of a sum over `[3, 2328)`; stated for
an arbitrary `f` so that no elaboration step unfolds the computed blocks. -/
theorem sum_Ico_twelve_blocks (f : ℕ → ℕ)
    (h1 : ∑ a ∈ Ico 3 672, f a = 22118)
    (h2 : ∑ a ∈ Ico 672 950, f a = 22261)
    (h3 : ∑ a ∈ Ico 950 1164, f a = 22266)
    (h4 : ∑ a ∈ Ico 1164 1343, f a = 22272)
    (h5 : ∑ a ∈ Ico 1343 1502, f a = 22319)
    (h6 : ∑ a ∈ Ico 1502 1645, f a = 22081)
    (h7 : ∑ a ∈ Ico 1645 1777, f a = 22118)
    (h8 : ∑ a ∈ Ico 1777 1900, f a = 22604)
    (h9 : ∑ a ∈ Ico 1900 2015, f a = 22163)
    (h10 : ∑ a ∈ Ico 2015 2124, f a = 22272)
    (h11 : ∑ a ∈ Ico 2124 2228, f a = 21978)
    (h12 : ∑ a ∈ Ico 2228 2328, f a = 22502) :
    ∑ a ∈ Ico 3 2328, f a = 266954 := by
  have s1 := sum_Ico_consecutive f (show 3 ≤ 672 by norm_num) (show 672 ≤ 2328 by norm_num)
  have s2 := sum_Ico_consecutive f (show 672 ≤ 950 by norm_num) (show 950 ≤ 2328 by norm_num)
  have s3 := sum_Ico_consecutive f (show 950 ≤ 1164 by norm_num) (show 1164 ≤ 2328 by norm_num)
  have s4 := sum_Ico_consecutive f (show 1164 ≤ 1343 by norm_num) (show 1343 ≤ 2328 by norm_num)
  have s5 := sum_Ico_consecutive f (show 1343 ≤ 1502 by norm_num) (show 1502 ≤ 2328 by norm_num)
  have s6 := sum_Ico_consecutive f (show 1502 ≤ 1645 by norm_num) (show 1645 ≤ 2328 by norm_num)
  have s7 := sum_Ico_consecutive f (show 1645 ≤ 1777 by norm_num) (show 1777 ≤ 2328 by norm_num)
  have s8 := sum_Ico_consecutive f (show 1777 ≤ 1900 by norm_num) (show 1900 ≤ 2328 by norm_num)
  have s9 := sum_Ico_consecutive f (show 1900 ≤ 2015 by norm_num) (show 2015 ≤ 2328 by norm_num)
  have s10 := sum_Ico_consecutive f (show 2015 ≤ 2124 by norm_num) (show 2124 ≤ 2328 by norm_num)
  have s11 := sum_Ico_consecutive f (show 2124 ≤ 2228 by norm_num) (show 2228 ≤ 2328 by norm_num)
  omega

/-- The residue-level valuations of all factors of `v(2326)` sum to `266954`. -/
theorem sum_Wt : ∑ a ∈ Ico 3 2328, ∑ b ∈ Ico 2 a, Wt a b = 266954 :=
  sum_Ico_twelve_blocks (fun a => ∑ b ∈ Ico 2 a, Wt a b)
    ((outerAux_chunk 3 672 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_1)
    ((outerAux_chunk 672 950 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_2)
    ((outerAux_chunk 950 1164 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_3)
    ((outerAux_chunk 1164 1343 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_4)
    ((outerAux_chunk 1343 1502 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_5)
    ((outerAux_chunk 1502 1645 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_6)
    ((outerAux_chunk 1645 1777 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_7)
    ((outerAux_chunk 1777 1900 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_8)
    ((outerAux_chunk 1900 2015 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_9)
    ((outerAux_chunk 2015 2124 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_10)
    ((outerAux_chunk 2124 2228 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_11)
    ((outerAux_chunk 2228 2328 (by norm_num) (by norm_num) (by norm_num)).symm.trans chunk_12)

/-! ## The two valuations -/

/-- The `11`-adic valuation of a finite product of nonzero factors. -/
theorem padicValNat_prod (s : Finset ℕ) (f : ℕ → ℕ) (hf : ∀ i ∈ s, f i ≠ 0) :
    padicValNat 11 (∏ i ∈ s, f i) = ∑ i ∈ s, padicValNat 11 (f i) := by
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s his ih =>
    rw [prod_insert his, sum_insert his,
      padicValNat.mul (hf i (mem_insert_self i s))
        (prod_ne_zero_iff.mpr fun j hj => hf j (mem_insert_of_mem hj)),
      ih fun j hj => hf j (mem_insert_of_mem hj)]

/-- The factors of `v n` are nonzero. -/
theorem fib_add_fib_ne_zero (a b : ℕ) (ha : 1 ≤ a) : Nat.fib a + Nat.fib b ≠ 0 := by
  have : 0 < Nat.fib a := Nat.fib_pos.mpr ha
  omega

/-- `padicValNat 11 (v n)` is the sum over the factors `F(a) + F(b)`,
`2 ≤ b < a ≤ n + 1`. -/
theorem padicValNat_v (n : ℕ) :
    padicValNat 11 (v n) =
      ∑ a ∈ Ico 3 (n + 2), ∑ b ∈ Ico 2 a, padicValNat 11 (Nat.fib a + Nat.fib b) := by
  rw [v, padicValNat_prod _ _ fun k _ => prod_ne_zero_iff.mpr fun j _ =>
    fib_add_fib_ne_zero _ _ (by omega)]
  rw [← Ico_add_one_right_eq_Icc, show (3 : ℕ) = 2 + 1 by rfl, show n + 2 = n + 1 + 1 by ring,
    ← sum_Ico_add']
  refine sum_congr rfl fun k _ => ?_
  rw [padicValNat_prod _ _ fun j _ => fib_add_fib_ne_zero _ _ (by omega),
    show (2 : ℕ) = 1 + 1 by rfl, ← sum_Ico_add' (fun b => padicValNat 11 (Nat.fib (k + 1) +
      Nat.fib b))]

/-- `v n ≠ 0`. -/
theorem v_ne_zero (n : ℕ) : v n ≠ 0 :=
  prod_ne_zero_iff.mpr fun _ _ => prod_ne_zero_iff.mpr fun _ _ =>
    fib_add_fib_ne_zero _ _ (by omega)

/-- **The `11`-adic valuation of `v(2326) = A203518(2326)` is `266954`.** -/
theorem padicValNat_v_2326 : padicValNat 11 (v 2326) = 266954 := by
  rw [padicValNat_v, ← sum_Wt]
  have hle : ∀ a ∈ Ico 3 2328, ∀ b ∈ Ico 2 a, Wt a b ≤ 266954 := by
    intro a ha b hb
    calc Wt a b ≤ ∑ b ∈ Ico 2 a, Wt a b := single_le_sum (fun _ _ => Nat.zero_le _) hb
      _ ≤ ∑ a ∈ Ico 3 2328, ∑ b ∈ Ico 2 a, Wt a b :=
          single_le_sum (f := fun a => ∑ b ∈ Ico 2 a, Wt a b) (fun _ _ => Nat.zero_le _) ha
      _ = 266954 := sum_Wt
  refine sum_congr rfl fun a ha => sum_congr rfl fun b hb => ?_
  exact (Wt_eq_padicValNat a b (by have := hle a ha b hb; omega)).symm

/-- **The `11`-adic valuation of `d(2326) = A000178(2325)` is `266959`**
(Legendre's formula). -/
theorem padicValNat_d_2326 : padicValNat 11 (d 2326) = 266959 := by
  rw [d, padicValNat_prod _ _ fun i _ => Nat.factorial_ne_zero i]
  have hleg : ∀ i ∈ range 2326,
      padicValNat 11 i.factorial = ∑ j ∈ Ico 1 4, i / 11 ^ j := by
    intro i hi
    apply padicValNat_factorial
    rcases Nat.eq_zero_or_pos i with h0 | hpos
    · rw [h0, Nat.log_zero_right]
      norm_num
    · exact Nat.log_lt_of_lt_pow hpos.ne' (by have := mem_range.mp hi; norm_num; omega)
  rw [sum_congr rfl hleg]
  decide +kernel

/-! ## The refutation -/

/-- Divisibility can only increase the `11`-adic valuation. -/
theorem padicValNat_le_of_dvd {a b : ℕ} (hb : b ≠ 0) (h : a ∣ b) :
    padicValNat 11 a ≤ padicValNat 11 b :=
  (padicValNat_dvd_iff_le hb).mp (pow_padicValNat_dvd.trans h)

/-- **A203520 is not integral at `n = 2326`:** `d(2326) ∤ v(2326)`, i.e.
`A203518(2326) / A000178(2325)` is not an integer, because the `11`-adic
valuation of the numerator is `266954 < 266959`. -/
theorem not_d_dvd_v_2326 : ¬ d 2326 ∣ v 2326 := by
  intro h
  have hle : padicValNat 11 (d 2326) ≤ padicValNat 11 (v 2326) :=
    padicValNat_le_of_dvd (v_ne_zero 2326) h
  rw [padicValNat_d_2326, padicValNat_v_2326] at hle
  exact absurd hle (by decide)

/-- **The A203520 conjecture is false.**

Verbatim (entry comment): "It is conjectured that every term of A203520 is an
integer."  With the entry program's `v` and `d`, the claim is
`∀ n ≥ 1, d n ∣ v n`; it fails at `n = 2326` (`not_d_dvd_v_2326`). -/
theorem conjecture_false : ¬ ∀ n : ℕ, 1 ≤ n → d n ∣ v n :=
  fun h => not_d_dvd_v_2326 (h 2326 (by norm_num))

end Candidates.A203520Refutation
