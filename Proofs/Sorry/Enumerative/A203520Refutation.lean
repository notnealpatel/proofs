namespace Candidates.A203520Refutation

open Finset

/-! ## Definitions mirroring the entry -/

/-- A203518, from the entry's program: with `f(j) = F(j+1)`,
`v(n) = ∏_{k=2}^{n} ∏_{j=1}^{k-1} (f(k) + f(j))`. -/
def v (n : ℕ) : ℕ :=
  ∏ k ∈ Icc 2 n, ∏ j ∈ Ico 1 k, (Nat.fib (k + 1) + Nat.fib (j + 1))

/-- The entry program's divisor `d(n) = ∏_{i=1}^{n} (i-1)! = ∏_{i<n} i!`,
which is `A000178(n-1)`. -/
def d (n : ℕ) : ℕ := ∏ i ∈ range n, i.factorial

/-! ## Ground truth -/

/-- `d (n + 1)` is Mathlib's superfactorial `sf n = A000178(n)`. -/
theorem d_succ_eq_superFactorial (n : ℕ) : d (n + 1) = Nat.superFactorial n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [d, prod_range_succ, ← d, ih, Nat.superFactorial_succ, mul_comm]

-- `v` reproduces the first terms of A203518, and, by the reindexing
-- `(i, j) = (j' + 1, k + 1)`, it is A203518's
-- `∏_{2 ≤ i < j ≤ n+1} (F(i) + F(j))`.
example : v 1 = 1 ∧ v 2 = 3 ∧ v 3 = 60 ∧ v 4 = 20160 ∧ v 5 = 259459200 := by
  decide +kernel

-- `d` reproduces A000178(n-1): 1, 1, 2, 12, 288, 34560.
example : d 1 = 1 ∧ d 2 = 1 ∧ d 3 = 2 ∧ d 4 = 12 ∧ d 5 = 288 ∧ d 6 = 34560 := by
  decide +kernel

-- The quotient reproduces the first six listed terms of A203520 (exactly, so
-- `d n ∣ v n` there): 1, 3, 30, 1680, 900900, 9535125600.
example : v 1 = 1 * d 1 ∧ v 2 = 3 * d 2 ∧ v 3 = 30 * d 3 ∧ v 4 = 1680 * d 4 ∧
    v 5 = 900900 * d 5 ∧ v 6 = 9535125600 * d 6 := by
  decide +kernel

/-! ## The 11-adic valuation from a residue modulo `11^7` -/

/-- `11` is prime, as a typeclass fact for the `padicValNat` API. -/
local instance fact_prime_eleven : Fact (Nat.Prime 11) := ⟨by norm_num⟩

/-- The modulus `M = 11^7` used for all residue computations. -/
def M : ℕ := 19487171

/-- `M` is `11^7`. -/
theorem M_eq : M = 11 ^ 7 := by norm_num [M]

/-- Fuel-bounded count of the factors `11` of `y` (kernel-friendly raw `Nat`
operations; `val11F fuel y = min (padicValNat 11 y) fuel` for `y ≠ 0`). -/
def val11F (fuel y : ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ) (fun _ => 0)
    (fun _ ih y => cond (Nat.beq (Nat.mod y 11) 0) (Nat.succ (ih (Nat.div y 11))) 0) fuel y

/-- The valuation read off a residue `r` modulo `11^7`; the junk value `10^6`
at `r = 0` makes any vanishing residue visible in a sum. -/
def T (r : ℕ) : ℕ := cond (Nat.beq r 0) 1000000 (val11F 7 r)

/-- `Nat.beq` is `false` on distinct arguments. -/
theorem beq_false_of_ne {a b : ℕ} (h : a ≠ b) : Nat.beq a b = false := by
  cases hb : Nat.beq a b
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true hb) h

/-- One step of the fuel-bounded valuation loop. -/
theorem val11F_succ (k y : ℕ) :
    val11F (k + 1) y = if y % 11 = 0 then val11F k (y / 11) + 1 else 0 := by
  show cond (Nat.beq (y % 11) 0) (Nat.succ (val11F k (y / 11))) 0 = _
  by_cases h : y % 11 = 0
  · simp [h]
  · simp [h, beq_false_of_ne h]

/-- For `0 < y < 11^fuel` the fuel-bounded loop is the exact `11`-adic
valuation. -/
theorem val11F_eq_padicValNat (fuel y : ℕ) (hy : y ≠ 0) (hlt : y < 11 ^ fuel) :
    val11F fuel y = padicValNat 11 y := by
  induction fuel generalizing y with
  | zero => omega
  | succ k ih =>
    rw [val11F_succ]
    by_cases h : y % 11 = 0
    · have hdvd : 11 ∣ y := Nat.dvd_of_mod_eq_zero h
      have hq : y / 11 ≠ 0 := by omega
      have hqlt : y / 11 < 11 ^ k := by
        rw [pow_succ] at hlt
        omega
      rw [if_pos h, ih (y / 11) hq hqlt, padicValNat.div hdvd]
      have h1 : 1 ≤ padicValNat 11 y := one_le_padicValNat_of_dvd hy hdvd
      omega
    · rw [if_neg h, padicValNat.eq_zero_of_not_dvd]
      intro hdvd
      exact h (Nat.mod_eq_zero_of_dvd hdvd)

/-- Reduction modulo `11^7` preserves the `11`-adic valuation as long as the
residue is nonzero. -/
theorem padicValNat_eq_of_mod_ne_zero (x : ℕ) (hr : x % 11 ^ 7 ≠ 0) :
    padicValNat 11 x = padicValNat 11 (x % 11 ^ 7) := by
  set r := x % 11 ^ 7 with hr_def
  have hx : x ≠ 0 := by
    rintro rfl
    exact hr (by simp [hr_def])
  have hdvd_iff : ∀ e ≤ 7, 11 ^ e ∣ r ↔ 11 ^ e ∣ x := fun e he =>
    Nat.dvd_mod_iff (pow_dvd_pow 11 he)
  have hrlt : r < 11 ^ 7 := Nat.mod_lt _ (by norm_num)
  have hw : padicValNat 11 r < 7 := by
    by_contra hge
    have h7 : 11 ^ 7 ∣ r := (padicValNat_dvd_iff_le hr).mpr (by omega)
    exact absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero hr) h7) (by omega)
  have hle : padicValNat 11 r ≤ padicValNat 11 x :=
    (padicValNat_dvd_iff_le hx).mp
      ((hdvd_iff _ hw.le).mp (pow_padicValNat_dvd))
  have hlt : padicValNat 11 x < padicValNat 11 r + 1 := by
    by_contra hge
    have hx1 : 11 ^ (padicValNat 11 r + 1) ∣ x := (padicValNat_dvd_iff_le hx).mpr (by omega)
    exact pow_succ_padicValNat_not_dvd hr ((hdvd_iff _ (by omega)).mpr hx1)
  omega

/-- The residue-level valuation `T (x % 11^7)` is the `11`-adic valuation of
`x` whenever it is below the junk value. -/
theorem T_mod_eq_padicValNat (x : ℕ) (hT : T (x % M) < 1000000) :
    T (x % M) = padicValNat 11 x := by
  have hr : x % M ≠ 0 := by
    intro h0
    rw [h0] at hT
    exact absurd hT (by decide)
  have hT' : T (x % M) = val11F 7 (x % M) := by
    show cond (Nat.beq (x % M) 0) 1000000 (val11F 7 (x % M)) = _
    simp [beq_false_of_ne hr]
  rw [hT', val11F_eq_padicValNat 7 _ hr (by rw [← M_eq]; exact Nat.mod_lt _ (by decide)),
    M_eq] 
  rw [M_eq] at hr
  exact (padicValNat_eq_of_mod_ne_zero x hr).symm

