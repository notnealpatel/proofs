/-
# A257883 — Kimberling's "Algorithm" family: the `a`-sequences are permutations

## OEIS source (retrieved 2026-10-21 with `oeis show A257883` and the internal
## format page https://oeis.org/A257883/internal)

```
NAME:     Sequence (a(n)) generated by Algorithm (in Comments) with a(1) = 0 and
          d(1) = 0.
TERMS:    0,1,3,2,5,9,4,10,6,11,8,15,7,16,14,22,12,23,17,27,13,25,18,31,19,33,
          20,35,24,40,21,38,29,47,26,45,28,48,30,51,36,58,32,55,39,63,34,59,...
AUTHOR:   Clark Kimberling, May 13 2015
COMMENT (the algorithm):
  Algorithm: For k >= 1, let A(k) = {a(1), ..., a(k)} and D(k) = {d(1), ...,
  d(k)}. Begin with k = 1 and nonnegative integers a(1) and d(1). Let h be the
  least integer > -a(k) such that h is not in D(k) and a(k) + h is not in A(k).
  Let a(k+1) = a(k) + h and d(k+1) = h. Replace k by k+1 and repeat inductively.
COMMENT (the conjecture, Clark Kimberling, May 13 2015):
  Conjecture: if a(1) is a nonnegative integer and d(1) is an integer, then
  (a(n)) is a permutation of the nonnegative integers (if a(1) = 0) or a
  permutation of the positive integers (if a(1) > 0). Moreover, (d(n)) is a
  permutation of the integers if d(1) = 0, or of the nonzero integers if
  d(1) > 0.
FORMULA:  a(k+1) - a(k) = d(k+1) for k >= 1.
          Also, A257883(n) = -1 + A175498(n) for n >= 1.
```

The same conjecture is repeated in A257884, A257885, A257903, A175498 (a(1)=1,
d(1)=0), A257905, A257908, A257910, A257911; A175499 asks whether the
difference sequence of A175498 is a permutation of the nonzero integers.

## Status (triage)

Open as far as the triage could tell: no proof in the entry or the literature.
This module proves part (i) for every `a(1) ≥ 0` and every `d(1) ∈ ℤ`
(`conjecture_part_i`), and proves that `d` is injective with `d(k) ≠ 0` for
`k ≥ 2`.  The covering half of part (ii) (every nonzero integer occurs as a
difference) is left as the single `sorry` (`dSeq_covers`).

## Proof of part (i) (informal)

Suppose the positive value `m` never occurs.  `a` is injective, so after some
time `K` every term exceeds `m`.  For `k ≥ K` the candidate `h = m - a(k)` has
`h > -a(k)` and `a(k) + h = m ∉ A(k)`, and the greedy choice exceeds it, so it
was rejected because `m - a(k) ∈ D(k)`.  These values are distinct negative
differences, so among `d(1), …, d(N)` at least `N - K` are negative: only
boundedly many differences are nonnegative.  Hence eventually `a` strictly
decreases, impossible in `ℕ`.

## Indexing

The entry is 1-indexed; here `aSeq a1 d1 n = a(n+1)` and `dSeq a1 d1 n = d(n+1)`.
-/
import Mathlib

set_option autoImplicit false

namespace Candidates.A257883KimberlingAlgorithmFamily


/-- State of the algorithm after `k` terms: the current term `a(k)`, the set
`A(k) = {a(1), …, a(k)}` and the set `D(k) = {d(1), …, d(k)}`. -/
structure St where
  a : ℕ
  A : Finset ℕ
  D : Finset ℤ

/-- A candidate next term `v = a(k) + h` is admissible when `h > -a(k)` (i.e.
`0 < v`), `a(k) + h ∉ A(k)` and `h ∉ D(k)`. -/
def Admissible (s : St) (v : ℕ) : Prop := 0 < v ∧ v ∉ s.A ∧ (v : ℤ) - s.a ∉ s.D

/-- Admissibility is decidable (finite-set membership). -/
instance (s : St) : DecidablePred (Admissible s) := fun v => by
  unfold Admissible; infer_instance

/-- Linear search with fuel: the first `u ≥ v` (scanning at most `n + 1` values)
satisfying `p`; used only to make the greedy choice kernel-computable. -/
def firstFrom (p : ℕ → Prop) [DecidablePred p] : ℕ → ℕ → ℕ
  | 0, v => v
  | n + 1, v => if p v then v else firstFrom p n (v + 1)

/-- If some `w ∈ [v, v + n]` satisfies `p`, then `firstFrom p n v` is the least
`u ≥ v` satisfying `p`. -/
theorem firstFrom_spec (p : ℕ → Prop) [DecidablePred p] (n v : ℕ)
    (h : ∃ w, v ≤ w ∧ w ≤ v + n ∧ p w) :
    v ≤ firstFrom p n v ∧ p (firstFrom p n v) ∧
      ∀ u, v ≤ u → u < firstFrom p n v → ¬ p u := by
  induction n generalizing v with
  | zero =>
    obtain ⟨w, hvw, hwv, hw⟩ := h
    have hwv' : w = v := by omega
    subst hwv'
    simp only [firstFrom]
    exact ⟨le_rfl, hw, fun u hu hu' => absurd hu' (by omega)⟩
  | succ n ih =>
    by_cases hv : p v
    · rw [firstFrom, if_pos hv]
      exact ⟨le_rfl, hv, fun u hu hu' => absurd hu' (by omega)⟩
    · rw [firstFrom, if_neg hv]
      obtain ⟨w, hvw, hwv, hw⟩ := h
      have hne : w ≠ v := fun hwv => hv (hwv ▸ hw)
      obtain ⟨h1, h2, h3⟩ := ih (v + 1) ⟨w, by omega, by omega, hw⟩
      refine ⟨by omega, h2, fun u hu hu' => ?_⟩
      rcases Nat.eq_or_lt_of_le hu with rfl | hlt
      · exact hv
      · exact h3 u hlt hu'

/-- An explicit admissible value: larger than every element of `A(k)` and with
`bound - a(k)` larger than every element of `D(k)`. -/
def bound (s : St) : ℕ := s.A.sup id + s.D.sup Int.toNat + s.a + 1

/-- `bound s` is admissible, so an admissible `h` always exists. -/
theorem admissible_bound (s : St) : Admissible s (bound s) := by
  refine ⟨by unfold bound; omega, fun hA => ?_, fun hD => ?_⟩
  · have := Finset.le_sup (f := id) hA
    simp only [id, bound] at this
    omega
  · have := Finset.le_sup (f := Int.toNat) hD
    simp only [bound] at this
    omega

/-- The greedy next term `a(k+1) = a(k) + h`, `h` the least admissible integer. -/
def nextVal (s : St) : ℕ := firstFrom (Admissible s) (bound s) 0

/-- `nextVal s` is admissible and no smaller natural number is. -/
theorem nextVal_spec (s : St) :
    Admissible s (nextVal s) ∧ ∀ w < nextVal s, ¬ Admissible s w := by
  obtain ⟨-, h2, h3⟩ := firstFrom_spec (Admissible s) (bound s) 0
    ⟨bound s, Nat.zero_le _, by omega, admissible_bound s⟩
  exact ⟨h2, fun w hw => h3 w (Nat.zero_le _) hw⟩

/-- Fidelity bridge: `nextVal s` is `Nat.find` of the admissibility predicate. -/
theorem nextVal_eq_find (s : St) :
    nextVal s = Nat.find ⟨bound s, admissible_bound s⟩ := by
  rw [eq_comm, Nat.find_eq_iff]
  exact nextVal_spec s

/-- One step of the algorithm: append `a(k+1)` to `A` and `d(k+1) = a(k+1) - a(k)`
to `D`. -/
def step (s : St) : St :=
  ⟨nextVal s, insert (nextVal s) s.A, insert ((nextVal s : ℤ) - s.a) s.D⟩

/-- The state after `n + 1` terms, starting from `a(1) = a1`, `d(1) = d1`. -/
def seq (a1 : ℕ) (d1 : ℤ) : ℕ → St
  | 0 => ⟨a1, {a1}, {d1}⟩
  | n + 1 => step (seq a1 d1 n)

/-- `aSeq a1 d1 n = a(n+1)` (0-indexed version of the entry's `a`). -/
def aSeq (a1 : ℕ) (d1 : ℤ) (n : ℕ) : ℕ := (seq a1 d1 n).a

/-- `dSeq a1 d1 n = d(n+1)`: `d(1) = d1`, and `d(k+1) = a(k+1) - a(k)`. -/
def dSeq (a1 : ℕ) (d1 : ℤ) : ℕ → ℤ
  | 0 => d1
  | n + 1 => (aSeq a1 d1 (n + 1) : ℤ) - aSeq a1 d1 n

/-- Unfolding: `a(n+2)` is the greedy choice at state `n`. -/
theorem aSeq_succ (a1 : ℕ) (d1 : ℤ) (n : ℕ) :
    aSeq a1 d1 (n + 1) = nextVal (seq a1 d1 n) := rfl

/-- The current term of state `n` is `aSeq n`. -/
theorem seq_a (a1 : ℕ) (d1 : ℤ) (n : ℕ) : (seq a1 d1 n).a = aSeq a1 d1 n := rfl

/-- `A(n+1)` is exactly `{aSeq i | i ≤ n}`. -/
theorem mem_seq_A (a1 : ℕ) (d1 : ℤ) (n x : ℕ) :
    x ∈ (seq a1 d1 n).A ↔ ∃ i ≤ n, aSeq a1 d1 i = x := by
  induction n with
  | zero =>
    simp only [seq, Finset.mem_singleton, Nat.le_zero, exists_eq_left, aSeq]
    exact eq_comm
  | succ n ih =>
    rw [seq, step]
    simp only [Finset.mem_insert, ih]
    constructor
    · rintro (hx | ⟨i, hi, hix⟩)
      · exact ⟨n + 1, le_rfl, hx.symm⟩
      · exact ⟨i, by omega, hix⟩
    · rintro ⟨i, hi, hix⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp (Nat.lt_succ_of_le hi) with hlt | rfl
      · exact Or.inr ⟨i, by omega, hix⟩
      · exact Or.inl hix.symm

/-- `D(n+1)` is exactly `{dSeq i | i ≤ n}`. -/
theorem mem_seq_D (a1 : ℕ) (d1 : ℤ) (n : ℕ) (y : ℤ) :
    y ∈ (seq a1 d1 n).D ↔ ∃ i ≤ n, dSeq a1 d1 i = y := by
  induction n with
  | zero =>
    simp only [seq, Finset.mem_singleton, Nat.le_zero, exists_eq_left, dSeq]
    exact eq_comm
  | succ n ih =>
    rw [seq, step]
    simp only [Finset.mem_insert, ih]
    constructor
    · rintro (hx | ⟨i, hi, hix⟩)
      · exact ⟨n + 1, le_rfl, hx.symm⟩
      · exact ⟨i, by omega, hix⟩
    · rintro ⟨i, hi, hix⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp (Nat.lt_succ_of_le hi) with hlt | rfl
      · exact Or.inr ⟨i, by omega, hix⟩
      · exact Or.inl hix.symm

/-- Every term after the first is positive (`h > -a(k)`). -/
theorem aSeq_succ_pos (a1 : ℕ) (d1 : ℤ) (n : ℕ) : 0 < aSeq a1 d1 (n + 1) :=
  (nextVal_spec _).1.1

/-- A new term differs from every earlier term. -/
theorem aSeq_succ_ne (a1 : ℕ) (d1 : ℤ) {n i : ℕ} (hi : i ≤ n) :
    aSeq a1 d1 (n + 1) ≠ aSeq a1 d1 i := fun h =>
  (nextVal_spec (seq a1 d1 n)).1.2.1 ((mem_seq_A a1 d1 n _).2 ⟨i, hi, h.symm⟩)

/-- The sequence `a` is injective. -/
theorem aSeq_injective (a1 : ℕ) (d1 : ℤ) : Function.Injective (aSeq a1 d1) := by
  intro i j hij
  by_contra hne
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
    exact aSeq_succ_ne a1 d1 (n := k) (i := i) (by omega) hij.symm
  · obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
    exact aSeq_succ_ne a1 d1 (n := k) (i := j) (by omega) hij

/-- By injectivity, every bound `m` is eventually exceeded forever. -/
theorem eventually_gt (a1 : ℕ) (d1 : ℤ) (m : ℕ) :
    ∃ K, ∀ n, K ≤ n → m < aSeq a1 d1 n := by
  have hfin : {n | aSeq a1 d1 n ≤ m}.Finite :=
    (Set.finite_Iic m).preimage (aSeq_injective a1 d1).injOn
  obtain ⟨B, hB⟩ := hfin.bddAbove
  refine ⟨B + 1, fun n hn => ?_⟩
  by_contra hle
  have hnB : n ≤ B := hB (show aSeq a1 d1 n ≤ m by omega)
  omega

/-- If the positive value `m` never occurs and `a(n+2) > m`, then the candidate
`h = m - a(n+1)` was rejected only because it already lies in `D`. -/
theorem exists_dSeq_eq_of_missing (a1 : ℕ) (d1 : ℤ) {m : ℕ} (hm : 0 < m)
    (hmiss : ∀ n, aSeq a1 d1 n ≠ m) {n : ℕ} (hn : m < aSeq a1 d1 (n + 1)) :
    ∃ j ≤ n, dSeq a1 d1 j = (m : ℤ) - aSeq a1 d1 n := by
  by_contra hD
  have hadm : Admissible (seq a1 d1 n) m := by
    refine ⟨hm, fun hA => ?_, fun hD' => hD ((mem_seq_D a1 d1 n _).1 hD')⟩
    obtain ⟨i, -, hi⟩ := (mem_seq_A a1 d1 n m).1 hA
    exact hmiss i hi
  exact (nextVal_spec (seq a1 d1 n)).2 m hn hadm

/-- If the positive value `m` never occurs and `a(n) > m` for `n ≥ K`, then at
most `K` of `d(1), …, d(N+1)` are nonnegative, for every `N`. -/
theorem card_nonneg_le (a1 : ℕ) (d1 : ℤ) {m : ℕ} (hm : 0 < m)
    (hmiss : ∀ n, aSeq a1 d1 n ≠ m) {K : ℕ} (hK : ∀ n, K ≤ n → m < aSeq a1 d1 n)
    (N : ℕ) :
    ((Finset.range (N + 1)).filter (fun j => 0 ≤ dSeq a1 d1 j)).card ≤ K := by
  set neg := (Finset.range (N + 1)).filter (fun j => ¬ 0 ≤ dSeq a1 d1 j) with hneg
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := Finset.range (N + 1)) (fun j => 0 ≤ dSeq a1 d1 j)
  rw [Finset.card_range] at hsplit
  have hsub : (Finset.Icc K N).image (fun n => (m : ℤ) - aSeq a1 d1 n) ⊆
      neg.image (dSeq a1 d1) := by
    intro y hy
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.1 hy
    obtain ⟨hKn, hnN⟩ := Finset.mem_Icc.1 hn
    obtain ⟨j, hjn, hj⟩ := exists_dSeq_eq_of_missing a1 d1 hm hmiss (hK (n + 1) (by omega))
    have hlt : (m : ℤ) < aSeq a1 d1 n := by exact_mod_cast hK n hKn
    refine Finset.mem_image.2 ⟨j, ?_, hj⟩
    rw [hneg, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, by omega⟩
  have hinj : Set.InjOn (fun n => (m : ℤ) - aSeq a1 d1 n) (Finset.Icc K N) := by
    intro x _ y _ hxy
    have hxy' : aSeq a1 d1 x = aSeq a1 d1 y := by
      have : (aSeq a1 d1 x : ℤ) = aSeq a1 d1 y := by simp only at hxy; omega
      exact_mod_cast this
    exact aSeq_injective a1 d1 hxy'
  have hcard := Finset.card_le_card hsub
  rw [Finset.card_image_of_injOn hinj, Nat.card_Icc] at hcard
  have hcard2 := (Finset.card_image_le (s := neg) (f := dSeq a1 d1))
  have hsplit' : ((Finset.range (N + 1)).filter (fun j => 0 ≤ dSeq a1 d1 j)).card +
      neg.card = N + 1 := hsplit
  omega

/-- If the positive value `m` never occurs, only finitely many `d` are
nonnegative. -/
theorem nonneg_finite (a1 : ℕ) (d1 : ℤ) {m : ℕ} (hm : 0 < m)
    (hmiss : ∀ n, aSeq a1 d1 n ≠ m) : {j | 0 ≤ dSeq a1 d1 j}.Finite := by
  obtain ⟨K, hK⟩ := eventually_gt a1 d1 m
  by_contra hinf
  obtain ⟨t, hts, htc⟩ := Set.Infinite.exists_subset_card_eq hinf (K + 1)
  have hsub : t ⊆ (Finset.range (t.sup id + 1)).filter (fun j => 0 ≤ dSeq a1 d1 j) := by
    intro j hj
    rw [Finset.mem_filter, Finset.mem_range]
    exact ⟨Nat.lt_succ_of_le (Finset.le_sup (f := id) hj), hts hj⟩
  have h1 := Finset.card_le_card hsub
  have h2 := card_nonneg_le a1 d1 hm hmiss hK (t.sup id)
  omega

/-- A strictly decreasing tail of natural numbers drops by at least one per
step. -/
theorem aSeq_add_le (a1 : ℕ) (d1 : ℤ) {L : ℕ}
    (hL : ∀ j, L ≤ j → aSeq a1 d1 (j + 1) < aSeq a1 d1 j) (t : ℕ) :
    aSeq a1 d1 (L + t) + t ≤ aSeq a1 d1 L := by
  induction t with
  | zero => simp
  | succ t ih =>
    have h := hL (L + t) (Nat.le_add_right L t)
    show aSeq a1 d1 (L + t + 1) + (t + 1) ≤ aSeq a1 d1 L
    omega

/-- Every positive integer occurs in `a`. -/
theorem exists_aSeq_eq_of_pos (a1 : ℕ) (d1 : ℤ) {m : ℕ} (hm : 0 < m) :
    ∃ n, aSeq a1 d1 n = m := by
  by_contra hcon
  have hmiss : ∀ n, aSeq a1 d1 n ≠ m := fun n hn => hcon ⟨n, hn⟩
  obtain ⟨L, hL⟩ := (nonneg_finite a1 d1 hm hmiss).bddAbove
  have hdesc : ∀ j, L ≤ j → aSeq a1 d1 (j + 1) < aSeq a1 d1 j := by
    intro j hj
    by_contra hge
    have hnn : 0 ≤ dSeq a1 d1 (j + 1) := by
      simp only [dSeq]
      omega
    have := hL hnn
    omega
  have := aSeq_add_le a1 d1 hdesc (aSeq a1 d1 L + 1)
  omega

