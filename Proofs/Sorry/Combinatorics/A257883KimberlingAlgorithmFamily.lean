/-! ## Fidelity of the greedy step -/

/-- **The step is the entry's step.** For every `k ≥ 1` (here `n = k - 1`), the
difference `h = d(k+1)` satisfies `a(k+1) = a(k) + h`, `h > -a(k)`, `h ∉ D(k)`,
`a(k) + h ∉ A(k)`, and every integer `h'` with `-a(k) < h' < h` lies in `D(k)` or
has `a(k) + h' ∈ A(k)`; i.e. `h` is the least such integer. -/
theorem dSeq_succ_spec (a1 : ℕ) (d1 : ℤ) (n : ℕ) :
    (aSeq a1 d1 (n + 1) : ℤ) = aSeq a1 d1 n + dSeq a1 d1 (n + 1) ∧
    -(aSeq a1 d1 n : ℤ) < dSeq a1 d1 (n + 1) ∧
    (∀ i ≤ n, dSeq a1 d1 i ≠ dSeq a1 d1 (n + 1)) ∧
    (∀ i ≤ n, (aSeq a1 d1 i : ℤ) ≠ aSeq a1 d1 n + dSeq a1 d1 (n + 1)) ∧
    ∀ h : ℤ, -(aSeq a1 d1 n : ℤ) < h → h < dSeq a1 d1 (n + 1) →
      (∃ i ≤ n, dSeq a1 d1 i = h) ∨ ∃ i ≤ n, (aSeq a1 d1 i : ℤ) = aSeq a1 d1 n + h := by
  obtain ⟨⟨hpos, hA, hD⟩, hmin⟩ := nextVal_spec (seq a1 d1 n)
  have hd : dSeq a1 d1 (n + 1) = (aSeq a1 d1 (n + 1) : ℤ) - aSeq a1 d1 n := rfl
  have hpos' : 0 < aSeq a1 d1 (n + 1) := hpos
  refine ⟨by omega, by omega, fun i hi hdi => ?_, fun i hi hai => ?_, fun h hlo hhi => ?_⟩
  · exact hD ((mem_seq_D a1 d1 n _).2 ⟨i, hi, hdi⟩)
  · have hai' : aSeq a1 d1 i = aSeq a1 d1 (n + 1) := by omega
    exact aSeq_succ_ne a1 d1 hi hai'.symm
  · have hv : ¬ Admissible (seq a1 d1 n) (aSeq a1 d1 n + h).toNat :=
      hmin _ (show (aSeq a1 d1 n + h).toNat < aSeq a1 d1 (n + 1) by omega)
    have hcast : (((aSeq a1 d1 n + h).toNat : ℕ) : ℤ) = aSeq a1 d1 n + h :=
      Int.toNat_of_nonneg (by omega)
    simp only [Admissible, not_and_or, not_not, not_lt] at hv
    rcases hv with hv | hv | hv
    · omega
    · obtain ⟨i, hi, hai⟩ := (mem_seq_A a1 d1 n _).1 hv
      exact Or.inr ⟨i, hi, by rw [hai, hcast]⟩
    · obtain ⟨i, hi, hdi⟩ := (mem_seq_D a1 d1 n _).1 hv
      refine Or.inl ⟨i, hi, ?_⟩
      rw [hdi, hcast, seq_a]
      ring

/-! ## Part (i) -/

/-- **Part (i) of Kimberling's conjecture (A257883, May 13 2015), proved.**
For every `a(1) ≥ 0` and every integer `d(1)`, the sequence `a` produced by the
Algorithm is injective; it is onto `ℕ` when `a(1) = 0`, and its range is exactly
the positive integers when `0 < a(1)`. -/
theorem conjecture_part_i (a1 : ℕ) (d1 : ℤ) :
    Function.Injective (aSeq a1 d1) ∧
    (a1 = 0 → Function.Surjective (aSeq a1 d1)) ∧
    (0 < a1 → Set.range (aSeq a1 d1) = Set.Ioi 0) := by
  refine ⟨aSeq_injective a1 d1, fun ha1 m => ?_, fun ha1 => ?_⟩
  · rcases Nat.eq_zero_or_pos m with rfl | hm
    · exact ⟨0, ha1⟩
    · exact exists_aSeq_eq_of_pos a1 d1 hm
  · ext m
    simp only [Set.mem_range, Set.mem_Ioi]
    constructor
    · rintro ⟨n, rfl⟩
      rcases n with _ | n
      · exact ha1
      · exact aSeq_succ_pos a1 d1 n
    · exact exists_aSeq_eq_of_pos a1 d1

/-! ## Part (ii) -/

/-- The differences `d` are injective. -/
theorem dSeq_injective (a1 : ℕ) (d1 : ℤ) : Function.Injective (dSeq a1 d1) := by
  intro i j hij
  by_contra hne
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
    exact (dSeq_succ_spec a1 d1 k).2.2.1 i (by omega) hij
  · obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
    exact (dSeq_succ_spec a1 d1 k).2.2.1 j (by omega) hij.symm

/-- Every difference after `d(1)` is nonzero. -/
theorem dSeq_succ_ne_zero (a1 : ℕ) (d1 : ℤ) (n : ℕ) : dSeq a1 d1 (n + 1) ≠ 0 := by
  intro h0
  have hne := aSeq_succ_ne a1 d1 (le_refl n)
  have hd : dSeq a1 d1 (n + 1) = (aSeq a1 d1 (n + 1) : ℤ) - aSeq a1 d1 n := rfl
  omega

/-- **Open residual (covering half of part (ii)).** For `a(1) ≥ 0` and
`d(1) ≥ 0`, every nonzero integer occurs among the differences `d`.
Numerically supported (6000 steps for `a(1) ∈ {0,1,2,3}`, several `d(1)`), but
no proof is known; A175499 asks the special case `a(1) = 1`, `d(1) = 0`. -/
theorem dSeq_covers (a1 : ℕ) (d1 : ℤ) (hd1 : 0 ≤ d1) (y : ℤ) (hy : y ≠ 0) :
    ∃ n, dSeq a1 d1 n = y := by
  sorry

/-- **Part (ii) of Kimberling's conjecture (A257883, May 13 2015).**
The differences `d` form a permutation of `ℤ` when `d(1) = 0`, and of the
nonzero integers when `d(1) > 0`.  Injectivity and the range inclusion are
proved; covering rests on `dSeq_covers`. -/
theorem conjecture_part_ii (a1 : ℕ) (d1 : ℤ) :
    Function.Injective (dSeq a1 d1) ∧
    (d1 = 0 → Function.Surjective (dSeq a1 d1)) ∧
    (0 < d1 → Set.range (dSeq a1 d1) = {y | y ≠ 0}) := by
  refine ⟨dSeq_injective a1 d1, fun hd1 y => ?_, fun hd1 => ?_⟩
  · rcases eq_or_ne y 0 with rfl | hy
    · exact ⟨0, hd1⟩
    · exact dSeq_covers a1 d1 hd1.ge y hy
  · ext y
    simp only [Set.mem_range, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨n, rfl⟩
      rcases n with _ | n
      · exact hd1.ne'
      · exact dSeq_succ_ne_zero a1 d1 n
    · exact dSeq_covers a1 d1 hd1.le y

end Candidates.A257883KimberlingAlgorithmFamily
