/-
# Union-closed (Frankl) condition for subgroup lattices: the elementary core

## Source

* MathOverflow question 154025, "A group-theoretic perspective on Frankl's
  union-closed problem", http://mathoverflow.net/q/154025 (answers by
  Russ Woodroofe and Alireza Abdollahi; the thread is cited in the paper
  below as `[MO-Question]`, "Various authors").
* A. Abdollahi, R. Woodroofe, G. Zaimi, "Frankl's Conjecture for subgroup
  lattices", Electron. J. Combin. 24(3) (2017) P3.25, arXiv:1606.00011.

## Informal claim (thread question, as recorded by the triage)

  Question: in every finite group G, is there an element of prime-power
  order that lies in at most half of the subgroups of G?  This is Frankl's
  conjecture restricted to subgroup lattices L(G), since the
  join-irreducibles of L(G) are the cyclic subgroups of prime-power order.

## Verbatim statements from arXiv:1606.00011 used here

  An element m of a lattice L is *left-modular* if for every a < b in L,
  the expression a ∨ m ∧ b can be written without parentheses. That is,
  if a ∨ (m ∧ b) = (a ∨ m) ∧ b for every a < b.

  Corollary. If a lattice L has a left-modular coatom m, then L satisfies
  Frankl's Conjecture.

  ... any normal subgroup N of G is left-modular in L(G).

## Scope and status (2026-10-21)

Proved in the literature: Woodroofe's MathOverflow answer settles the
solvable case; AWZ 2017 settle all finite groups, using King's theorem
(every non-abelian finite simple group is generated by an involution and
an element of prime order, which rests on CFSG).  This module formalizes
only the elementary core, all kernel-checked here:

1. `exists_supIrred_two_mul_card_Ici_le_of_isCoatom`: the AWZ corollary
   for a finite lattice with a left-modular coatom.
2. `exists_primePow_two_mul_card_le_of_normal_index_prime`: a finite group
   with a normal subgroup of prime index has an element of prime-power
   order lying in at most half of the subgroups.
3. `exists_primePow_two_mul_card_le_of_isSolvable`: the same for every
   nontrivial finite solvable group (Woodroofe's MathOverflow answer).

The general case for all finite groups (needing King's theorem) is not
stated here.

Convention: the left-modular law is quantified over `x ≤ y` rather than
`x < y`; the two are equivalent because both sides equal `x` when `x = y`.
-/
import Mathlib

set_option autoImplicit false

namespace Candidates.UnionClosedSubgroupLattice

/-! ## Lattice core -/

/-- Core injection: if `m` is left-modular, `a ⊔ m = ⊤` and `a ≰ m`, then
`x ↦ m ⊓ x` injects the up-set of `a` into its complement, so at most half
of the elements of a finite lattice lie above `a`. -/
theorem two_mul_card_Ici_le_of_leftModular {L : Type*} [Lattice L] [BoundedOrder L] [Finite L]
    {m a : L} (hmod : ∀ x y : L, x ≤ y → x ⊔ (m ⊓ y) = (x ⊔ m) ⊓ y)
    (hsup : a ⊔ m = ⊤) (ha : ¬ a ≤ m) :
    2 * Nat.card {x : L // a ≤ x} ≤ Nat.card L := by
  let f : {x : L // a ≤ x} → {x : L // ¬ a ≤ x} := fun x =>
    ⟨m ⊓ x.1, fun h => ha (h.trans inf_le_left)⟩
  have hrecover : ∀ x : {x : L // a ≤ x}, a ⊔ (m ⊓ x.1) = x.1 := by
    intro x
    rw [hmod a x.1 x.2, hsup, top_inf_eq]
  have hinj : Function.Injective f := by
    intro x y hxy
    have hxy' : m ⊓ x.1 = m ⊓ y.1 := congrArg Subtype.val hxy
    apply Subtype.ext
    rw [← hrecover x, ← hrecover y, hxy']
  have hle : Nat.card {x : L // a ≤ x} ≤ Nat.card {x : L // ¬ a ≤ x} :=
    Nat.card_le_card_of_injective f hinj
  have hsplit : Nat.card L = Nat.card {x : L // a ≤ x} + Nat.card {x : L // ¬ a ≤ x} := by
    classical
    rw [← Nat.card_sum, Nat.card_congr (Equiv.sumCompl (fun x : L => a ≤ x))]
  omega

/-- **AWZ (arXiv:1606.00011), Section 1.4 corollary.** A finite lattice with
a left-modular coatom `m` satisfies Frankl's condition: some sup-irreducible
`a` lies below at most half of the elements. -/
theorem exists_supIrred_two_mul_card_Ici_le_of_isCoatom {L : Type*} [Lattice L] [BoundedOrder L]
    [Finite L] (m : L) (hm : IsCoatom m)
    (hmod : ∀ x y : L, x ≤ y → x ⊔ (m ⊓ y) = (x ⊔ m) ⊓ y) :
    ∃ a : L, SupIrred a ∧ 2 * Nat.card {x : L // a ≤ x} ≤ Nat.card L := by
  obtain ⟨s, hs, hirr⟩ := exists_supIrred_decomposition (⊤ : L)
  have hex : ∃ a ∈ s, ¬ a ≤ m := by
    by_contra hcon
    push Not at hcon
    have htop : (⊤ : L) ≤ m := hs ▸ Finset.sup_le (fun b hb => hcon b hb)
    exact hm.1 (top_le_iff.mp htop)
  obtain ⟨a, has, ha⟩ := hex
  have hsup : a ⊔ m = ⊤ := by
    rcases (hm.le_iff.mp (le_sup_right : m ≤ a ⊔ m)) with h | h
    · exact h
    · exact absurd (h ▸ le_sup_left) ha
  exact ⟨a, hirr has, two_mul_card_Ici_le_of_leftModular hmod hsup ha⟩

/-! ## Subgroup lattices -/

/-- Dedekind identity: a normal subgroup `N` is left-modular in the subgroup
lattice, `H ⊔ (N ⊓ K) = (H ⊔ N) ⊓ K` whenever `H ≤ K`. -/
theorem subgroup_leftModular_of_normal {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (H K : Subgroup G) (hHK : H ≤ K) : H ⊔ (N ⊓ K) = (H ⊔ N) ⊓ K := by
  apply le_antisymm
  · exact sup_le (le_inf le_sup_left hHK) (inf_le_inf_right K le_sup_right)
  · intro z hz
    obtain ⟨hzHN, hzK⟩ := Subgroup.mem_inf.mp hz
    obtain ⟨y, hy, n, hn, hyn⟩ := Subgroup.mem_sup_of_normal_right.mp hzHN
    have hnK : n ∈ K := by
      have hn' : n = y⁻¹ * z := by rw [← hyn]; group
      rw [hn']
      exact K.mul_mem (K.inv_mem (hHK hy)) hzK
    rw [← hyn]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hy)
      (Subgroup.mem_sup_right (Subgroup.mem_inf.mpr ⟨hn, hnK⟩))

/-- If `N` has prime index, every subgroup `K ≥ N` not contained in `N` is
`⊤`. -/
theorem sup_eq_top_of_index_prime {G : Type*} [Group G] (N : Subgroup G)
    (hN : N.index.Prime) (K : Subgroup G) (hNK : N ≤ K) (hK : ¬ K ≤ N) : K = ⊤ := by
  have hmul := Subgroup.relIndex_mul_index hNK
  have hdvd : K.index ∣ N.index := Dvd.intro_left _ hmul
  rcases (Nat.dvd_prime hN).mp hdvd with h | h
  · exact Subgroup.index_eq_one.mp h
  · exfalso
    have hrel : N.relIndex K = 1 := by
      have hpos : 0 < N.index := hN.pos
      rw [h] at hmul
      exact (Nat.mul_eq_right hpos.ne').mp hmul
    exact hK (Subgroup.relIndex_eq_one.mp hrel)

/-- **Group corollary (MathOverflow 154025; AWZ).** If a finite group `G`
has a normal subgroup `N` of prime index `p`, then some `g ∈ G` of
prime-power order (any element of a Sylow `p`-subgroup outside `N`) lies in
at most half of the subgroups of `G`. -/
theorem exists_primePow_two_mul_card_le_of_normal_index_prime {G : Type*} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] (hN : N.index.Prime) :
    ∃ g : G, IsPrimePow (orderOf g) ∧
      2 * Nat.card {H : Subgroup G // g ∈ H} ≤ Nat.card (Subgroup G) := by
  set p := N.index with hp
  haveI : Fact p.Prime := ⟨hN⟩
  obtain ⟨P⟩ : Nonempty (Sylow p G) := inferInstance
  have hPN : ¬ (P : Subgroup G) ≤ N := by
    intro hle
    exact P.not_dvd_index (Subgroup.index_dvd_of_le hle)
  obtain ⟨g, hgP, hgN⟩ := Set.not_subset.mp hPN
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp P.isPGroup') ⟨g, hgP⟩
  have hk' : orderOf g = p ^ k := by rw [← Subgroup.orderOf_coe] at hk; exact hk
  have hk0 : k ≠ 0 := by
    rintro rfl
    rw [pow_zero, orderOf_eq_one_iff] at hk'
    exact hgN (hk' ▸ N.one_mem)
  refine ⟨g, hk' ▸ (hN.isPrimePow.pow hk0), ?_⟩
  have htop : Subgroup.zpowers g ⊔ N = ⊤ :=
    sup_eq_top_of_index_prime N hN _ le_sup_right
      (fun h => hgN (h (Subgroup.mem_sup_left (Subgroup.mem_zpowers g))))
  have hmain := two_mul_card_Ici_le_of_leftModular
    (fun x y hxy => subgroup_leftModular_of_normal N x y hxy) htop
    (fun h => hgN (Subgroup.zpowers_le.mp h))
  have hcongr : Nat.card {H : Subgroup G // g ∈ H} =
      Nat.card {H : Subgroup G // Subgroup.zpowers g ≤ H} :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun H => Subgroup.zpowers_le.symm))
  rw [hcongr]
  exact hmain


/-! ## Solvable groups -/

/-- A nontrivial finite commutative group has a subgroup of prime index:
any coatom `M` of its subgroup lattice gives a simple commutative quotient,
which has prime order. -/
theorem exists_index_prime_of_commGroup {A : Type*} [CommGroup A] [Finite A] [Nontrivial A] :
    ∃ M : Subgroup A, M.index.Prime := by
  obtain ⟨M, hM⟩ := IsCoatomic.exists_coatom (α := Subgroup A)
  refine ⟨M, ?_⟩
  have hsimple : IsSimpleGroup (A ⧸ M) := by
    haveI : Nontrivial (A ⧸ M) := QuotientGroup.nontrivial_iff.mpr hM.1
    refine ⟨fun H _ => ?_⟩
    have hle : M ≤ H.comap (QuotientGroup.mk' M) := by
      intro x hx
      simp [(QuotientGroup.eq_one_iff x).mpr hx]
    have hsurj : Function.Surjective (QuotientGroup.mk' M) := QuotientGroup.mk'_surjective M
    rcases hM.le_iff.mp hle with h | h
    · right
      rw [← Subgroup.map_comap_eq_self_of_surjective hsurj H, h,
        Subgroup.map_top_of_surjective _ hsurj]
    · left
      rw [← Subgroup.map_comap_eq_self_of_surjective hsurj H, h, QuotientGroup.map_mk'_self]
  rw [Subgroup.index_eq_card]
  exact CommGroup.is_simple_iff_prime_card.mp hsimple

/-- A nontrivial finite solvable group has a normal subgroup of prime
index (pulled back from a prime-index subgroup of the abelianization). -/
theorem exists_normal_index_prime_of_isSolvable {G : Type*} [Group G] [Finite G]
    [Group.IsSolvable G] [Nontrivial G] : ∃ N : Subgroup G, N.Normal ∧ N.index.Prime := by
  have hlt := Group.IsSolvable.commutator_lt_top_of_nontrivial G
  haveI : Nontrivial (Abelianization G) := QuotientGroup.nontrivial_iff.mpr hlt.ne
  obtain ⟨M, hM⟩ := exists_index_prime_of_commGroup (A := Abelianization G)
  have hsurj : Function.Surjective (Abelianization.of (G := G)) := QuotientGroup.mk'_surjective _
  refine ⟨M.comap Abelianization.of, Subgroup.Normal.comap inferInstance _, ?_⟩
  have hidx : (M.comap Abelianization.of).index = M.index :=
    Subgroup.index_comap_of_surjective (H := M) hsurj
  rw [hidx]
  exact hM

/-- **Woodroofe (MathOverflow 154025), solvable case.** Every nontrivial
finite solvable group `G` has an element `g` of prime-power order lying in
at most half of the subgroups of `G`. -/
theorem exists_primePow_two_mul_card_le_of_isSolvable {G : Type*} [Group G] [Finite G]
    [Group.IsSolvable G] [Nontrivial G] :
    ∃ g : G, IsPrimePow (orderOf g) ∧
      2 * Nat.card {H : Subgroup G // g ∈ H} ≤ Nat.card (Subgroup G) := by
  obtain ⟨N, hNnormal, hN⟩ := exists_normal_index_prime_of_isSolvable (G := G)
  exact exists_primePow_two_mul_card_le_of_normal_index_prime N hN

/-! ## Satisfiability of the hypotheses -/

/-- The lattice hypotheses hold jointly: `⊥` is a left-modular coatom of `Bool`. -/
example : IsCoatom (⊥ : Bool) ∧ ∀ x y : Bool, x ≤ y → x ⊔ (⊥ ⊓ y) = (x ⊔ ⊥) ⊓ y :=
  ⟨⟨by decide, fun b hb => by cases b <;> simp_all⟩, by decide⟩

/-- The group hypotheses hold jointly: `A₃` is normal of prime index `2` in `S₃`. -/
example : (alternatingGroup (Fin 3)).Normal ∧ (alternatingGroup (Fin 3)).index.Prime :=
  ⟨inferInstance, by rw [alternatingGroup.index_eq_two]; exact Nat.prime_two⟩

/-- The solvable-case hypotheses hold jointly at `ℤ/2ℤ`. -/
example : Finite (Multiplicative (ZMod 2)) ∧ Group.IsSolvable (Multiplicative (ZMod 2)) ∧
    Nontrivial (Multiplicative (ZMod 2)) :=
  ⟨inferInstance, inferInstance, inferInstance⟩

end Candidates.UnionClosedSubgroupLattice
