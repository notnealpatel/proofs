/-
# Omega-primality of `ℕ₀[2 + √3]` (Jiang–Li–Zhu conjecture, corrected form, one instance)

## Source

arXiv:2201.01245, C. Jiang, B. Li, S. Zhu, "On the primality and elasticity of
algebraic valuations of cyclic free semirings" (published IJAC,
DOI 10.1142/S021819672350011X; the published version was not checked).
Section 3 (Primality), the unnumbered Conjecture closing the section (after
Example 3.4), based on Cor. 3.2 and [CGG20, Thm. 5.6]. Verbatim:

> Let $\alpha$ be a positive algebraic number such that $\nn_0[\alpha]$ is
> atomic. Then $\omega(\nn_0[\alpha]) < \infty$ if and only if $\alpha \in \nn$.

Omega-primality (verbatim, start of Section 3): "the omega-primality of
$a \in \mathcal{A}(M)$, denoted by $\omega(a)$, is the smallest
$n \in \nn \cup \{\infty\}$ such that the following condition holds: if
$a \mid_M \sum_{i=1}^k a_i$ for some $a_1, \dots, a_k \in \mathcal{A}(M)$, then
there exists $S \subseteq \ldb 1, k \rdb$ with $|S| \le n$ such that
$a \mid_M \sum_{i \in S} a_i$. ... $\omega(M) := \sup \{\omega(a) \mid a \in
\mathcal{A}(M)\}$." Divisibility: "$b \mid_M c$ if there exists $b' \in M$ such
that $c = b + b'$."

## Target (special case, open as of 2026-10-21)

The conjecture as printed is false; the triage's corrected form reads
"`ω(ℕ₀[α]) < ∞` iff `ℕ₀[α]` is finitely generated". The paper proves
`ω = ∞` only for `α < 1` (Thm. 3.1 / Cor. 3.2) and [CGG20] only for rational
`α`. This module treats the instance `α = 2 + √3 > 1` (irrational, with Galois
conjugate `β = 2 - √3 ∈ (0, 1)`), which neither source covers, and proves:

* every power `α ^ n` is an atom, and these are all the atoms (`M` is atomic);
* `ω(α ^ k) = ∞` for every `k`, so `ℕ₀[α]` is anti-prime;
* `ω(ℕ₀[α]) = ∞` (`omegaM_eq_top`).

Model: `ℕ₀[α]` is realised inside `ℤ√3` as the additive closure of the powers of
`α = ⟨2, 1⟩`; `sigma1 : ℤ√3 →+* ℝ` is injective and maps it onto the additive
monoid of `ℝ` generated by the powers of `2 + √3` (`map_sigma1_M`), so the
monoids (with their atoms and divisibility) are isomorphic.

Proof mechanism: both real embeddings are nonnegative on `M`; the conjugate
`β ∈ (0, 1)` makes every `α ^ n` an atom, and `1 + α² = 4 α` gives
`α ^ k ∣_M 4 ^ m • α ^ (m + k)`, while `α ^ k ∣_M K • α ^ (m + k)` forces
`1 ≤ K β ^ m`.

Date: 2026-10-21. Status: fully proved here (no `sorry`).
-/
import Mathlib

set_option autoImplicit false

namespace OmegaPrimalityTwoPlusSqrtThree

open Zsqrtd

/-- The algebraic integer `α = 2 + √3`, as an element of `ℤ√3`. -/
def alpha : ℤ√3 := ⟨2, 1⟩

/-- The additive monoid `M_α` of the evaluation semiring `ℕ₀[α]`: the additive
closure of the powers `α ^ n`, i.e. `{f(α) | f ∈ ℕ₀[X]}`, inside `ℤ√3`. -/
def M : AddSubmonoid (ℤ√3) := AddSubmonoid.closure (Set.range (alpha ^ ·))

/-- `b ∣_M c`: there is `b' ∈ M` with `c = b + b'`. -/
def DvdM (b c : ℤ√3) : Prop := ∃ b' ∈ M, c = b + b'

/-- `a` is an atom of `M`: a nonzero element of `M` that is not a sum of two
nonzero elements of `M`. -/
def IsAtomM (a : ℤ√3) : Prop :=
  a ∈ M ∧ a ≠ 0 ∧ ∀ b ∈ M, ∀ c ∈ M, a = b + c → b = 0 ∨ c = 0

/-- The real embedding `x ↦ x.re + x.im √3`. -/
noncomputable def sigma1 : ℤ√3 →+* ℝ := toReal (by norm_num)

/-- The conjugate real embedding `x ↦ x.re - x.im √3`. -/
noncomputable def sigma2 : ℤ√3 →+* ℝ := (toReal (by norm_num)).comp (starRingEnd (ℤ√3))

/-- Explicit formula for `sigma1`. -/
lemma sigma1_apply (x : ℤ√3) : sigma1 x = x.re + x.im * Real.sqrt 3 := by
  simp [sigma1, toReal]

/-- Explicit formula for `sigma2`. -/
lemma sigma2_apply (x : ℤ√3) : sigma2 x = x.re - x.im * Real.sqrt 3 := by
  have hs : starRingEnd (ℤ√3) x = star x := rfl
  simp only [sigma2, RingHom.comp_apply, hs, toReal, lift_apply_apply, re_star, im_star,
    Int.cast_neg, neg_mul, sub_eq_add_neg, Int.cast_ofNat]

/-- `sigma1 α = 2 + √3`. -/
lemma sigma1_alpha : sigma1 alpha = 2 + Real.sqrt 3 := by
  simp [sigma1_apply, alpha]

/-- `sigma2 α = 2 - √3` (the conjugate `β`). -/
lemma sigma2_alpha : sigma2 alpha = 2 - Real.sqrt 3 := by
  simp [sigma2_apply, alpha]

/-- `1 < 2 + √3`. -/
lemma one_lt_sigma1_alpha : 1 < sigma1 alpha := by
  rw [sigma1_alpha]
  have h : 0 ≤ Real.sqrt 3 := Real.sqrt_nonneg 3
  linarith

/-- `0 < 2 - √3`. -/
lemma sigma2_alpha_pos : 0 < sigma2 alpha := by
  rw [sigma2_alpha]
  have h : Real.sqrt 3 < 2 := by
    rw [Real.sqrt_lt' (by norm_num)]; norm_num
  linarith

/-- `2 - √3 < 1`. -/
lemma sigma2_alpha_lt_one : sigma2 alpha < 1 := by
  rw [sigma2_alpha]
  have h : 1 < Real.sqrt 3 := by
    rw [Real.lt_sqrt (by norm_num)]; norm_num
  linarith

/-- Every power `α ^ j` lies in `M`. -/
lemma pow_mem_M (j : ℕ) : alpha ^ j ∈ M :=
  AddSubmonoid.subset_closure ⟨j, rfl⟩

/-- A ring embedding positive at `α` is nonnegative on `M`. -/
lemma nonneg_of_mem_M (σ : ℤ√3 →+* ℝ) (hσ : 0 < σ alpha) {x : ℤ√3} (hx : x ∈ M) :
    0 ≤ σ x := by
  induction hx using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨j, rfl⟩ := hy
    rw [map_pow]
    exact (pow_pos hσ j).le
  | zero => simp
  | add y z _ _ hy hz =>
    rw [map_add]
    exact add_nonneg hy hz

/-- A nonzero element of `M` has a power of `α` as a summand. -/
lemma eq_zero_or_exists_pow_add {x : ℤ√3} (hx : x ∈ M) :
    x = 0 ∨ ∃ j : ℕ, ∃ c ∈ M, x = alpha ^ j + c := by
  induction hx using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨j, rfl⟩ := hy
    exact Or.inr ⟨j, 0, M.zero_mem, (add_zero _).symm⟩
  | zero => exact Or.inl rfl
  | add y z hyM hzM hy hz =>
    rcases hy with rfl | ⟨j, c, hc, rfl⟩
    · rcases hz with rfl | ⟨j, c, hc, rfl⟩
      · exact Or.inl (add_zero 0)
      · exact Or.inr ⟨j, c, hc, zero_add _⟩
    · exact Or.inr ⟨j, c + z, M.add_mem hc hzM, add_assoc _ _ _⟩

/-- A ring embedding positive at `α` is positive on nonzero elements of `M`. -/
lemma pos_of_mem_M (σ : ℤ√3 →+* ℝ) (hσ : 0 < σ alpha) {x : ℤ√3} (hx : x ∈ M)
    (hx0 : x ≠ 0) : 0 < σ x := by
  rcases eq_zero_or_exists_pow_add hx with h | ⟨j, c, hc, rfl⟩
  · exact absurd h hx0
  · rw [map_add, map_pow]
    exact add_pos_of_pos_of_nonneg (pow_pos hσ j) (nonneg_of_mem_M σ hσ hc)

/-- `M` is stable under multiplication by powers of `α`. -/
lemma pow_mul_mem_M (j : ℕ) {x : ℤ√3} (hx : x ∈ M) : alpha ^ j * x ∈ M := by
  induction hx using AddSubmonoid.closure_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    rw [← pow_add]
    exact pow_mem_M (j + i)
  | zero =>
    rw [mul_zero]
    exact M.zero_mem
  | add y z _ _ hy hz =>
    rw [mul_add]
    exact M.add_mem hy hz

/-- The defining relation `1 + α ^ 2 = 4 α` (the minimal polynomial `X² - 4X + 1`). -/
lemma one_add_alpha_sq : 1 + alpha ^ 2 = 4 * alpha := by decide

/-- `(1 + α²) ^ n = 1 + c` for some `c ∈ M`. -/
lemma one_add_alpha_sq_pow (n : ℕ) : ∃ c ∈ M, (1 + alpha ^ 2) ^ n = 1 + c := by
  induction n with
  | zero => exact ⟨0, M.zero_mem, by simp⟩
  | succ n ih =>
    obtain ⟨c, hc, hcn⟩ := ih
    refine ⟨alpha ^ 2 + (c + alpha ^ 2 * c),
      M.add_mem (pow_mem_M 2) (M.add_mem hc (pow_mul_mem_M 2 hc)), ?_⟩
    rw [pow_succ, hcn]
    ring

/-- Key divisibility: `α ^ k ∣_M 4 ^ n • α ^ (n + k)`. -/
lemma dvdM_pow_nsmul (k n : ℕ) : DvdM (alpha ^ k) ((4 ^ n : ℕ) • alpha ^ (n + k)) := by
  obtain ⟨c, hc, hcn⟩ := one_add_alpha_sq_pow n
  refine ⟨alpha ^ k * c, pow_mul_mem_M k hc, ?_⟩
  have h4 : ((4 ^ n : ℕ) : ℤ√3) * alpha ^ (n + k) = alpha ^ k * (1 + alpha ^ 2) ^ n := by
    rw [one_add_alpha_sq, mul_pow, pow_add]
    push_cast
    ring
  rw [nsmul_eq_mul, h4, hcn]
  ring

/-- Powers of `α` are nonzero. -/
lemma alpha_pow_ne_zero (n : ℕ) : alpha ^ n ≠ 0 := by
  intro h0
  have hpos : 0 < sigma1 (alpha ^ n) := by
    rw [map_pow]
    exact pow_pos (lt_trans zero_lt_one one_lt_sigma1_alpha) n
  rw [h0, map_zero] at hpos
  exact lt_irrefl 0 hpos

/-- Every power `α ^ n` is an atom of `M`. -/
theorem isAtomM_pow (n : ℕ) : IsAtomM (alpha ^ n) := by
  have h1 : 0 < sigma1 alpha := lt_trans zero_lt_one one_lt_sigma1_alpha
  refine ⟨pow_mem_M n, alpha_pow_ne_zero n, ?_⟩
  · intro b hb c hc hbc
    by_contra hne
    rw [not_or] at hne
    obtain ⟨hb0, hc0⟩ := hne
    rcases eq_zero_or_exists_pow_add hb with h | ⟨i, d, hd, rfl⟩
    · exact hb0 h
    -- `α ^ n = α ^ i + (d + c)` with `d + c ≠ 0`.
    have hdc : 0 < sigma1 (d + c) := by
      rw [map_add]
      exact add_pos_of_nonneg_of_pos (nonneg_of_mem_M sigma1 h1 hd)
        (pos_of_mem_M sigma1 h1 hc hc0)
    have hsum : alpha ^ n = alpha ^ i + (d + c) := by rw [hbc, add_assoc]
    -- The first embedding forces `i < n`.
    have hin : i < n := by
      have h := congrArg sigma1 hsum
      rw [map_add, map_pow, map_pow] at h
      have hlt : sigma1 alpha ^ i < sigma1 alpha ^ n := by linarith
      exact (pow_lt_pow_iff_right₀ one_lt_sigma1_alpha).mp hlt
    -- The conjugate embedding, with `0 < β < 1`, gives `β ^ n ≥ β ^ i > β ^ n`.
    have h2 := congrArg sigma2 hsum
    rw [map_add, map_pow, map_pow] at h2
    have hdc2 : 0 ≤ sigma2 (d + c) := nonneg_of_mem_M sigma2 sigma2_alpha_pos (M.add_mem hd hc)
    have hlt : sigma2 alpha ^ n < sigma2 alpha ^ i :=
      pow_lt_pow_right_of_lt_one₀ sigma2_alpha_pos sigma2_alpha_lt_one hin
    linarith

/-- Every atom of `M` is a power of `α`. -/
theorem exists_eq_pow_of_isAtomM {a : ℤ√3} (ha : IsAtomM a) : ∃ k : ℕ, a = alpha ^ k := by
  obtain ⟨haM, ha0, hirr⟩ := ha
  rcases eq_zero_or_exists_pow_add haM with h | ⟨j, c, hc, hac⟩
  · exact absurd h ha0
  · rcases hirr _ (pow_mem_M j) c hc hac with h | h
    · exact absurd h (alpha_pow_ne_zero j)
    · exact ⟨j, by rw [hac, h, add_zero]⟩

/-- If `α ^ k ∣_M K • α ^ (n + k)` then `1 ≤ K β ^ n`, where `β = 2 - √3`. -/
lemma one_le_of_dvdM {k n K : ℕ} (h : DvdM (alpha ^ k) (K • alpha ^ (n + k))) :
    1 ≤ (K : ℝ) * sigma2 alpha ^ n := by
  obtain ⟨c, hc, hKc⟩ := h
  have h2 := congrArg sigma2 hKc
  rw [map_nsmul, map_add, map_pow, map_pow, nsmul_eq_mul, pow_add] at h2
  have hc2 : 0 ≤ sigma2 c := nonneg_of_mem_M sigma2 sigma2_alpha_pos hc
  have hk : 0 < sigma2 alpha ^ k := pow_pos sigma2_alpha_pos k
  have hle : 1 * sigma2 alpha ^ k ≤ ((K : ℝ) * sigma2 alpha ^ n) * sigma2 alpha ^ k := by
    nlinarith
  exact le_of_mul_le_mul_right hle hk

/-- The omega-primality condition at bound `n ∈ ℕ ∪ {∞}` for `a`: whenever
`a ∣_M a₁ + ⋯ + a_k` with all `aᵢ` atoms of `M`, some subfamily `S ⊆ {1, …, k}`
with `|S| ≤ n` already satisfies `a ∣_M ∑_{i ∈ S} aᵢ`. -/
def OmegaCond (a : ℤ√3) (n : ℕ∞) : Prop :=
  ∀ (k : ℕ) (f : Fin k → ℤ√3), (∀ i, IsAtomM (f i)) → DvdM a (∑ i, f i) →
    ∃ S : Finset (Fin k), (S.card : ℕ∞) ≤ n ∧ DvdM a (∑ i ∈ S, f i)

/-- The omega-primality `ω(a)` of an element `a` of `M` (Geroldinger–Hassler):
the least `n ∈ ℕ ∪ {∞}` satisfying `OmegaCond a n`. -/
noncomputable def omega (a : ℤ√3) : ℕ∞ := sInf {n | OmegaCond a n}

/-- The omega-primality of the monoid: `ω(M) = sup {ω(a) | a ∈ 𝒜(M)}`. -/
noncomputable def omegaM : ℕ∞ := ⨆ a : {a : ℤ√3 // IsAtomM a}, omega a

/-- No finite bound works for `α ^ k`: for every `N`, `OmegaCond (α ^ k) N` fails. -/
theorem not_omegaCond_pow (k N : ℕ) : ¬ OmegaCond (alpha ^ k) N := by
  intro hN
  -- Choose `m` with `(N + 1) β ^ m < 1`.
  have hNpos : (0 : ℝ) < 1 / ((N : ℝ) + 1) := by positivity
  obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one hNpos sigma2_alpha_lt_one
  have hβm : (N : ℝ) * sigma2 alpha ^ m < 1 := by
    have hN1 : (0 : ℝ) < (N : ℝ) + 1 := by positivity
    rw [lt_div_iff₀ hN1] at hm
    have hβ : 0 ≤ sigma2 alpha ^ m := (pow_pos sigma2_alpha_pos m).le
    nlinarith
  -- The family of `4 ^ m` copies of the atom `α ^ (m + k)`.
  let f : Fin (4 ^ m) → ℤ√3 := fun _ => alpha ^ (m + k)
  have hatoms : ∀ i, IsAtomM (f i) := fun _ => isAtomM_pow (m + k)
  have hsum : ∑ i, f i = (4 ^ m : ℕ) • alpha ^ (m + k) := by
    simp [f, Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  have hdvd : DvdM (alpha ^ k) (∑ i, f i) := by
    rw [hsum]
    exact dvdM_pow_nsmul k m
  obtain ⟨S, hS, hSdvd⟩ := hN (4 ^ m) f hatoms hdvd
  have hSsum : ∑ i ∈ S, f i = S.card • alpha ^ (m + k) := by
    simp [f, Finset.sum_const]
  rw [hSsum] at hSdvd
  have h1 := one_le_of_dvdM hSdvd
  have hcard : (S.card : ℝ) ≤ N := by exact_mod_cast hS
  have hβ : 0 ≤ sigma2 alpha ^ m := (pow_pos sigma2_alpha_pos m).le
  have hle : (S.card : ℝ) * sigma2 alpha ^ m ≤ (N : ℝ) * sigma2 alpha ^ m :=
    mul_le_mul_of_nonneg_right hcard hβ
  linarith

/-- `ω(α ^ k) = ∞` for every `k`. -/
theorem omega_pow_eq_top (k : ℕ) : omega (alpha ^ k) = ⊤ := by
  rw [omega, sInf_eq_top]
  intro n hn
  by_contra hne
  obtain ⟨N, rfl⟩ := WithTop.ne_top_iff_exists.mp hne
  exact not_omegaCond_pow k N hn

/-- `M_α` is anti-prime: every atom has infinite omega-primality. -/
theorem omega_eq_top_of_isAtomM {a : ℤ√3} (ha : IsAtomM a) : omega a = ⊤ := by
  obtain ⟨k, rfl⟩ := exists_eq_pow_of_isAtomM ha
  exact omega_pow_eq_top k

/-- **Main theorem.** For `α = 2 + √3`, `ω(ℕ₀[α]) = ∞`. -/
theorem omegaM_eq_top : omegaM = ⊤ := by
  rw [omegaM, eq_top_iff]
  calc (⊤ : ℕ∞) = omega 1 := by rw [← pow_zero alpha, omega_pow_eq_top 0]
    _ ≤ ⨆ a : {a : ℤ√3 // IsAtomM a}, omega a :=
      le_iSup (fun a : {a : ℤ√3 // IsAtomM a} => omega a) ⟨1, by simpa using isAtomM_pow 0⟩

/-! ## Fidelity and ground-truth checks -/

/-- `sigma1` is injective, so `ℤ√3` (and `M`) embeds in `ℝ` with `α ↦ 2 + √3`. -/
lemma sigma1_injective : Function.Injective sigma1 :=
  toReal_injective (by norm_num) (fun n hn => by
    have h : n.natAbs * n.natAbs = 3 := by
      have := congrArg Int.natAbs hn
      simpa [Int.natAbs_mul] using this.symm
    have hle : n.natAbs ≤ 2 := by nlinarith
    interval_cases h' : n.natAbs <;> omega)

/-- The image of `M` under `sigma1` is the additive monoid `ℕ₀[2 + √3] ⊆ ℝ`
generated by the powers of `2 + √3`. -/
lemma map_sigma1_M :
    M.map sigma1.toAddMonoidHom =
      AddSubmonoid.closure (Set.range fun n : ℕ => (2 + Real.sqrt 3) ^ n) := by
  rw [M, AddMonoidHom.map_mclosure, ← Set.range_comp]
  congr 2
  funext n
  simp [sigma1_alpha]

/-- `M` is atomic: it is generated by its atoms. -/
lemma M_eq_closure_atoms : M = AddSubmonoid.closure {a | IsAtomM a} := by
  apply _root_.le_antisymm
  · rw [M, AddSubmonoid.closure_le]
    rintro _ ⟨n, rfl⟩
    exact AddSubmonoid.subset_closure (isAtomM_pow n)
  · rw [AddSubmonoid.closure_le]
    intro a ha
    exact ha.1

/-- The bound `∞` always satisfies the omega-primality condition, so the infimum
defining `omega` is over a nonempty set. -/
lemma omegaCond_top (a : ℤ√3) : OmegaCond a ⊤ :=
  fun _ _ _ hdvd => ⟨Finset.univ, le_top, by simpa using hdvd⟩

/-- `α ^ 2 = 7 + 4 √3`. -/
example : alpha ^ 2 = ⟨7, 4⟩ := by decide

/-- `1` is an atom (non-vacuity of the supremum in `omegaM`). -/
example : IsAtomM 1 := by simpa using isAtomM_pow 0

/-- `1 ∣_M 4 • α`, from `4 α = 1 + α ²`. -/
example : DvdM 1 ((4 : ℕ) • alpha) :=
  ⟨alpha ^ 2, pow_mem_M 2, by rw [nsmul_eq_mul, Nat.cast_ofNat, ← one_add_alpha_sq]⟩

/-- `α ∤_M 1`. -/
example : ¬ DvdM alpha 1 := by
  rintro ⟨c, hc, h1c⟩
  have h := congrArg sigma1 h1c
  rw [map_add, map_one] at h
  have hc1 : 0 ≤ sigma1 c :=
    nonneg_of_mem_M sigma1 (lt_trans zero_lt_one one_lt_sigma1_alpha) hc
  linarith [one_lt_sigma1_alpha]

end OmegaPrimalityTwoPlusSqrtThree
