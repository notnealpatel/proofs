/-! ## The conjecture -/

/-- Sun's conjecture (OEIS A303639, April 27, 2018):
`a(n)` is positive for every `n > 1`. -/
def Conjecture : Prop := ∀ n : ℕ, 1 < n → 0 < A303639 n

/-- The conjecture in representation form: every `n > 1` is
`a^2 + b^2 + binomial(2c+1, c) + binomial(2d+1, d)` with `a ≤ b`, `c ≤ d`. -/
theorem conjecture_iff :
    Conjecture ↔ ∀ n : ℕ, 1 < n → ∃ a b c d : ℕ, a ≤ b ∧ c ≤ d ∧
      n = a ^ 2 + b ^ 2 + Nat.choose (2 * c + 1) c + Nat.choose (2 * d + 1) d := by
  refine forall_congr' fun n => imp_congr_right fun _ => ?_
  rw [A303639, card_pos]
  constructor
  · rintro ⟨⟨a, b, c, d⟩, hp⟩
    exact ⟨a, b, c, d, (mem_reps n a b c d).1 hp⟩
  · rintro ⟨a, b, c, d, h⟩
    exact ⟨(a, b, c, d), (mem_reps n a b c d).2 h⟩

/-! ## Certificates -/

/-- If `q` is a prime with `q % 4 = 3` dividing `r` to the odd power `2k+1`
exactly, then `r` is not a sum of two squares. -/
theorem not_sq_add_sq_of_cert (r q k m : ℕ) (hq : q.Prime) (hq3 : q % 4 = 3)
    (hr : r = q ^ (2 * k + 1) * m) (hm : ¬ q ∣ m) : ¬ ∃ x y, r = x ^ 2 + y ^ 2 := by
  haveI : Fact q.Prime := ⟨hq⟩
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm (dvd_zero q)
  have hpow0 : q ^ (2 * k + 1) ≠ 0 := pow_ne_zero _ hq.ne_zero
  have hr0 : r ≠ 0 := by
    rw [hr]
    exact mul_ne_zero hpow0 hm0
  have hval : padicValNat q r = 2 * k + 1 := by
    rw [hr, padicValNat.mul hpow0 hm0, padicValNat.prime_pow,
      padicValNat.eq_zero_of_not_dvd hm, add_zero]
  have hmem : q ∈ r.primeFactors := by
    rw [Nat.mem_primeFactors]
    refine ⟨hq, ?_, hr0⟩
    rw [hr]
    exact Dvd.dvd.mul_right (dvd_pow_self q (by omega)) m
  rw [Nat.eq_sq_add_sq_iff]
  intro h
  have heven : Even (padicValNat q r) := h q hmem hq3
  rw [hval] at heven
  exact (Nat.not_even_iff_odd.mpr (odd_two_mul_add_one k)) heven

/-- One case of the refutation: if `N - s₁ - s₂ = r` and `r` carries a
certificate as in `not_sq_add_sq_of_cert`, then `N ≠ x^2 + y^2 + s₁ + s₂`. -/
theorem no_rep_of_cert {N r q k m x y s₁ s₂ : ℕ} (hq : q.Prime) (hq3 : q % 4 = 3)
    (hr : r = q ^ (2 * k + 1) * m) (hm : ¬ q ∣ m) (hn : N = x ^ 2 + y ^ 2 + s₁ + s₂)
    (hrs : r + s₁ + s₂ = N) : False :=
  not_sq_add_sq_of_cert r q k m hq hq3 hr hm ⟨x, y, by omega⟩

/-- The values `binomial(2c+1, c)` for `c = 0, …, 15` (A001700). -/
def centralTable : List ℕ :=
  [1, 3, 10, 35, 126, 462, 1716, 6435, 24310, 92378, 352716, 1352078, 5200300,
    20058300, 77558760, 300540195]

/-- `binomial(2c+1, c)` agrees with `centralTable` for `c ≤ 15`. -/
theorem choose_eq_centralTable (c : ℕ) (hc : c ≤ 15) :
    Nat.choose (2 * c + 1) c = centralTable.getD c 0 := by
  interval_cases c <;> (rw [Nat.choose_eq_descFactorial_div_factorial]; rfl)

/-- `binomial(2c+1, c) > 800322180` once `c ≥ 16`. -/
theorem lt_choose_of_sixteen_le (c : ℕ) (hc : 16 ≤ c) :
    800322180 < Nat.choose (2 * c + 1) c := by
  have h33 : Nat.choose 33 16 = 1166803110 := by
    rw [Nat.choose_eq_descFactorial_div_factorial]; rfl
  have hmid : (2 * c + 1) / 2 = c := by omega
  calc 800322180 < Nat.choose 33 16 := by rw [h33]; norm_num
    _ ≤ Nat.choose (2 * c + 1) 16 := Nat.choose_le_choose 16 (by omega)
    _ ≤ Nat.choose (2 * c + 1) ((2 * c + 1) / 2) := Nat.choose_le_middle 16 _
    _ = Nat.choose (2 * c + 1) c := by rw [hmid]

