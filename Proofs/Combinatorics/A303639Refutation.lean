/-
# A303639 — refutation of Z.-W. Sun's conjecture `a(n) > 0` for `n > 1`

Zhi-Wei Sun's conjecture in OEIS A303639 (April 27, 2018) asserts
`a(n) > 0` for every `n > 1`, where `a(n)` counts representations
`n = a² + b² + binomial(2c+1,c) + binomial(2d+1,d)` by nonnegative
integers with `a ≤ b` and `c ≤ d`.

This file formalizes the known counterexample `a(800322180) = 0`,
recorded by Sunsu Jeong (August 10, 2026) and attributed to Adamczewski
by Michael De Vlieger (August 19, 2026) in the entry.

## Proof outline

* `binomial(2c+1,c)` is `1166803110 > 800322180` at `c = 16` and is monotone
  from there on, so only `c, d ≤ 15` can occur.
* For each of the 136 pairs `c ≤ d ≤ 15` the remainder
  `r = 800322180 - binomial(2c+1,c) - binomial(2d+1,d)` is written as
  `q^(2k+1) * m` with `q` prime, `q % 4 = 3`, `¬ q ∣ m`; Mathlib's
  `Nat.eq_sq_add_sq_iff` (sum of two squares theorem) then rules out
  `r = a^2 + b^2`.  The certificates were generated by a script; every number
  is rechecked by `norm_num`/`decide`.
-/
import Mathlib.NumberTheory.SumTwoSquares
import Mathlib.Tactic.NormNum.Prime

set_option autoImplicit false

namespace Candidates.A303639Refutation

open Finset

/-! ## Definition layer -/

/-- The representations counted by A303639: quadruples `(a, b, c, d)` of
nonnegative integers with `a ≤ b`, `c ≤ d` and
`n = a^2 + b^2 + binomial(2c+1, c) + binomial(2d+1, d)`.

The search box `range (n + 1)` loses nothing: any such quadruple has
`a, b, c, d ≤ n` (see `mem_reps`). -/
def reps (n : ℕ) : Finset (ℕ × ℕ × ℕ × ℕ) :=
  (range (n + 1) ×ˢ range (n + 1) ×ˢ range (n + 1) ×ˢ range (n + 1)).filter fun p =>
    p.1 ≤ p.2.1 ∧ p.2.2.1 ≤ p.2.2.2 ∧
      n = p.1 ^ 2 + p.2.1 ^ 2 + Nat.choose (2 * p.2.2.1 + 1) p.2.2.1 +
        Nat.choose (2 * p.2.2.2 + 1) p.2.2.2

/-- A303639(n): the number of ways to write `n` as
`a^2 + b^2 + binomial(2c+1, c) + binomial(2d+1, d)` with `a ≤ b` and `c ≤ d`. -/
def A303639 (n : ℕ) : ℕ := (reps n).card

/-- `c < binomial(2c+1, c)`; used to bound the search box of `reps`. -/
theorem lt_choose_two_mul_add_one (c : ℕ) : c < Nat.choose (2 * c + 1) c := by
  have hle : Nat.choose (c + 1) c ≤ Nat.choose (2 * c + 1) c :=
    Nat.choose_le_choose c (by omega)
  rw [Nat.choose_succ_self_right] at hle
  omega

/-- Membership in `reps n` is exactly the defining condition of A303639: the
bound `range (n + 1)` is automatic. -/
theorem mem_reps (n a b c d : ℕ) :
    (a, b, c, d) ∈ reps n ↔
      a ≤ b ∧ c ≤ d ∧
        n = a ^ 2 + b ^ 2 + Nat.choose (2 * c + 1) c + Nat.choose (2 * d + 1) d := by
  constructor
  · intro h
    exact (mem_filter.1 h).2
  · rintro ⟨hab, hcd, hn⟩
    have ha : a ≤ a ^ 2 := Nat.le_self_pow (by norm_num) a
    have hb : b ≤ b ^ 2 := Nat.le_self_pow (by norm_num) b
    have hc := lt_choose_two_mul_add_one c
    have hd := lt_choose_two_mul_add_one d
    simp only [reps, mem_filter, mem_product, mem_range]
    refine ⟨⟨?_, ?_, ?_, ?_⟩, hab, hcd, hn⟩ <;> omega

