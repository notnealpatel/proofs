      (by norm_num) (by norm_num) (by norm_num) (by norm_num) hn rfl

/-- No representation of `800322180` with `c ≤ d` (and no ordering on `a, b`). -/
theorem no_rep_of_le (a b c d : ℕ) (hcd : c ≤ d) :
    800322180 ≠ a ^ 2 + b ^ 2 + Nat.choose (2 * c + 1) c + Nat.choose (2 * d + 1) d := by
  intro hn
  have hd : d ≤ 15 := by
    by_contra hd
    have hlt := lt_choose_of_sixteen_le d (by omega)
    omega
  have hc : c ≤ 15 := hcd.trans hd
  rw [choose_eq_centralTable c hc, choose_eq_centralTable d hd] at hn
  exact no_rep_table a b c d hcd hd hn

/-- `800322180` has no representation `a^2 + b^2 + binomial(2c+1, c) + binomial(2d+1, d)`
at all, even without the orderings `a ≤ b`, `c ≤ d`. -/
theorem no_rep (a b c d : ℕ) :
    800322180 ≠ a ^ 2 + b ^ 2 + Nat.choose (2 * c + 1) c + Nat.choose (2 * d + 1) d := by
  rcases le_total c d with hcd | hdc
  · exact no_rep_of_le a b c d hcd
  · rw [add_right_comm]
    exact no_rep_of_le a b d c hdc

/-- `A303639(n) = 0` as soon as `n` has no representation
`a^2 + b^2 + binomial(2c+1, c) + binomial(2d+1, d)`. -/
theorem A303639_eq_zero_of_forall_ne (n : ℕ)
    (h : ∀ a b c d : ℕ,
      n ≠ a ^ 2 + b ^ 2 + Nat.choose (2 * c + 1) c + Nat.choose (2 * d + 1) d) :
    A303639 n = 0 := by
  rw [A303639, card_eq_zero, eq_empty_iff_forall_notMem]
  rintro ⟨a, b, c, d⟩ hp
  exact h a b c d ((mem_reps n a b c d).1 hp).2.2

/-- `A303639(800322180) = 0`. -/
theorem A303639_800322180 : A303639 800322180 = 0 :=
  A303639_eq_zero_of_forall_ne 800322180 no_rep

/-- **Sun's conjecture is false.** The counterexample is `n = 800322180`
(Sunsu Jeong, Aug 2026; Adamczewski): for each of the 136 pairs `c ≤ d ≤ 15`
the remainder `800322180 - binomial(2c+1,c) - binomial(2d+1,d)` has a prime
factor `q ≡ 3 (mod 4)` to an odd power, so `A303639 800322180 = 0`. -/
theorem conjecture_false : ¬ Conjecture := fun h =>
  (h 800322180 (by norm_num)).ne' A303639_800322180

end Candidates.A303639Refutation
