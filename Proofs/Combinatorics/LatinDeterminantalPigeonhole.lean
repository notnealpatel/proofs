/-
# Determinantal pigeonhole core lemma for the Latin-square parity theorem

## Source

R. Bean, "A counting proof for the smallest critical set in a Latin square",
arXiv:2610.18199. Theorem A (BCC19.2(2)) states that a partial Latin square
of order `n` with fewer than `⌊n²/4⌋` filled cells has an even number of
completions. The determinantal argument uses §4 (square-zero rules),
§§6.2–6.3 (row/column additions and removal), and §9 (pigeonhole count).

## Translation

The paper works in the tag ring `𝔽₂[x_{cs}]` modulo the bookkeeping rules,
i.e. modulo the ideal generated by the squares `x_{cs}^2`; "constant-free"
expressions form the ideal `m` generated by the tags, and every element of `m`
squares to zero there (Frobenius in characteristic two; see
`mul_self_eq_zero_of_mem_span` below).  A "matching sum of size `t`" of a
table is a permanent of a `t × t` submatrix, which equals the determinant in
characteristic two.  We state everything for an arbitrary commutative ring `R`
and an ideal `m` with `a * a = 0` for all `a ∈ m`; characteristic two is not
needed for the determinant form of the argument.  Minors are taken along
arbitrary index maps `Fin t → Fin n` (non-injective ones give determinant
zero), which contains the case of embeddings.  The "size" bound
`max (t_r - k) 0` of the paper is the truncated natural subtraction `t r - k`.

The paper performs `k` successive one-by-one pivots; we perform the same
elimination as a single block Schur complement
(`Matrix.fromBlocks_eq_of_invertible₁₁`).  Row and column additions become
left and right multiplication, which preserve minor ideals by the multilinear
(Cauchy-Binet) expansion `det_mul_eq_sum`; the block matrix `diag(A, Z)` is
handled by a generalized Laplace expansion (`det_fromBlocks_submatrix_mem`).
The result (`exists_minors_mem_minorIdeal_of_marked`) puts every `t`-minor of
`Y` in the ideal of `(t - k)`-minors of the final table `Z`; that ideal lies in
`J ^ (t - k)` for the ideal `J` spanned by the entries of `Z`, and
`J ^ N = ⊥` once `N > (n - k) ^ 2` (`entryIdeal_pow_eq_bot`, the pigeonhole).

Main declarations: `prod_minors_eq_zero` (pigeonhole vanishing),
`exists_minors_mem_minorIdeal_of_marked` (elimination),
`prod_minors_eq_zero_of_marked` (the consequence), and
`prod_row_minors_eq_zero` (the count `c < ⌊n^2/4⌋` of Section 9).

## Scope

This module formalizes the
determinantal core lemma; the identification of the coefficient of `V` with
`N(P)` (eq. (1) of the paper) is not formalized here.
-/
import Mathlib

set_option autoImplicit false

namespace Candidates.LatinDeterminantalPigeonhole

open Matrix

variable {R : Type*} [CommRing R]

/-! ## Definitions and examples -/

/-- The ideal of `R` spanned by all entries of a matrix `Z`; in the paper's
language, the ideal of expressions in the entries of the final table. -/
def entryIdeal {α β : Type*} (Z : Matrix α β R) : Ideal R :=
  Ideal.span (Set.range fun p : α × β => Z p.1 p.2)

/-- `MinorsIn M I` says that every `t × t` minor of `M`, taken along arbitrary
row and column index maps `Fin t → _`, lies in the ideal `I t`. -/
def MinorsIn {α β : Type*} (M : Matrix α β R) (I : ℕ → Ideal R) : Prop :=
  ∀ (t : ℕ) (f : Fin t → α) (g : Fin t → β), (M.submatrix f g).det ∈ I t

/-- The entry ideal of the `1 × 1` matrix `(x)` is `(x)`. -/
example (x : ℤ) : entryIdeal (!![x] : Matrix (Fin 1) (Fin 1) ℤ) = Ideal.span {x} := by
  unfold entryIdeal
  congr 1
  ext y
  simp [eq_comm]

/-- The `2 × 2` minor of `!![a, b; c, d]` along the identity maps
is `a * d - b * c`, so `MinorsIn` constrains the usual determinant. -/
example (a b c d : ℤ) :
    ((!![a, b; c, d] : Matrix (Fin 2) (Fin 2) ℤ).submatrix id id).det = a * d - b * c := by
  simp [Matrix.det_fin_two]

/-! ## The square-zero rule (Section 4) -/

/-- Section 4 of the paper: in characteristic two, if an ideal is spanned by
square-zero elements then every element of it squares to zero
("$a^2\equiv0$ for every constant-free expression $a$"). -/
theorem mul_self_eq_zero_of_mem_span [CharP R 2] (G : Set R) (hG : ∀ x ∈ G, x * x = 0)
    (a : R) (ha : a ∈ Ideal.span G) : a * a = 0 := by
  induction ha using Submodule.span_induction with
  | mem x hx => exact hG x hx
  | zero => simp
  | add x y _ _ hx hy =>
    have h2 : (2 : R) = 0 := CharP.cast_eq_zero R 2
    calc (x + y) * (x + y) = x * x + y * y + 2 * (x * y) := by ring
      _ = 0 := by rw [hx, hy, h2]; ring
  | smul r x _ hx =>
    calc (r • x) * (r • x) = (r * r) * (x * x) := by rw [smul_eq_mul]; ring
      _ = 0 := by rw [hx, mul_zero]

/-! ## Pigeonhole vanishing (Section 9) -/

/-- If `K ^ 2 = ⊥`, then `(K ⊔ I) ^ (n + 1) ≤ I ^ (n + 1) ⊔ K * I ^ n`. -/
theorem sup_pow_succ_le_of_sq_eq_bot (I K : Ideal R) (hK : K ^ 2 = ⊥) (n : ℕ) :
    (K ⊔ I) ^ (n + 1) ≤ I ^ (n + 1) ⊔ K * I ^ n := by
  induction n with
  | zero => simp [sup_comm]
  | succ n ih =>
    have hKK : K * K = ⊥ := by rw [← sq]; exact hK
    calc (K ⊔ I) ^ (n + 1 + 1) = (K ⊔ I) * (K ⊔ I) ^ (n + 1) := pow_succ' _ _
      _ ≤ (K ⊔ I) * (I ^ (n + 1) ⊔ K * I ^ n) := Ideal.mul_mono_right ih
      _ = I ^ (n + 1 + 1) ⊔ K * I ^ (n + 1) := by
        rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup, ← mul_assoc, hKK, Ideal.bot_mul,
          mul_left_comm I K, ← pow_succ', ← pow_succ', sup_bot_eq, sup_comm, sup_assoc,
          sup_idem]

/-- Pigeonhole principle for square-zero generators: an ideal spanned by a
finite set `G` of elements with `x * x = 0` has `(span G) ^ (#G + 1) = ⊥`
(a product of `#G + 1` generators repeats one of them). -/
theorem span_pow_card_succ_eq_bot (G : Finset R) (hG : ∀ x ∈ G, x * x = 0) :
    Ideal.span (G : Set R) ^ (G.card + 1) = ⊥ := by
  classical
  induction G using Finset.induction_on with
  | empty => simp
  | insert a G haG ih =>
    have hG' : ∀ x ∈ G, x * x = 0 := fun x hx => hG x (Finset.mem_insert_of_mem hx)
    have ha : a * a = 0 := hG a (Finset.mem_insert_self a G)
    have hK : Ideal.span {a} ^ 2 = (⊥ : Ideal R) := by
      rw [Ideal.span_singleton_pow, sq, ha, Ideal.span_singleton_eq_bot]
    rw [Finset.coe_insert, Ideal.span_insert, Finset.card_insert_of_notMem haG]
    refine le_bot_iff.mp ?_
    calc (Ideal.span {a} ⊔ Ideal.span (G : Set R)) ^ (G.card + 1 + 1)
        ≤ Ideal.span (G : Set R) ^ (G.card + 1 + 1) ⊔
            Ideal.span {a} * Ideal.span (G : Set R) ^ (G.card + 1) :=
          sup_pow_succ_le_of_sq_eq_bot _ _ hK _
      _ = ⊥ := by rw [pow_succ, ih hG', Ideal.mul_bot, Ideal.bot_mul, sup_bot_eq]

/-- The entry ideal of an `a × b` table whose entries square to zero vanishes
in every power `N` with `a * b < N`. -/
theorem entryIdeal_pow_eq_bot {α β : Type*} [Fintype α] [Fintype β] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (Z : Matrix α β R) (hZ : ∀ i j, Z i j ∈ m) {N : ℕ}
    (hN : Fintype.card α * Fintype.card β < N) : entryIdeal Z ^ N = ⊥ := by
  classical
  set G : Finset R := Finset.univ.image fun p : α × β => Z p.1 p.2 with hGdef
  have hspan : entryIdeal Z = Ideal.span (G : Set R) := by
    rw [hGdef, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    rfl
  have hG : ∀ x ∈ G, x * x = 0 := by
    intro x hx
    obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hx
    exact hm _ (hZ p.1 p.2)
  have hcard : G.card + 1 ≤ N := by
    have h1 : G.card ≤ Fintype.card (α × β) := Finset.card_image_le.trans (by simp)
    rw [Fintype.card_prod] at h1
    omega
  rw [hspan]
  exact le_bot_iff.mp ((Ideal.pow_le_pow_right hcard).trans (span_pow_card_succ_eq_bot G hG).le)

/-- A product over a finset of elements of `J` lies in `J ^ #s`. -/
theorem prod_mem_pow_card {ι : Type*} (J : Ideal R) (s : Finset ι) (x : ι → R)
    (hx : ∀ i ∈ s, x i ∈ J) : ∏ i ∈ s, x i ∈ J ^ s.card := by
  have h := Ideal.prod_mem_prod (I := fun _ => J) hx
  rwa [Finset.prod_const] at h

/-- Every `t × t` minor of a matrix with entries in an ideal `J` lies in `J ^ t`. -/
theorem minorsIn_pow_of_mem {α β : Type*} (Z : Matrix α β R) (J : Ideal R)
    (hZ : ∀ i j, Z i j ∈ J) : MinorsIn Z fun t => J ^ t := by
  intro t f g
  rw [Matrix.det_apply]
  refine Ideal.sum_mem _ fun σ _ => ?_
  have hprod : ∏ i, Z.submatrix f g (σ i) i ∈ J ^ t := by
    have h := prod_mem_pow_card J Finset.univ (fun i => Z.submatrix f g (σ i) i)
      (fun i _ => hZ _ _)
    rwa [Finset.card_univ, Fintype.card_fin] at h
  rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> rw [h]
  · simpa using hprod
  · simpa using hprod

/-- **Pigeonhole vanishing** (Section 9).  Let `Z` be an `a × b` table whose
entries lie in an ideal `m` of square-zero elements.  Any product of minors of
`Z` whose sizes `t r` add up to more than `a * b` (the number of positions of
`Z`) is zero. -/
theorem prod_minors_eq_zero {α β : Type*} [Fintype α] [Fintype β] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (Z : Matrix α β R) (hZ : ∀ i j, Z i j ∈ m)
    {ι : Type*} (I : Finset ι) (t : ι → ℕ) (f : (r : ι) → Fin (t r) → α)
    (g : (r : ι) → Fin (t r) → β)
    (hW : Fintype.card α * Fintype.card β < ∑ r ∈ I, t r) :
    ∏ r ∈ I, (Z.submatrix (f r) (g r)).det = 0 := by
  have hmem : ∏ r ∈ I, (Z.submatrix (f r) (g r)).det ∈ entryIdeal Z ^ ∑ r ∈ I, t r := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun r _ =>
      minorsIn_pow_of_mem Z (entryIdeal Z)
        (fun i j => Ideal.subset_span ⟨(i, j), rfl⟩) (t r) (f r) (g r)
  rw [entryIdeal_pow_eq_bot m hm Z hZ hW] at hmem
  exact (Submodule.mem_bot R).mp hmem


/-! ## Row and column additions (Section 6.2): minors of products -/

/-- Multilinear expansion of a rectangular product: for `C : t × N` and
`D : N × t`, `det (C * D) = ∑_φ (∏ i, C i (φ i)) * det (rows φ of D)`. -/
theorem det_mul_eq_sum {t : ℕ} {N : Type*} [Fintype N] [DecidableEq N]
    (C : Matrix (Fin t) N R) (D : Matrix N (Fin t) R) :
    (C * D).det = ∑ φ : Fin t → N, (∏ i, C i (φ i)) * (D.submatrix φ id).det := by
  have hrow : (C * D : Fin t → Fin t → R) = fun i => ∑ a, C i a • D a := by
    funext i j
    simp [Matrix.mul_apply, Finset.sum_apply]
  have key := (Matrix.detRowAlternating : (Fin t → R) [⋀^Fin t]→ₗ[R] R).toMultilinearMap.map_sum
    (fun i a => C i a • D a)
  simp only [AlternatingMap.coe_multilinearMap] at key
  change Matrix.detRowAlternating (C * D) = _
  rw [hrow, key]
  refine Finset.sum_congr rfl fun φ _ => ?_
  rw [AlternatingMap.map_smul_univ]
  rfl

/-- Multiplying on the left preserves membership of all minors in a family of
ideals (the row-addition half of Section 6.2, in Cauchy-Binet form). -/
theorem MinorsIn.mul_left {α β γ : Type*} [Fintype γ] [DecidableEq γ] {N : Matrix γ β R}
    {I : ℕ → Ideal R} (hN : MinorsIn N I) (M : Matrix α γ R) : MinorsIn (M * N) I := by
  intro t f g
  rw [Matrix.submatrix_mul M N f id g Function.bijective_id, det_mul_eq_sum]
  refine Ideal.sum_mem _ fun φ _ => Ideal.mul_mem_left _ _ ?_
  rw [Matrix.submatrix_submatrix]
  exact hN t φ g

/-- `MinorsIn` is invariant under transposition. -/
theorem MinorsIn.transpose {α β : Type*} {M : Matrix α β R} {I : ℕ → Ideal R}
    (hM : MinorsIn M I) : MinorsIn Mᵀ I := by
  intro t f g
  rw [← Matrix.transpose_submatrix, Matrix.det_transpose]
  exact hM t g f

/-- Multiplying on the right preserves membership of all minors in a family of
ideals (the column-addition half of Section 6.2). -/
theorem MinorsIn.mul_right {α β γ : Type*} [Fintype γ] [DecidableEq γ] {M : Matrix α γ R}
    {I : ℕ → Ideal R} (hM : MinorsIn M I) (N : Matrix γ β R) : MinorsIn (M * N) I := by
  have h := (hM.transpose.mul_left Nᵀ).transpose
  rwa [← Matrix.transpose_mul, Matrix.transpose_transpose] at h

/-! ## The removal step (Section 6.3) -/

/-- The ideal generated by the `j × j` minors of `Z` (along arbitrary index maps);
in the paper's language, the ideal generated by the matching sums of size `j`
of the table `Z`. -/
def minorIdeal {α β : Type*} (Z : Matrix α β R) (j : ℕ) : Ideal R :=
  Ideal.span {x | ∃ (f : Fin j → α) (g : Fin j → β), (Z.submatrix f g).det = x}

/-- The size-`0` minor ideal is the whole ring (the empty matching
sum is `1`, as in Section 8 of the paper). -/
example (Z : Matrix (Fin 2) (Fin 2) ℤ) : minorIdeal Z 0 = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  exact Ideal.subset_span ⟨Fin.elim0, Fin.elim0, Matrix.det_isEmpty⟩

/-- A `j × j` minor of `Z` lies in `minorIdeal Z j`. -/
theorem det_submatrix_mem_minorIdeal {α β : Type*} (Z : Matrix α β R) {j : ℕ}
    (f : Fin j → α) (g : Fin j → β) : (Z.submatrix f g).det ∈ minorIdeal Z j :=
  Ideal.subset_span ⟨f, g, rfl⟩

/-- Laplace expansion: `minorIdeal Z (j + 1) ≤ minorIdeal Z j`. -/
theorem minorIdeal_succ_le {α β : Type*} (Z : Matrix α β R) (j : ℕ) :
    minorIdeal Z (j + 1) ≤ minorIdeal Z j := by
  refine Ideal.span_le.mpr ?_
  rintro x ⟨f, g, rfl⟩
  rw [SetLike.mem_coe, Matrix.det_succ_row_zero]
  refine Ideal.sum_mem _ fun c _ => Ideal.mul_mem_left _ _ ?_
  rw [Matrix.submatrix_submatrix]
  exact det_submatrix_mem_minorIdeal Z _ _

/-- The minor ideals decrease with the size. -/
theorem minorIdeal_antitone {α β : Type*} (Z : Matrix α β R) {i j : ℕ} (hij : i ≤ j) :
    minorIdeal Z j ≤ minorIdeal Z i := by
  induction j, hij using Nat.le_induction with
  | base => exact le_rfl
  | succ j _ ih => exact (minorIdeal_succ_le Z j).trans ih

/-- If the entries of `Z` lie in `J`, then `minorIdeal Z j ≤ J ^ j`. -/
theorem minorIdeal_le_pow {α β : Type*} (Z : Matrix α β R) (J : Ideal R)
    (hZ : ∀ i j, Z i j ∈ J) (j : ℕ) : minorIdeal Z j ≤ J ^ j := by
  refine Ideal.span_le.mpr ?_
  rintro x ⟨f, g, rfl⟩
  exact minorsIn_pow_of_mem Z J hZ j f g

/-- Generalized Laplace expansion for a block upper-triangular matrix
`fromBlocks A B 0 Z`: a minor whose rows meet the first block at most `K` times
lies in the ideal of minors of `Z` of size `t - K`. -/
theorem det_fromBlocks_submatrix_mem {κ ρ ρ' : Type*} (A : Matrix κ κ R)
    (B : Matrix κ ρ' R) (Z : Matrix ρ ρ' R) (t : ℕ) (f : Fin t → κ ⊕ ρ) (g : Fin t → κ ⊕ ρ')
    (K : ℕ) (hK : (Finset.univ.filter fun i => (f i).isLeft).card ≤ K) :
    ((fromBlocks A B 0 Z).submatrix f g).det ∈ minorIdeal Z (t - K) := by
  classical
  induction t generalizing K with
  | zero =>
    rw [Matrix.det_isEmpty, Nat.zero_sub]
    exact Ideal.subset_span ⟨Fin.elim0, Fin.elim0, Matrix.det_isEmpty⟩
  | succ t ih =>
    by_cases hl : ∃ i0, (f i0).isLeft
    · obtain ⟨i0, hi0⟩ := hl
      have hcount : (Finset.univ.filter fun i => (f (i0.succAbove i)).isLeft).card + 1 =
          (Finset.univ.filter fun i => (f i).isLeft).card := by
        rw [Finset.card_filter, Finset.card_filter, Fin.sum_univ_succAbove _ i0, hi0]
        simp only [if_true]
        ring
      rw [Matrix.det_succ_row _ i0]
      refine Ideal.sum_mem _ fun c _ => Ideal.mul_mem_left _ _ ?_
      rw [Matrix.submatrix_submatrix]
      have h := ih (f ∘ i0.succAbove) (g ∘ c.succAbove) (K - 1) (by
        simp only [Function.comp_apply]
        omega)
      have hidx : t + 1 - K = t - (K - 1) := by omega
      rwa [hidx]
    · simp only [not_exists, Bool.not_eq_true, Sum.isLeft_eq_false] at hl
      have hfr : ∀ i, ∃ a, f i = Sum.inr a := fun i => Sum.isRight_iff.mp (hl i)
      choose fr hfr using hfr
      by_cases hg : ∃ j0, (g j0).isLeft
      · obtain ⟨j0, hj0⟩ := hg
        obtain ⟨b, hb⟩ := Sum.isLeft_iff.mp hj0
        rw [Matrix.det_eq_zero_of_column_eq_zero j0 fun i => by simp [hfr i, hb]]
        exact zero_mem _
      · simp only [not_exists, Bool.not_eq_true, Sum.isLeft_eq_false] at hg
        have hgr : ∀ j, ∃ b, g j = Sum.inr b := fun j => Sum.isRight_iff.mp (hg j)
        choose gr hgr using hgr
        have hsub : (fromBlocks A B 0 Z).submatrix f g = Z.submatrix fr gr := by
          ext i j
          simp [hfr i, hgr j]
        rw [hsub]
        exact minorIdeal_antitone Z (Nat.sub_le _ _) (det_submatrix_mem_minorIdeal Z fr gr)

/-- Minors of a block upper-triangular matrix `fromBlocks A B 0 Z`: every
`t × t` minor lies in the ideal generated by the `(t - #κ) × (t - #κ)` minors
of `Z`, since at most `#κ` of its rows meet the first block. -/
theorem minorsIn_fromBlocks_minorIdeal {κ ρ ρ' : Type*} [Fintype κ] (A : Matrix κ κ R)
    (B : Matrix κ ρ' R) (Z : Matrix ρ ρ' R) :
    MinorsIn (fromBlocks A B 0 Z) fun t => minorIdeal Z (t - Fintype.card κ) := by
  classical
  intro t f g
  by_cases hf : Function.Injective f
  swap
  · obtain ⟨i, j, hij, hne⟩ : ∃ i j, f i = f j ∧ i ≠ j := by
      simp only [Function.Injective, not_forall] at hf
      obtain ⟨i, j, hij, hne⟩ := hf
      exact ⟨i, j, hij, hne⟩
    rw [Matrix.det_zero_of_row_eq hne (by ext c; simp [hij])]
    exact zero_mem _
  refine det_fromBlocks_submatrix_mem A B Z t f g _ ?_
  have h := Finset.card_le_card_of_injOn f
    (s := Finset.univ.filter fun i => (f i).isLeft)
    (t := (Finset.univ : Finset κ).map Function.Embedding.inl)
    (by
      intro i hi
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq] at hi
      obtain ⟨a, ha⟩ := Sum.isLeft_iff.mp hi
      simp [ha])
    (fun i _ j _ hij => hf hij)
  simpa using h

/-- A square matrix congruent to the identity modulo an ideal of square-zero
elements is invertible (Section 4: "$(1+a)^2\equiv1$"). -/
theorem isUnit_det_of_sub_one_mem {κ : Type*} [Fintype κ] [DecidableEq κ] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (A : Matrix κ κ R) (hA : ∀ i j, A i j - (1 : Matrix κ κ R) i j ∈ m) :
    IsUnit A.det := by
  have hmap : (Ideal.Quotient.mk m).mapMatrix A = 1 := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, ← RingHom.map_one (Ideal.Quotient.mk m).mapMatrix,
      RingHom.mapMatrix_apply, Matrix.map_apply]
    exact Ideal.Quotient.eq.mpr (hA i j)
  have hdet : A.det - 1 ∈ m := by
    refine Ideal.Quotient.eq.mp ?_
    rw [RingHom.map_det, hmap, Matrix.det_one, map_one]
  have hnil : IsNilpotent (A.det - 1) := ⟨2, by rw [sq]; exact hm _ hdet⟩
  have h := hnil.isUnit_one_add
  rwa [add_sub_cancel] at h

/-- **Elimination** (Sections 6.3 and 9, block form).  Let `Y` be a square table
indexed by `κ ⊕ ρ` (rows) and `κ ⊕ ρ'` (columns) whose `κ × κ` block is the
identity modulo `m` (the marked entries `1 + (constant-free)` in distinct rows
and columns) and whose `κ × ρ'` and `ρ × ρ'` blocks have entries in `m`, where
every element of `m` squares to zero.  (The paper also has the `ρ × κ` block in
`m`; that hypothesis is not needed.)  Then there is a table `Z : ρ × ρ'` with
entries in `m` such that every `t × t` minor of `Y` lies in the ideal generated
by the `(t - #κ) × (t - #κ)` minors of `Z` ("every matching sum of `Y` is `≡` a
sum of expressions times matching sums of `Z`, each of the same size or one
less", iterated over the `#κ` marked entries). -/
theorem exists_minors_mem_minorIdeal {κ ρ ρ' : Type*} [Fintype κ] [DecidableEq κ]
    [Fintype ρ] [DecidableEq ρ] [Fintype ρ'] [DecidableEq ρ'] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (Y : Matrix (κ ⊕ ρ) (κ ⊕ ρ') R)
    (hA : ∀ i j, Y (.inl i) (.inl j) - (1 : Matrix κ κ R) i j ∈ m)
    (hB : ∀ i j, Y (.inl i) (.inr j) ∈ m) (hD : ∀ i j, Y (.inr i) (.inr j) ∈ m) :
    ∃ Z : Matrix ρ ρ' R, (∀ i j, Z i j ∈ m) ∧
      MinorsIn Y fun t => minorIdeal Z (t - Fintype.card κ) := by
  classical
  have hunit : IsUnit Y.toBlocks₁₁.det := isUnit_det_of_sub_one_mem m hm _ hA
  letI : Invertible Y.toBlocks₁₁ := Y.toBlocks₁₁.invertibleOfIsUnitDet hunit
  obtain ⟨Z, hZdef⟩ : ∃ Z : Matrix ρ ρ' R,
      Z = Y.toBlocks₂₂ - Y.toBlocks₂₁ * ⅟Y.toBlocks₁₁ * Y.toBlocks₁₂ := ⟨_, rfl⟩
  have hfac : Y = fromBlocks (1 : Matrix κ κ R) 0 (Y.toBlocks₂₁ * ⅟Y.toBlocks₁₁)
      (1 : Matrix ρ ρ R) * fromBlocks Y.toBlocks₁₁ 0 0 Z *
      fromBlocks (1 : Matrix κ κ R) (⅟Y.toBlocks₁₁ * Y.toBlocks₁₂) 0 (1 : Matrix ρ' ρ' R) := by
    rw [hZdef, ← Matrix.fromBlocks_eq_of_invertible₁₁, Matrix.fromBlocks_toBlocks]
  refine ⟨Z, ?_, ?_⟩
  · intro i j
    rw [hZdef]
    refine m.sub_mem (hD i j) ?_
    rw [Matrix.mul_apply]
    exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (hB l j)
  · rw [hfac]
    exact MinorsIn.mul_right (MinorsIn.mul_left (minorsIn_fromBlocks_minorIdeal _ _ _) _) _

/-- **Elimination, power form.**  Under the hypotheses of
`exists_minors_mem_minorIdeal`, there is a table `Z : ρ × ρ'` with entries in
`m` such that every `t × t` minor of `Y` lies in `J ^ (t - #κ)`, where `J` is
the ideal spanned by the entries of `Z`. -/
theorem exists_minors_mem_entryIdeal_pow {κ ρ ρ' : Type*} [Fintype κ] [DecidableEq κ]
    [Fintype ρ] [DecidableEq ρ] [Fintype ρ'] [DecidableEq ρ'] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (Y : Matrix (κ ⊕ ρ) (κ ⊕ ρ') R)
    (hA : ∀ i j, Y (.inl i) (.inl j) - (1 : Matrix κ κ R) i j ∈ m)
    (hB : ∀ i j, Y (.inl i) (.inr j) ∈ m) (hD : ∀ i j, Y (.inr i) (.inr j) ∈ m) :
    ∃ Z : Matrix ρ ρ' R, (∀ i j, Z i j ∈ m) ∧
      MinorsIn Y fun t => entryIdeal Z ^ (t - Fintype.card κ) := by
  obtain ⟨Z, hZm, hY⟩ := exists_minors_mem_minorIdeal m hm Y hA hB hD
  refine ⟨Z, hZm, fun t f g => ?_⟩
  exact minorIdeal_le_pow Z (entryIdeal Z) (fun i j => Ideal.subset_span ⟨(i, j), rfl⟩) _
    (hY t f g)

/-! ## The pigeonhole consequence (Section 9) -/

/-- **Determinantal pigeonhole, block form** (Section 9).  Under the hypotheses
of `exists_minors_mem_entryIdeal_pow`, any product of minors of `Y` of sizes
`t r` with `#ρ * #ρ' < ∑_r (t r - #κ)` (truncated subtraction, the paper's
`max (t_r - k) 0`) vanishes. -/
theorem prod_minors_eq_zero_of_block {κ ρ ρ' : Type*} [Fintype κ] [DecidableEq κ]
    [Fintype ρ] [DecidableEq ρ] [Fintype ρ'] [DecidableEq ρ'] (m : Ideal R)
    (hm : ∀ x ∈ m, x * x = 0) (Y : Matrix (κ ⊕ ρ) (κ ⊕ ρ') R)
    (hA : ∀ i j, Y (.inl i) (.inl j) - (1 : Matrix κ κ R) i j ∈ m)
    (hB : ∀ i j, Y (.inl i) (.inr j) ∈ m) (hD : ∀ i j, Y (.inr i) (.inr j) ∈ m)
    {ι : Type*} (I : Finset ι) (t : ι → ℕ) (f : (r : ι) → Fin (t r) → κ ⊕ ρ)
    (g : (r : ι) → Fin (t r) → κ ⊕ ρ')
    (hW : Fintype.card ρ * Fintype.card ρ' < ∑ r ∈ I, (t r - Fintype.card κ)) :
    ∏ r ∈ I, (Y.submatrix (f r) (g r)).det = 0 := by
  obtain ⟨Z, hZm, hY⟩ := exists_minors_mem_entryIdeal_pow m hm Y hA hB hD
  have hmem : ∏ r ∈ I, (Y.submatrix (f r) (g r)).det ∈
      entryIdeal Z ^ ∑ r ∈ I, (t r - Fintype.card κ) := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun r _ => hY (t r) (f r) (g r)
  rw [entryIdeal_pow_eq_bot m hm Z hZm hW] at hmem
  exact (Submodule.mem_bot R).mp hmem

/-- **Elimination for an `n × n` table with `k` marked entries** (arXiv:2610.18199,
Sections 6.3 and 9).  Let `m` be an ideal of a commutative ring all of whose
elements square to zero.  Let `Y` be an `n × n` table with `k` marked entries
`Y (a l) (b l)` in distinct rows and distinct columns, each congruent to `1`
modulo `m`, and all other entries in `m`.  Then there is an
`(n - k) × (n - k)` table `Z` with entries in `m` such that every `t × t` minor
of `Y` lies in the ideal generated by the `(t - k) × (t - k)` minors of `Z`. -/
theorem exists_minors_mem_minorIdeal_of_marked (m : Ideal R) (hm : ∀ x ∈ m, x * x = 0)
    {n k : ℕ} (Y : Matrix (Fin n) (Fin n) R) (a b : Fin k ↪ Fin n)
    (hmark : ∀ l, Y (a l) (b l) - 1 ∈ m)
    (hrest : ∀ i j, (∀ l, ¬ (a l = i ∧ b l = j)) → Y i j ∈ m) :
    ∃ Z : Matrix (Fin (n - k)) (Fin (n - k)) R, (∀ i j, Z i j ∈ m) ∧
      ∀ (t : ℕ) (f g : Fin t → Fin n), (Y.submatrix f g).det ∈ minorIdeal Z (t - k) := by
  classical
  let eR : Fin k ⊕ {i // i ∉ Set.range a} ≃ Fin n :=
    (Equiv.sumCongr (Equiv.ofInjective a a.injective) (Equiv.refl _)).trans
      (Equiv.sumCompl (· ∈ Set.range a))
  let eC : Fin k ⊕ {j // j ∉ Set.range b} ≃ Fin n :=
    (Equiv.sumCongr (Equiv.ofInjective b b.injective) (Equiv.refl _)).trans
      (Equiv.sumCompl (· ∈ Set.range b))
  have heR_inl : ∀ l, eR (.inl l) = a l := fun l => rfl
  have heR_inr : ∀ i, eR (.inr i) = i.1 := fun i => rfl
  have heC_inl : ∀ l, eC (.inl l) = b l := fun l => rfl
  have heC_inr : ∀ j, eC (.inr j) = j.1 := fun j => rfl
  have hcardR : Fintype.card {i // i ∉ Set.range a} = n - k := by
    have h := Fintype.card_congr eR
    rw [Fintype.card_sum, Fintype.card_fin, Fintype.card_fin] at h
    omega
  have hcardC : Fintype.card {j // j ∉ Set.range b} = n - k := by
    have h := Fintype.card_congr eC
    rw [Fintype.card_sum, Fintype.card_fin, Fintype.card_fin] at h
    omega
  set Y' := Y.submatrix eR eC with hY'
  have hA : ∀ i j, Y' (.inl i) (.inl j) - (1 : Matrix (Fin k) (Fin k) R) i j ∈ m := by
    intro i j
    simp only [hY', Matrix.submatrix_apply, heR_inl, heC_inl]
    by_cases hij : i = j
    · subst hij
      simpa using hmark i
    · rw [Matrix.one_apply_ne hij, sub_zero]
      refine hrest _ _ fun l ⟨hl1, hl2⟩ => hij ?_
      rw [← a.injective hl1, b.injective hl2]
  have hB : ∀ i j, Y' (.inl i) (.inr j) ∈ m := by
    intro i j
    simp only [hY', Matrix.submatrix_apply, heR_inl, heC_inr]
    exact hrest _ _ fun l ⟨_, hl2⟩ => j.2 ⟨l, hl2⟩
  have hD : ∀ i j, Y' (.inr i) (.inr j) ∈ m := by
    intro i j
    simp only [hY', Matrix.submatrix_apply, heR_inr, heC_inr]
    exact hrest _ _ fun l ⟨hl1, _⟩ => i.2 ⟨l, hl1⟩
  obtain ⟨Z₀, hZ₀m, hY'Z₀⟩ := exists_minors_mem_minorIdeal m hm Y' hA hB hD
  let fR : {i // i ∉ Set.range a} ≃ Fin (n - k) := Fintype.equivFinOfCardEq hcardR
  let fC : {j // j ∉ Set.range b} ≃ Fin (n - k) := Fintype.equivFinOfCardEq hcardC
  refine ⟨Z₀.submatrix fR.symm fC.symm, fun i j => hZ₀m _ _, fun t f g => ?_⟩
  have hle : ∀ j, minorIdeal Z₀ j ≤ minorIdeal (Z₀.submatrix fR.symm fC.symm) j := by
    intro j
    refine Ideal.span_le.mpr ?_
    rintro x ⟨f', g', rfl⟩
    have hsub : Z₀.submatrix f' g' = (Z₀.submatrix fR.symm fC.symm).submatrix (fR ∘ f')
        (fC ∘ g') := by
      rw [Matrix.submatrix_submatrix]
      ext x y
      simp
    rw [SetLike.mem_coe, hsub]
    exact det_submatrix_mem_minorIdeal _ _ _
  have hsub : Y.submatrix f g = Y'.submatrix (eR.symm ∘ f) (eC.symm ∘ g) := by
    rw [hY', Matrix.submatrix_submatrix]
    ext x y
    simp
  rw [hsub]
  have h := hY'Z₀ t (eR.symm ∘ f) (eC.symm ∘ g)
  rw [Fintype.card_fin] at h
  exact hle _ h

/-- **Determinantal pigeonhole core lemma** (arXiv:2610.18199, Sections 6.3 and
9).  Let `m` be an ideal of a commutative ring all of whose elements square to
zero.  Let `Y` be an `n × n` table with `k` marked entries `Y (a l) (b l)` in
distinct rows and distinct columns, each congruent to `1` modulo `m`, and all
other entries in `m`.  Then any product of minors of `Y`, of sizes `t r`, with
`(n - k) ^ 2 < ∑_r max (t r - k) 0` vanishes. -/
theorem prod_minors_eq_zero_of_marked (m : Ideal R) (hm : ∀ x ∈ m, x * x = 0) {n k : ℕ}
    (Y : Matrix (Fin n) (Fin n) R) (a b : Fin k ↪ Fin n)
    (hmark : ∀ l, Y (a l) (b l) - 1 ∈ m)
    (hrest : ∀ i j, (∀ l, ¬ (a l = i ∧ b l = j)) → Y i j ∈ m)
    {ι : Type*} (I : Finset ι) (t : ι → ℕ) (f : (r : ι) → Fin (t r) → Fin n)
    (g : (r : ι) → Fin (t r) → Fin n) (hW : (n - k) ^ 2 < ∑ r ∈ I, (t r - k)) :
    ∏ r ∈ I, (Y.submatrix (f r) (g r)).det = 0 := by
  obtain ⟨Z, hZm, hYZ⟩ := exists_minors_mem_minorIdeal_of_marked m hm Y a b hmark hrest
  have hmem : ∏ r ∈ I, (Y.submatrix (f r) (g r)).det ∈
      entryIdeal Z ^ ∑ r ∈ I, (t r - k) := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun r _ =>
      minorIdeal_le_pow Z (entryIdeal Z) (fun i j => Ideal.subset_span ⟨(i, j), rfl⟩) _
        (hYZ (t r) (f r) (g r))
  have hW' : Fintype.card (Fin (n - k)) * Fintype.card (Fin (n - k)) <
      ∑ r ∈ I, (t r - k) := by
    rw [Fintype.card_fin, ← sq]
    exact hW
  rw [entryIdeal_pow_eq_bot m hm Z hZm hW'] at hmem
  exact (Submodule.mem_bot R).mp hmem

/-- **The pigeonhole step of Theorem A** (arXiv:2610.18199, Section 9), in the
exact shape used there.  Put `k = ⌊n/2⌋` marked entries on the diagonal
positions `(j, j)`, `j < k`, each congruent to `1` modulo `m`, all other entries
in `m`.  If the row sizes `t r` add up to at least `n ^ 2 - c` (the number of
empty cells of a partial Latin square with `c` filled cells) and
`c < ⌊n ^ 2 / 4⌋`, then the product over the rows of minors of sizes `t r` of
`Y` vanishes. -/
theorem prod_row_minors_eq_zero (m : Ideal R) (hm : ∀ x ∈ m, x * x = 0) {n c : ℕ}
    (Y : Matrix (Fin n) (Fin n) R)
    (hmark : ∀ j : Fin n, (j : ℕ) < n / 2 → Y j j - 1 ∈ m)
    (hrest : ∀ i j : Fin n, (i = j → n / 2 ≤ (i : ℕ)) → Y i j ∈ m)
    (t : Fin n → ℕ) (f g : (r : Fin n) → Fin (t r) → Fin n)
    (hc : c < n ^ 2 / 4) (ht : n ^ 2 - c ≤ ∑ r, t r) :
    ∏ r, (Y.submatrix (f r) (g r)).det = 0 := by
  set k := n / 2 with hk
  have hkn : k ≤ n := Nat.div_le_self n 2
  have hquarter : n ^ 2 / 4 = k * (n - k) := by
    rcases Nat.even_or_odd' n with ⟨q, rfl | rfl⟩
    · have h1 : k = q := by omega
      rw [h1, show 2 * q - q = q by omega, show (2 * q) ^ 2 = 4 * (q * q) by ring]
      omega
    · have h1 : k = q := by omega
      rw [h1, show 2 * q + 1 - q = q + 1 by omega,
        show (2 * q + 1) ^ 2 = 4 * (q * (q + 1)) + 1 by ring]
      omega
  let e : Fin k ↪ Fin n := Fin.castLEEmb hkn
  have he : ∀ l, (e l : ℕ) = l := fun l => rfl
  refine prod_minors_eq_zero_of_marked m hm Y e e (fun l => hmark _ ?_) ?_ Finset.univ t f g ?_
  · rw [he]; exact l.2
  · intro i j hij
    refine hrest i j fun hEq => ?_
    subst hEq
    by_contra hlt
    exact hij ⟨i.1, by omega⟩ ⟨Fin.ext rfl, Fin.ext rfl⟩
  · have hsum : ∑ r, t r ≤ ∑ r, (t r - k) + n * k := by
      have h1 : ∑ r : Fin n, t r ≤ ∑ r : Fin n, ((t r - k) + k) :=
        Finset.sum_le_sum fun r _ => by omega
      rwa [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        smul_eq_mul] at h1
    have hsq : n ^ 2 = (n - k) ^ 2 + k * (n - k) + n * k := by
      obtain ⟨d, hd⟩ : ∃ d, d = n - k := ⟨_, rfl⟩
      have hn : n = k + d := by omega
      rw [← hd, hn]
      ring
    rw [hquarter] at hc
    omega

/-! ## Non-vacuity -/

/-- In the dual numbers over `ZMod 2`, every element of `(ε)` squares to zero:
the hypothesis `hm` is satisfied by a nonzero ideal. -/
theorem dualNumber_eps_mul_self (x : DualNumber (ZMod 2))
    (hx : x ∈ Ideal.span {(DualNumber.eps : DualNumber (ZMod 2))}) : x * x = 0 := by
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hx
  calc r * DualNumber.eps * (r * DualNumber.eps) =
      r * r * (DualNumber.eps * DualNumber.eps) := by ring
    _ = 0 := by rw [DualNumber.eps_mul_eps, mul_zero]

/-- Non-vacuity of `prod_minors_eq_zero_of_marked`: over `(ZMod 2)[ε]` with
`m = (ε)`, the table `!![1, ε; ε, ε]` (one marked entry at `(0,0)`) satisfies
all hypotheses, its determinant `ε` is nonzero, and the theorem kills the
square of this `2 × 2` minor (sizes `2, 2`, `∑ (t - 1) = 2 > 1 = (2 - 1) ^ 2`). -/
example :
    let ε : DualNumber (ZMod 2) := DualNumber.eps
    let Y : Matrix (Fin 2) (Fin 2) (DualNumber (ZMod 2)) := !![1, ε; ε, ε]
    Y.det ≠ 0 ∧ ∏ _r ∈ (Finset.univ : Finset (Fin 2)), (Y.submatrix id id).det = 0 := by
  intro ε Y
  have hdet : Y.det = ε := by
    simp only [Y, Matrix.det_fin_two_of, ε, DualNumber.eps_mul_eps, sub_zero, one_mul]
  constructor
  · rw [hdet]
    intro h
    have h2 := congrArg TrivSqZeroExt.snd h
    simp [ε] at h2
  · let a : Fin 1 ↪ Fin 2 := Fin.castLEEmb (by norm_num)
    refine prod_minors_eq_zero_of_marked (Ideal.span {ε}) dualNumber_eps_mul_self Y a a
      ?_ ?_ Finset.univ (fun _ => 2) (fun _ => id) (fun _ => id) (by decide)
    · intro l
      fin_cases l
      simp [Y, a]
    · intro i j hij
      have hε : ε ∈ Ideal.span {ε} := Ideal.mem_span_singleton_self ε
      fin_cases i <;> fin_cases j
      · exact absurd ⟨rfl, rfl⟩ (hij 0)
      · simp [Y, hε]
      · simp [Y, hε]
      · simp [Y, hε]

end Candidates.LatinDeterminantalPigeonhole
