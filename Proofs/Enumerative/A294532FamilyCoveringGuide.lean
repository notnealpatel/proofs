/-! ## `mex` API -/

/-- Specification of the bounded upward scan `mexFrom`. -/
theorem mexFrom_spec (l : List ℤ) : ∀ (f : ℕ) (m : ℤ),
    m ≤ mexFrom f m l ∧ mexFrom f m l ≤ m + f ∧
    (∀ k, m ≤ k → k < mexFrom f m l → k ∈ l) ∧
    (mexFrom f m l ∉ l ∨ mexFrom f m l = m + f) := by
  intro f
  induction f with
  | zero =>
    intro m
    refine ⟨le_rfl, by simp [mexFrom], fun k h1 h2 => ?_, Or.inr (by simp [mexFrom])⟩
    rw [mexFrom] at h2
    omega
  | succ f ih =>
    intro m
    by_cases hm : m ∈ l
    · obtain ⟨h1, h2, h3, h4⟩ := ih (m + 1)
      rw [mexFrom, if_pos hm]
      refine ⟨by omega, by push_cast; omega, fun k hk hk' => ?_,
        h4.imp id fun h => by push_cast; omega⟩
      rcases eq_or_lt_of_le hk with rfl | hk
      · exact hm
      · exact h3 k (by omega) hk'
    · rw [mexFrom, if_neg hm]
      exact ⟨le_rfl, by omega, fun k hk hk' => by omega, Or.inl hm⟩

/-- `mex l` is positive. -/
theorem one_le_mex (l : List ℤ) : 1 ≤ mex l := (mexFrom_spec l _ 1).1

/-- Pigeonhole: `mex l ≤ l.length + 1`. -/
theorem mex_le (l : List ℤ) : mex l ≤ l.length + 1 := by
  by_contra h
  obtain ⟨-, -, h3, -⟩ := mexFrom_spec l (l.length + 1) 1
  have hsub : Finset.Ico (1 : ℤ) (l.length + 2) ⊆ l.toFinset := by
    intro k hk
    rw [Finset.mem_Ico] at hk
    rw [List.mem_toFinset]
    exact h3 k hk.1 (by unfold mex at h; omega)
  have hcard := Finset.card_le_card hsub
  rw [Int.card_Ico] at hcard
  have hlen := List.toFinset_card_le l
  omega

/-- Every positive integer below `mex l` lies in `l`. -/
theorem mem_of_lt_mex {l : List ℤ} {k : ℤ} (hk1 : 1 ≤ k) (hk : k < mex l) : k ∈ l :=
  (mexFrom_spec l _ 1).2.2.1 k hk1 hk

/-- `mex l` is not in `l`. -/
theorem mex_not_mem (l : List ℤ) : mex l ∉ l := by
  rcases (mexFrom_spec l (l.length + 1) 1).2.2.2 with h | h
  · exact h
  · have hle := mex_le l
    unfold mex at hle
    push_cast at h
    omega

/-- If `l ⊆ l'` and `mex l ∈ l'`, then `mex l < mex l'`. -/
theorem mex_lt_mex {l l' : List ℤ} (hsub : ∀ x ∈ l, x ∈ l') (hmem : mex l ∈ l') :
    mex l < mex l' := by
  by_contra h
  have hne : mex l' ≠ mex l := fun heq => mex_not_mem l' (heq ▸ hmem)
  have hlt : mex l' < mex l := lt_of_le_of_ne (not_lt.mp h) hne
  exact mex_not_mem l' (hsub _ (mem_of_lt_mex (one_le_mex l') hlt))

/-! ## The recurrences -/

section Recurrence

variable (u v w k : ℤ)

/-- One step of the history extends the `a`-list by `a (n+2)`. -/
theorem hist_fst_succ (n : ℕ) :
    (hist u v w k (n + 1)).1 = a u v w k (n + 2) :: (hist u v w k n).1 := rfl

/-- One step of the history extends the `b`-list by `b (n+2)`. -/
theorem hist_snd_succ (n : ℕ) :
    (hist u v w k (n + 1)).2 = b u v w k (n + 2) :: (hist u v w k n).2 := rfl

/-- The second entry of the `a`-history `hist n` is `a n`. -/
theorem hist_fst_tail_headD (n : ℕ) : (hist u v w k n).1.tail.headD 0 = a u v w k n := by
  cases n with
  | zero => rfl
  | succ n => rw [hist_fst_succ]; rfl

/-- The second entry of the `b`-history `hist n` is `b n`. -/
theorem hist_snd_tail_headD (n : ℕ) : (hist u v w k n).2.tail.headD 0 = b u v w k n := by
  cases n with
  | zero => rfl
  | succ n => rw [hist_snd_succ]; rfl

/-- The defining recurrence `a (n+2) = a (n+1) + a n + u b (n+1) + v b n + w (n+2) + k`. -/
theorem a_add_two (n : ℕ) :
    a u v w k (n + 2) = a u v w k (n + 1) + a u v w k n + u * b u v w k (n + 1) +
      v * b u v w k n + w * ((n : ℤ) + 2) + k := by
  rw [← hist_fst_tail_headD u v w k n, ← hist_snd_tail_headD u v w k n]
  rfl

/-- `b 0 = 3`. -/
theorem b_zero : b u v w k 0 = 3 := rfl

/-- `b 1 = mex [a 1, a 0, b 0]`. -/
theorem b_one : b u v w k 1 = mex [2, 1, 3] := rfl

/-- `b (n+2)` is the `mex` of `a 0, …, a (n+2), b 0, …, b (n+1)`. -/
theorem b_add_two (n : ℕ) :
    b u v w k (n + 2) = mex (a u v w k (n + 2) :: (hist u v w k n).1 ++ (hist u v w k n).2) :=
  rfl

/-- Both histories in `hist n` have length `n + 2`. -/
theorem hist_length (n : ℕ) :
    (hist u v w k n).1.length = n + 2 ∧ (hist u v w k n).2.length = n + 2 := by
  induction n with
  | zero => exact ⟨rfl, rfl⟩
  | succ n ih =>
    rw [hist_fst_succ, hist_snd_succ, List.length_cons, List.length_cons, ih.1, ih.2]
    exact ⟨rfl, rfl⟩

/-- Linear bound: `b n ≤ 2n + 3`. -/
theorem b_le (n : ℕ) : b u v w k n ≤ 2 * n + 3 := by
  match n with
  | 0 => rw [b_zero]; decide
  | 1 => rw [b_one]; decide
  | n + 2 =>
    rw [b_add_two]
    refine (mex_le _).trans ?_
    simp only [List.length_cons, List.length_append, (hist_length u v w k n).1,
      (hist_length u v w k n).2]
    push_cast
    omega

/-- `b` is strictly increasing. -/
theorem b_lt_succ (n : ℕ) : b u v w k n < b u v w k (n + 1) := by
  match n with
  | 0 => rw [b_zero, b_one]; decide
  | 1 =>
    rw [b_add_two u v w k 0, b_one]
    apply mex_lt_mex
    · intro x hx
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      simp only [hist, List.mem_cons, List.mem_append, List.not_mem_nil, or_false]
      omega
    · simp [hist]
  | n + 2 =>
    rw [b_add_two u v w k (n + 1), b_add_two u v w k n, hist_fst_succ, hist_snd_succ]
    apply mex_lt_mex
    · intro x hx
      simp only [List.mem_cons, List.mem_append] at hx ⊢
      tauto
    · rw [← b_add_two]
      simp

/-- Lower bound: `n + 3 ≤ b n`. -/
theorem le_b (n : ℕ) : (n : ℤ) + 3 ≤ b u v w k n := by
  induction n with
  | zero => rw [b_zero]; decide
  | succ n ih =>
    have h := b_lt_succ u v w k n
    push_cast
    omega

end Recurrence

/-! ## Growth and the forcing bound

Throughout, the parameters satisfy the sign conditions
`0 ≤ u`, `0 ≤ u + v`, `0 ≤ u + v + w`, `0 ≤ 2u + v + k`, which hold for every member of
the guide.  Under them the forcing `L_n` is nonnegative because `b(n-1) - b(n-2) ≥ 1` and
`b(n-2) ≥ n + 1`. -/

section Growth

variable {u v w k : ℤ}

/-- The forcing `u b (n+1) + v b n + w (n+2) + k` is nonnegative under the sign
conditions. -/
theorem forcing_nonneg (hu : 0 ≤ u) (huv : 0 ≤ u + v) (huvw : 0 ≤ u + v + w)
    (hk : 0 ≤ 2 * u + v + k) (n : ℕ) :
    0 ≤ u * b u v w k (n + 1) + v * b u v w k n + w * ((n : ℤ) + 2) + k := by
  have hgap : 0 ≤ b u v w k (n + 1) - b u v w k n - 1 := by
    have h := b_lt_succ u v w k n
    omega
  have hlow : 0 ≤ b u v w k n - ((n : ℤ) + 3) := by
    have h := le_b u v w k n
    omega
  have h1 : 0 ≤ u * (b u v w k (n + 1) - b u v w k n - 1) := mul_nonneg hu hgap
  have h2 : 0 ≤ (u + v) * (b u v w k n - ((n : ℤ) + 3)) := mul_nonneg huv hlow
  have h3 : 0 ≤ (u + v + w) * ((n : ℤ) + 2) := mul_nonneg huvw (by positivity)
  have hid : u * b u v w k (n + 1) + v * b u v w k n + w * ((n : ℤ) + 2) + k =
      u * (b u v w k (n + 1) - b u v w k n - 1) + (u + v) * (b u v w k n - ((n : ℤ) + 3)) +
        (u + v + w) * ((n : ℤ) + 2) + (2 * u + v + k) := by ring
  rw [hid]
  linarith

/-- The forcing is at most `(5|u| + 3|v| + 2|w| + |k|) (n+1)`. -/
theorem forcing_le (n : ℕ) :
    u * b u v w k (n + 1) + v * b u v w k n + w * ((n : ℤ) + 2) + k ≤
      (5 * |u| + 3 * |v| + 2 * |w| + |k|) * ((n : ℤ) + 1) := by
  have hb1 := b_le u v w k (n + 1)
  have hb0 := b_le u v w k n
  have hb1' := le_b u v w k (n + 1)
  have hb0' := le_b u v w k n
  push_cast at hb1 hb1'
  have hn : (0 : ℤ) ≤ n := Int.natCast_nonneg n
  have e1 : u * b u v w k (n + 1) ≤ |u| * (2 * (n : ℤ) + 5) :=
    calc u * b u v w k (n + 1) ≤ |u| * b u v w k (n + 1) :=
          mul_le_mul_of_nonneg_right (le_abs_self u) (by omega)
      _ ≤ |u| * (2 * (n : ℤ) + 5) := mul_le_mul_of_nonneg_left (by omega) (abs_nonneg u)
  have e2 : v * b u v w k n ≤ |v| * (2 * (n : ℤ) + 3) :=
    calc v * b u v w k n ≤ |v| * b u v w k n :=
          mul_le_mul_of_nonneg_right (le_abs_self v) (by omega)
      _ ≤ |v| * (2 * (n : ℤ) + 3) := mul_le_mul_of_nonneg_left (by omega) (abs_nonneg v)
  have e3 : w * ((n : ℤ) + 2) ≤ |w| * ((n : ℤ) + 2) :=
    mul_le_mul_of_nonneg_right (le_abs_self w) (by omega)
  have e4 : k ≤ |k| := le_abs_self k
  have f1 : 0 ≤ |u| * (n : ℤ) := mul_nonneg (abs_nonneg u) hn
  have f2 : 0 ≤ |v| * (n : ℤ) := mul_nonneg (abs_nonneg v) hn
  have f3 : 0 ≤ |w| * (n : ℤ) := mul_nonneg (abs_nonneg w) hn
  have f4 : 0 ≤ |k| * (n : ℤ) := mul_nonneg (abs_nonneg k) hn
  linarith

/-- The forcing term `a (n+2) - a (n+1) - a n` is linearly bounded (over `ℝ`). -/
theorem abs_forcing_le (hu : 0 ≤ u) (huv : 0 ≤ u + v) (huvw : 0 ≤ u + v + w)
    (hk : 0 ≤ 2 * u + v + k) (n : ℕ) :
    |(a u v w k (n + 2) : ℝ) - a u v w k (n + 1) - a u v w k n| ≤
      ((5 * |u| + 3 * |v| + 2 * |w| + |k| : ℤ) : ℝ) * ((n : ℝ) + 1) := by
  have hrec := a_add_two u v w k n
  have h0 := forcing_nonneg hu huv huvw hk n
  have h1 := forcing_le (u := u) (v := v) (w := w) (k := k) n
  have hint : |a u v w k (n + 2) - a u v w k (n + 1) - a u v w k n| ≤
      (5 * |u| + 3 * |v| + 2 * |w| + |k|) * ((n : ℤ) + 1) := by
    rw [abs_le]
    constructor <;> linarith
  have hreal : ((|a u v w k (n + 2) - a u v w k (n + 1) - a u v w k n| : ℤ) : ℝ) ≤
      (((5 * |u| + 3 * |v| + 2 * |w| + |k|) * ((n : ℤ) + 1) : ℤ) : ℝ) := by
    exact_mod_cast hint
  push_cast at hreal ⊢
  exact hreal

/-- Geometric growth: `φ ^ n ≤ a n`, since `a 0 = 1`, `a 1 = 2` and the forcing is
nonnegative. -/
theorem goldenRatio_pow_le_a (hu : 0 ≤ u) (huv : 0 ≤ u + v) (huvw : 0 ≤ u + v + w)
    (hk : 0 ≤ 2 * u + v + k) (n : ℕ) : Real.goldenRatio ^ n ≤ a u v w k n := by
  have key : ∀ n, Real.goldenRatio ^ n ≤ a u v w k n ∧
      Real.goldenRatio ^ (n + 1) ≤ a u v w k (n + 1) := by
    intro n
    induction n with
    | zero =>
      have h2 := Real.goldenRatio_lt_two
      have ha0 : ((a u v w k 0 : ℤ) : ℝ) = 1 := by norm_num [a]
      have ha1 : ((a u v w k 1 : ℤ) : ℝ) = 2 := by norm_num [a, hist]
      rw [ha0, ha1, zero_add, pow_one, pow_zero]
      exact ⟨le_rfl, h2.le⟩
    | succ n ih =>
      refine ⟨ih.2, ?_⟩
      have hint : a u v w k (n + 1) + a u v w k n ≤ a u v w k (n + 2) := by
        have hrec := a_add_two u v w k n
        have h0 := forcing_nonneg hu huv huvw hk n
        linarith
      have hreal : (a u v w k (n + 1) : ℝ) + a u v w k n ≤ a u v w k (n + 2) := by
        exact_mod_cast hint
      have hpow : Real.goldenRatio ^ (n + 2) =
          Real.goldenRatio ^ (n + 1) + Real.goldenRatio ^ n := by
        rw [← Real.goldenRatio_pow_sub_goldenRatio_pow n]
        ring
      rw [show n + 1 + 1 = n + 2 by rfl, hpow]
      linarith [ih.1, ih.2]
  exact (key n).1

/-- **General theorem.** For any integer parameters with `0 ≤ u`, `0 ≤ u + v`,
`0 ≤ u + v + w` and `0 ≤ 2u + v + k`, the solution `a` of
`a(n) = a(n-1) + a(n-2) + u b(n-1) + v b(n-2) + w n + k` (with `a 0 = 1`, `a 1 = 2`,
`b 0 = 3`, `b` the `mex` sequence) satisfies `a (n+1) / a n → (1 + √5)/2`. -/
theorem tendsto_ratio_goldenRatio_of_nonneg (hu : 0 ≤ u) (huv : 0 ≤ u + v)
    (huvw : 0 ≤ u + v + w) (hk : 0 ≤ 2 * u + v + k) :
    Tendsto (fun n => (a u v w k (n + 1) : ℝ) / a u v w k n) atTop (𝓝 ((1 + √5) / 2)) :=
  Candidates.A294425Recurrence.tendsto_ratio_goldenRatio_of_linear_forcing
    (fun n => (a u v w k n : ℝ)) _ Real.goldenRatio Real.one_lt_goldenRatio
    (abs_forcing_le hu huv huvw hk) (goldenRatio_pow_le_a hu huv huvw hk)

end Growth

/-! ## The conjecture -/

/-- Every member of the guide satisfies the sign conditions of
`tendsto_ratio_goldenRatio_of_nonneg`. -/
theorem guide_sign_conditions : ∀ p ∈ guide,
    0 ≤ p.1 ∧ 0 ≤ p.1 + p.2.1 ∧ 0 ≤ p.1 + p.2.1 + p.2.2.1 ∧
      0 ≤ 2 * p.1 + p.2.1 + p.2.2.2 := by
  decide

/-- **Kimberling's family conjecture (A294532 guide, Clark Kimberling, Nov 03 2017).**

Verbatim: "Conjecture: for every sequence listed here,  a(n)/a(n-1) -> (1 + sqrt(5))/2 =
golden ratio (A001622)."

For each of the 34 forcings `(u, v, w, k)` listed in the guide, the solution
`a(n) = a(n-1) + a(n-2) + u b(n-1) + v b(n-2) + w n + k`, `a 0 = 1`, `a 1 = 2`, `b 0 = 3`,
satisfies `a (n+1) / a n → (1 + √5)/2`.  The index is shifted by one, which avoids `ℕ`
subtraction in the index and is the same limit statement.  Every `a n` is positive
(`goldenRatio_pow_le_a`), so the real division is never the junk `x / 0`. -/
theorem a294532_guide_conjecture : ∀ p ∈ guide,
    Tendsto (fun n => (a p.1 p.2.1 p.2.2.1 p.2.2.2 (n + 1) : ℝ) / a p.1 p.2.1 p.2.2.1 p.2.2.2 n)
      atTop (𝓝 ((1 + √5) / 2)) := by
  intro p hp
  obtain ⟨hu, huv, huvw, hk⟩ := guide_sign_conditions p hp
  exact tendsto_ratio_goldenRatio_of_nonneg hu huv huvw hk

/-- **The A294565 entry's own recurrence.** The A294565 entry (name and data) uses
`a(n) = a(n-1) + a(n-2) + 2 b(n-1) - b(n-2) - 2`, whereas the guide line prints `- 3`;
this instance has golden-ratio growth as well. -/
theorem a294565_entry_ratio_tendsto_goldenRatio :
    Tendsto (fun n => (a 2 (-1) 0 (-2) (n + 1) : ℝ) / a 2 (-1) 0 (-2) n) atTop
      (𝓝 ((1 + √5) / 2)) :=
  tendsto_ratio_goldenRatio_of_nonneg (by norm_num) (by norm_num) (by norm_num) (by norm_num)

end Candidates.A294532FamilyCoveringGuide

