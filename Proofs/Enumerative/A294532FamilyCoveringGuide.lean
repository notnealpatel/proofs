/-! ## Definitions -/

/-- `mexFrom f m l` scans `m, m+1, …` for at most `f` steps and returns the first value
not in `l` (or `m + f` if the fuel runs out). -/
def mexFrom : ℕ → ℤ → List ℤ → ℤ
  | 0, m, _ => m
  | f + 1, m, l => if m ∈ l then mexFrom f (m + 1) l else m

/-- The least positive integer not in `l` (the Mathematica `mex` of the entries); the fuel
`l.length + 1` suffices by `mex_not_mem`. -/
def mex (l : List ℤ) : ℤ := mexFrom (l.length + 1) 1 l

/-- `hist u v w k n = ([a (n+1), …, a 0], [b (n+1), …, b 0])`: the joint history of the
pair for the forcing `L_n = u b(n-1) + v b(n-2) + w n + k`, newest first.  The start is
`a 0 = 1`, `a 1 = 2`, `b 0 = 3`, `b 1 = mex {a 0, a 1, b 0}`. -/
def hist (u v w k : ℤ) : ℕ → List ℤ × List ℤ
  | 0 => ([2, 1], [mex [2, 1, 3], 3])
  | n + 1 =>
    let as := (hist u v w k n).1
    let bs := (hist u v w k n).2
    let a2 := as.headD 0 + as.tail.headD 0 + u * bs.headD 0 + v * bs.tail.headD 0 +
      w * ((n : ℤ) + 2) + k
    (a2 :: as, mex (a2 :: as ++ bs) :: bs)

/-- The `a`-sequence: `a 0 = 1`, `a 1 = 2`,
`a n = a(n-1) + a(n-2) + u b(n-1) + v b(n-2) + w n + k`. -/
def a (u v w k : ℤ) : ℕ → ℤ
  | 0 => 1
  | n + 1 => (hist u v w k n).1.headD 0

/-- The `b`-sequence: `b 0 = 3` and, for `n ≥ 1`, `b n` is the least positive integer not
among `a 0, …, a n, b 0, …, b (n-1)`. -/
def b (u v w k : ℤ) : ℕ → ℤ
  | 0 => 3
  | n + 1 => (hist u v w k n).2.headD 0

/-- The guide of A294532, in order A294532, …, A294565, as parameter tuples `(u, v, w, k)`
of the forcing `u b(n-1) + v b(n-2) + w n + k`, transcribed from the guide as printed
(including `- 3` on the A294565 line). -/
