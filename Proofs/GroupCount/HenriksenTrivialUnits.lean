/-
# Henriksen's unique-regular-element question: periodic rings with trivial unit group

## Source

* MathOverflow answer https://mathoverflow.net/a/100432 (answer id 100432),
  recording Melvin Henriksen's question; related thread MO 284684.
* M. Henriksen, "Rings with a unique regular element" (1989), Cor. 2.10:
  algebraic reduced rings whose only unit is `1` are Boolean.
* E. Moore, R. S. Pierce, A. Yaqub, Amer. Math. Monthly 75 (1968), 392:
  artinian rings whose only regular element is `1` are Boolean.
* No arXiv identifiers are involved.

Question (Henriksen), as recorded in the triage spec: must a noncommutative
unital ring contain a non-zero-divisor other than `1`?  Equivalently: is every
unital ring whose only regular element is `1` commutative?

Claim formalized here (triage statement, recorded 2026-10-21):

> Let R be a ring that is periodic, meaning every x has x^m = x^n for some
> m < n, and whose only unit is 1. Then x*x = x for every x, so R is Boolean
> and hence commutative. Corollary: if R is finite and every regular element
> equals 1, then R is commutative.

## Status

Proved in the literature (Henriksen 1989; Moore–Pierce–Yaqub 1968) for the
periodic / finite / artinian cases treated here.  The general infinite case of
Henriksen's question is reported open in the 2021 MathOverflow comments; it is
NOT addressed by this file.

## Proof outline (elementary, no Wedderburn)

Work in the commutative subring generated by `x`.  From `x ^ m = x ^ (m + k)`
with `k ≥ 1`, `e = x ^ j` (for `j = k * (m + 1)`) is idempotent and
`x ^ k * e = e`.  The element `x * e + (1 - e)` is a unit with inverse
`x ^ (k - 1) * e + (1 - e)`, hence equals `1`, so `x * e = e`.  The element
`x * (1 - e)` is nilpotent, so `1 + x * (1 - e)` is a unit, hence
`x * (1 - e) = 0`.  Thus `x = e` is idempotent.  Rings of idempotents are
commutative.  Finite rings are periodic by pigeonhole, and units are regular.
-/
import Mathlib

set_option autoImplicit false

namespace Candidates.HenriksenTrivialUnits

/-! ## Ground truth for the hypotheses

`ZMod 2` satisfies every hypothesis jointly (finite, periodic, only unit `1`,
only regular element `1`); `ZMod 3` shows the unit hypothesis is not vacuous
and that the conclusion fails without it. -/

example : ∀ u : (ZMod 2)ˣ, u = 1 := by decide

example : ∀ x : ZMod 2, x * x = x := by decide

example : ∀ x : ZMod 2, IsRegular x → x = 1 := by
  intro x hx
  fin_cases x
  · exact absurd (hx.1 (show (0 : ZMod 2) * 0 = 0 * 1 by decide)) (by decide)
  · rfl

example : ∃ u : (ZMod 3)ˣ, u ≠ 1 := by decide

example : (2 : ZMod 3) * 2 ≠ 2 := by decide

example : ∀ u : (ZMod 2 × ZMod 2)ˣ, u = 1 := by decide

/-- In a monoid, if `x ^ m = x ^ (m + k)` then `x ^ (m + k * t) = x ^ m` for all `t`. -/
theorem pow_add_mul_eq_of_pow_eq {M : Type*} [Monoid M] {x : M} {m k : ℕ}
    (h : x ^ m = x ^ (m + k)) (t : ℕ) : x ^ (m + k * t) = x ^ m := by
  induction t with
  | zero => simp
  | succ t ih =>
    calc x ^ (m + k * (t + 1)) = x ^ (m + k) * x ^ (k * t) := by
          rw [← pow_add]; congr 1; ring
      _ = x ^ m * x ^ (k * t) := by rw [← h]
      _ = x ^ (m + k * t) := by rw [← pow_add]
      _ = x ^ m := ih

/-- Commutative core: in a commutative ring whose only unit is `1`, an element `x`
with `x ^ m = x ^ n` for some `m < n` is idempotent. -/
theorem mul_self_of_pow_eq_of_units_trivial_comm {S : Type*} [CommRing S]
    (hu : ∀ u : Sˣ, u = 1) {x : S} {m n : ℕ} (hmn : m < n) (hx : x ^ m = x ^ n) :
    x * x = x := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hmn
  -- period `k + 1`
  have hper : ∀ t d : ℕ, x ^ (m + d + (k + 1) * t) = x ^ (m + d) := by
    intro t d
    have h0 : x ^ m = x ^ (m + (k + 1)) := by rw [hx]; congr 1
    calc x ^ (m + d + (k + 1) * t) = x ^ (m + (k + 1) * t) * x ^ d := by
          rw [← pow_add]; congr 1; ring
      _ = x ^ m * x ^ d := by rw [pow_add_mul_eq_of_pow_eq h0 t]
      _ = x ^ (m + d) := by rw [← pow_add]
  set j : ℕ := (k + 1) * (m + 1) with hj
  have hjm : j = m + (j - m) := by
    have : m ≤ j := by nlinarith
    omega
  have hj1 : 1 ≤ j := by nlinarith
  set e : S := x ^ j with he_def
  -- `e` is idempotent
  have he : e * e = e := by
    rw [he_def, ← pow_add]
    have := hper (m + 1) (j - m)
    rw [← hjm] at this
    rw [hj] at this ⊢
    exact this
  -- `x ^ (k + 1) * e = e`
  have hp : x ^ (k + 1) * e = e := by
    rw [he_def, ← pow_add]
    have := hper 1 (j - m)
    rw [← hjm, mul_one] at this
    rw [add_comm]; exact this
  clear_value e j
  -- `x * e = e`, via the unit `x * e + (1 - e)`
  have hxe : x * e = e := by
    let u : Sˣ := Units.mkOfMulEqOne (x * e + (1 - e)) (x ^ k * e + (1 - e)) (by
      linear_combination (x ^ (k + 1) - x - x ^ k + 1) * he + hp)
    have h1 := congrArg Units.val (hu u)
    simp only [u, Units.val_mkOfMulEqOne, Units.val_one] at h1
    linear_combination h1
  -- `x * (1 - e)` is nilpotent, hence zero
  have hz : x * (1 - e) = 0 := by
    have hnil : IsNilpotent (x * (1 - e)) := by
      refine ⟨j, ?_⟩
      obtain ⟨i, hi⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
      rw [mul_pow, ← he_def, hi, pow_succ]
      linear_combination -(1 - e) ^ i * he
    have h1 := congrArg Units.val (hu hnil.isUnit_one_add.unit)
    simp only [IsUnit.unit_spec, Units.val_one] at h1
    linear_combination h1
  have hxe' : x = e := by linear_combination hxe + hz
  rw [hxe', he]

/-- **Periodic rings with trivial unit group are Boolean.** Let `R` be a (not necessarily
commutative) unital ring that is periodic, i.e. every `x` satisfies `x ^ m = x ^ n` for some
`m < n`, and whose only unit is `1`. Then every element is idempotent: `x * x = x`.
This is the elementary argument behind Henriksen 1989, Cor. 2.10, and Moore–Pierce–Yaqub 1968. -/
theorem mul_self_of_periodic_of_units_trivial {R : Type*} [Ring R]
    (hper : ∀ x : R, ∃ m n : ℕ, m < n ∧ x ^ m = x ^ n) (hu : ∀ u : Rˣ, u = 1) (x : R) :
    x * x = x := by
  obtain ⟨m, n, hmn, hx⟩ := hper x
  have hcomm : IsMulCommutative (Subring.closure ({x} : Set R)) :=
    Subring.isMulCommutative_closure (by
      intro a ha b hb
      rw [Set.mem_singleton_iff] at ha hb
      rw [ha, hb])
  letI : CommRing (Subring.closure ({x} : Set R)) :=
    { (inferInstance : Ring (Subring.closure ({x} : Set R))) with
      mul_comm := hcomm.is_comm.comm }
  let x' : Subring.closure ({x} : Set R) := ⟨x, Subring.subset_closure rfl⟩
  have huS : ∀ u : (Subring.closure ({x} : Set R))ˣ, u = 1 := by
    intro u
    have h1 := congrArg Units.val (hu (Units.map (Subring.closure ({x} : Set R)).subtype.toMonoidHom u))
    ext
    simpa using h1
  have hx' : x' ^ m = x' ^ n := Subtype.ext (by simpa [x'] using hx)
  have key := mul_self_of_pow_eq_of_units_trivial_comm huS hmn hx'
  simpa [x'] using congrArg Subtype.val key

/-- A ring in which every element is idempotent is commutative. -/
theorem mul_comm_of_forall_mul_self {R : Type*} [Ring R] (h : ∀ x : R, x * x = x) (a b : R) :
    a * b = b * a := by
  have h2 : ∀ c : R, c + c = 0 := fun c =>
    calc c + c = c + c + (c + c) - (c + c) := by abel
      _ = (c + c) * (c + c) - (c + c) := by rw [add_mul, mul_add, h c]
      _ = 0 := by rw [h (c + c), sub_self]
  have hab : a * b + b * a = 0 :=
    calc a * b + b * a = a * a + a * b + (b * a + b * b) - (a + b) := by rw [h a, h b]; abel
      _ = (a + b) * (a + b) - (a + b) := by rw [add_mul, mul_add, mul_add]
      _ = 0 := by rw [h (a + b), sub_self]
  calc a * b = a * b + b * a + b * a := by rw [add_assoc, h2, add_zero]
    _ = b * a := by rw [hab, zero_add]

/-- A periodic ring whose only unit is `1` is commutative. -/
theorem mul_comm_of_periodic_of_units_trivial {R : Type*} [Ring R]
    (hper : ∀ x : R, ∃ m n : ℕ, m < n ∧ x ^ m = x ^ n) (hu : ∀ u : Rˣ, u = 1) (a b : R) :
    a * b = b * a :=
  mul_comm_of_forall_mul_self (mul_self_of_periodic_of_units_trivial hper hu) a b

/-- Every element of a finite ring (indeed of a finite monoid) is periodic. -/
theorem exists_lt_pow_eq_of_finite {R : Type*} [Monoid R] [Finite R] (x : R) :
    ∃ m n : ℕ, m < n ∧ x ^ m = x ^ n := by
  obtain ⟨a, b, hab, h⟩ := Finite.exists_ne_map_eq_of_infinite (fun n : ℕ => x ^ n)
  rcases lt_or_gt_of_ne hab with hlt | hlt
  · exact ⟨a, b, hlt, h⟩
  · exact ⟨b, a, hlt, h.symm⟩

/-- A finite ring whose only unit is `1` is Boolean (every element is idempotent). -/
theorem mul_self_of_finite_of_units_trivial {R : Type*} [Ring R] [Finite R]
    (hu : ∀ u : Rˣ, u = 1) (x : R) : x * x = x :=
  mul_self_of_periodic_of_units_trivial exists_lt_pow_eq_of_finite hu x

/-- **Henriksen's question, finite case.** If `R` is a finite unital ring in which `1` is the
only regular element (non-zero-divisor), then `R` is commutative (indeed Boolean). -/
theorem henriksen_finite {R : Type*} [Ring R] [Finite R]
    (h : ∀ x : R, IsRegular x → x = 1) (a b : R) : a * b = b * a := by
  have hu : ∀ u : Rˣ, u = 1 := fun u => Units.ext (h u (Units.isRegular u))
  exact mul_comm_of_forall_mul_self (mul_self_of_finite_of_units_trivial hu) a b

/-! Joint satisfiability of the main theorems' hypotheses at `ZMod 2`. -/

example : (1 : ZMod 2) * 1 = 1 :=
  mul_self_of_periodic_of_units_trivial exists_lt_pow_eq_of_finite (by decide) 1

example (a b : ZMod 2) : a * b = b * a :=
  henriksen_finite (fun x hx => by
    fin_cases x
    · exact absurd (hx.1 (show (0 : ZMod 2) * 0 = 0 * 1 by decide)) (by decide)
    · rfl) a b

end Candidates.HenriksenTrivialUnits
